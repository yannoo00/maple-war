---@sealed
---@description "This represents the performance result of BehaviourTree"
@Enum
script BehaviourTreeStatus
	---@description "Performed BehaviourTree successfully."
	member Success = 0
	---@description "Performing BehaviourTree."
	member Running = 1
	---@description "Failed to perform BehaviourTree."
	member Failure = 2

	---@description "Converts numbers to the applicable type."
	static method BehaviourTreeStatus CastFrom(number value) end

	---@description "Converts strings to the applicable type."
	static method BehaviourTreeStatus CastFrom(string value) end
end