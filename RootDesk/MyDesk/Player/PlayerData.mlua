@Component
script PlayerData extends Component

    -- Server-authoritative persistent data of one player: meso, owned units with levels, deck, cleared stages
    -- and the wallet (time-refilled currencies such as the campaign entry ticket).
    -- Loaded once when the player entity appears in a room (lobby or battle instance), synced to the owner's
    -- client only, and saved to the user's DataStorage at defined moments only:
    -- unit purchase, level-up, deck change (debounced), currency spend / purchase, battle end, and leaving the room.
    @TargetUserSync property boolean Loaded = false
    @TargetUserSync property integer Meso = 0
    @TargetUserSync property string UnitsCsv = ""
    @TargetUserSync property string DeckCsv = ""
    @TargetUserSync property string StagesCsv = ""
    -- Collected unit cards as "id:count,...". Cards are won in battle and spent to level a unit up.
    @TargetUserSync property string CardsCsv = ""
    -- Highest in-battle cost level this player may reach (raised with meso in the lobby).
    @TargetUserSync property integer CostLevelCap = 3
    -- Wallet as "currencyId:amount:nextAt,...". nextAt is the _UtilLogic.ServerElapsedSeconds at which the
    -- next +1 arrives in this room (0 = not refilling). Written by the server only (PublishWallet).
    @TargetUserSync property string WalletCsv = ""
    property string StorageKey = "PlayerData"
    property number DeckSaveDelay = 3
    @HideFromInspector property boolean IsDirty = false
    @HideFromInspector property integer SaveGeneration = 0
    @HideFromInspector property integer DeckTimerId = 0
    @HideFromInspector property integer WalletTimerId = 0
    -- How many processed World Shop purchase ids are remembered to refuse a repeated delivery.
    property integer PurchaseHistorySize = 20

    -- ===== Read helpers (server and owner client) =====

    method table GetUnitLevels()
        -- Returns owned units as a table: unit id -> level.
        local levels = {}
        for id, level in string.gmatch(self.UnitsCsv, "([^,:]+):(%d+)") do levels[id] = tonumber(level) end
        return levels
    end

    method table GetCardCounts()
        -- Returns collected cards as a table: unit id -> count.
        local counts = {}
        for id, count in string.gmatch(self.CardsCsv, "([^,:]+):(%d+)") do counts[id] = tonumber(count) end
        return counts
    end

    method table GetDeckIds()
        -- Returns the deck as an array of unit ids in slot order.
        local ids = {}
        for id in string.gmatch(self.DeckCsv, "[^,]+") do table.insert(ids, id) end
        return ids
    end

    method boolean IsStageCleared(string stageId)
        -- Returns true when the stage has been cleared at least once.
        for id in string.gmatch(self.StagesCsv, "[^,]+") do
            if id == stageId then return true end
        end
        return false
    end

    method integer GetCurrencyAmount(string currencyId)
        -- Returns how much of a currency the player holds (0 for an unknown currency).
        for id, amount in string.gmatch(self.WalletCsv, "([^,:]+):(%d+):[^,]*") do
            if id == currencyId then return math.floor(tonumber(amount)) end
        end
        return 0
    end

    method number GetCurrencyNextAt(string currencyId)
        -- Returns the _UtilLogic.ServerElapsedSeconds at which the currency gains its next +1, or 0 when it is not refilling.
        for id, nextAt in string.gmatch(self.WalletCsv, "([^,:]+):%d+:([^,]*)") do
            if id == currencyId then return tonumber(nextAt) or 0 end
        end
        return 0
    end

    -- ===== Load =====

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Loads this player's data from storage; a first-time player receives the starter set.
        local profileCode = self.Entity.PlayerComponent.ProfileCode
        local storage = _DataStorageService:GetUserDataStorage(profileCode)
        local errorCode, raw = storage:GetAndWait(self.StorageKey)
        if errorCode == 0 and raw ~= nil and raw ~= "" then
            local data = _HttpService:JSONDecode(raw)
            self.Meso = math.floor(data.meso or 0)
            self.UnitsCsv = data.units or ""
            self.DeckCsv = data.deck or ""
            self.StagesCsv = data.stages or ""
            self.CardsCsv = data.cards or ""
            self.CostLevelCap = math.max(_BattleConfig.DefaultCostLevelCap, math.floor(data.costCap or 0))
            self:LoadPurchases(data.purchases)
            -- An account saved before a currency existed receives that currency's start amount once.
            local granted = self:LoadWallet(data.wallet)
            self:GrantMissingStarters()
            if granted then
                self:MarkDirty()
                self:Save(false)
            end
            log("[PlayerData] loaded meso=" .. tostring(self.Meso) .. " units=" .. self.UnitsCsv .. " deck=" .. self.DeckCsv .. " stages=" .. self.StagesCsv .. " wallet=" .. self.WalletCsv)
        elseif errorCode == 0 or errorCode == 1000002 then
            self:GiveStarterSet()
            self:LoadPurchases(nil)
            self:LoadWallet(nil)
            self:MarkDirty()
            self:Save(false)
            log("[PlayerData] new player: starter set units=" .. self.UnitsCsv .. " deck=" .. self.DeckCsv)
        else
            -- Never mark Loaded on a failed read: saving now would overwrite real data with defaults.
            log_error("[PlayerData] load failed errorCode=" .. tostring(errorCode))
            return
        end
        self.Loaded = true
        self:StartWalletTimer()
    end

    @ExecSpace("ServerOnly")
    method void GiveStarterSet()
        -- Grants every starter unit at level 1 and fills the deck with the first DeckSize of them.
        local units = {}
        local deck = {}
        for _, id in ipairs(_BattleConfig:GetStarterUnitIds()) do
            table.insert(units, id .. ":1")
            if #deck < _BattleConfig.DeckSize then table.insert(deck, id) end
        end
        self.Meso = 0
        self.UnitsCsv = table.concat(units, ",")
        self.DeckCsv = table.concat(deck, ",")
        self.StagesCsv = ""
        self.CardsCsv = ""
        self.CostLevelCap = _BattleConfig.DefaultCostLevelCap
    end

    @ExecSpace("ServerOnly")
    method void GrantMissingStarters()
        -- Existing players receive starter units added to the table after their account was created.
        local levels = self:GetUnitLevels()
        local added = 0
        for _, id in ipairs(_BattleConfig:GetStarterUnitIds()) do
            if levels[id] == nil then
                if self.UnitsCsv == "" then
                    self.UnitsCsv = id .. ":1"
                else
                    self.UnitsCsv = self.UnitsCsv .. "," .. id .. ":1"
                end
                added = added + 1
            end
        end
        if added > 0 then
            self.Loaded = true
            self:MarkDirty()
            self:Save(false)
            log("[PlayerData] granted " .. tostring(added) .. " new starter units")
        end
    end

    -- ===== Save =====

    @ExecSpace("ServerOnly")
    method void MarkDirty()
        -- Records that the in-memory data differs from storage.
        self.IsDirty = true
        self.SaveGeneration = self.SaveGeneration + 1
    end

    @ExecSpace("ServerOnly")
    method void Save(boolean blocking)
        -- Writes the data when it changed. blocking = true waits for storage (battle end, leaving a room).
        if self.IsDirty == false then return end
        if self.Loaded == false and self.UnitsCsv == "" then return end
        local payload = self:BuildPayload()
        local generation = self.SaveGeneration
        local storage = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
        if blocking then
            local errorCode = storage:SetAndWait(self.StorageKey, payload)
            self:OnSaved(errorCode, generation)
        else
            storage:SetAsync(self.StorageKey, payload, function(errorCode, key)
                self:OnSaved(errorCode, generation)
            end)
        end
    end

    @ExecSpace("ServerOnly")
    method string BuildPayload()
        -- Serializes everything that is stored for this player.
        return _HttpService:JSONEncode({
            meso = self.Meso, units = self.UnitsCsv, deck = self.DeckCsv, stages = self.StagesCsv, cards = self.CardsCsv, costCap = self.CostLevelCap,
            wallet = self:ExportWallet(), purchases = table.concat(self._T.purchases or {}, ","),
        })
    end

    @ExecSpace("ServerOnly")
    method boolean SaveNow()
        -- Writes the data and waits for storage. Returns true only when storage confirmed the write.
        -- Used where the next step depends on the stored value (a room move makes the next room read storage again).
        if self.Loaded == false then return false end
        local payload = self:BuildPayload()
        local generation = self.SaveGeneration
        local storage = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
        local errorCode = storage:SetAndWait(self.StorageKey, payload)
        self:OnSaved(errorCode, generation)
        return errorCode == 0
    end

    @ExecSpace("ServerOnly")
    method void OnSaved(integer errorCode, integer generation)
        -- Clears the dirty flag only when storage confirmed the write and nothing changed since it was serialized.
        if errorCode ~= 0 then
            log_error("[PlayerData] save failed errorCode=" .. tostring(errorCode))
            return
        end
        if generation == self.SaveGeneration then self.IsDirty = false end
        log("[PlayerData] saved meso=" .. tostring(self.Meso) .. " generation=" .. tostring(generation))
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        -- Last-chance save when this player leaves the world.
        if event.UserId ~= self.Entity.PlayerComponent.UserId then return end
        self:Save(true)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- Cancels a pending debounced deck save and flushes it at once when the entity leaves the room.
        if self.WalletTimerId ~= 0 then
            _TimerService:ClearTimer(self.WalletTimerId)
            self.WalletTimerId = 0
        end
        if self.DeckTimerId ~= 0 then
            _TimerService:ClearTimer(self.DeckTimerId)
            self.DeckTimerId = 0
        end
        self:Save(true)
    end

    -- ===== Wallet (server) =====
    -- Each currency is held as { n = amount, at = UTC seconds }: "n as of `at`, refilling since `at`".
    -- The refill is always recomputed from that pair, so it needs no save of its own and keeps running
    -- while the player is offline. Only spending and granting change what is stored.

    @ExecSpace("ServerOnly")
    method integer NowSeconds()
        -- Returns the server's UTC clock in whole seconds.
        return math.floor(DateTime.UtcNow.Elapsed / 1000)
    end

    @ExecSpace("ServerOnly")
    method boolean LoadWallet(any saved)
        -- Builds the wallet from the saved table (nil for a new player). A currency that is not in the save
        -- starts at its StartAmount; returns true when that happened so the caller can save.
        local now = self:NowSeconds()
        local wallet = {}
        local granted = false
        for id, cfg in pairs(_BattleConfig:GetCurrencies()) do
            local entry = nil
            if saved ~= nil then entry = saved[id] end
            if entry ~= nil then
                wallet[id] = { n = math.max(0, math.floor(entry.n or 0)), at = math.floor(entry.at or now) }
            else
                wallet[id] = { n = cfg.startAmount, at = now }
                granted = true
            end
        end
        self._T.wallet = wallet
        self:NormalizeWallet()
        self:PublishWallet()
        return granted
    end

    @ExecSpace("ServerOnly")
    method table ExportWallet()
        -- Returns the wallet in its stored form: currency id -> { n, at }.
        local out = {}
        for id, entry in pairs(self._T.wallet or {}) do
            out[id] = { n = entry.n, at = entry.at }
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method boolean NormalizeWallet()
        -- Applies the refill earned since each currency's `at`. Returns true when an amount changed.
        local wallet = self._T.wallet
        if wallet == nil then return false end
        local now = self:NowSeconds()
        local changed = false
        for id, entry in pairs(wallet) do
            local cfg = _BattleConfig:GetCurrency(id)
            if cfg ~= nil then
                if entry.at > now then entry.at = now end
                if cfg.regenSeconds <= 0 or entry.n >= cfg.max then
                    -- Not refilling (purchases may hold it above max); the clock restarts when it drops below max.
                    entry.at = now
                else
                    local gained = math.floor((now - entry.at) / cfg.regenSeconds)
                    if gained > 0 then
                        entry.n = entry.n + gained
                        entry.at = entry.at + gained * cfg.regenSeconds
                        if entry.n >= cfg.max then
                            entry.n = cfg.max
                            entry.at = now
                        end
                        changed = true
                    end
                end
            end
        end
        return changed
    end

    @ExecSpace("ServerOnly")
    method void PublishWallet()
        -- Rewrites WalletCsv for the owner's client when the wallet changed.
        local wallet = self._T.wallet
        if wallet == nil then return end
        local now = self:NowSeconds()
        local ids = {}
        for id, _ in pairs(wallet) do table.insert(ids, id) end
        table.sort(ids)
        local parts = {}
        for _, id in ipairs(ids) do
            local entry = wallet[id]
            local cfg = _BattleConfig:GetCurrency(id)
            local nextAt = 0
            if cfg ~= nil and cfg.regenSeconds > 0 and entry.n < cfg.max then
                nextAt = _UtilLogic.ServerElapsedSeconds + (cfg.regenSeconds - (now - entry.at))
            end
            table.insert(parts, id .. ":" .. tostring(math.floor(entry.n)) .. ":" .. string.format("%.1f", nextAt))
        end
        local csv = table.concat(parts, ",")
        if csv ~= self.WalletCsv then self.WalletCsv = csv end
    end

    @ExecSpace("ServerOnly")
    method void StartWalletTimer()
        -- While the player is in this room, checks once a second whether a currency gained a point.
        if self.WalletTimerId ~= 0 then return end
        self.WalletTimerId = _TimerService:SetTimerRepeat(function()
            if self:NormalizeWallet() then
                self:PublishWallet()
                log("[PlayerData] wallet refilled " .. self.WalletCsv)
            end
        end, 1)
    end

    @ExecSpace("ServerOnly")
    method boolean SpendCurrency(string currencyId, integer amount)
        -- Takes `amount` of a currency. Returns false (and takes nothing) when the player does not hold enough.
        -- The caller decides when to save.
        if self.Loaded == false or self._T.wallet == nil then return false end
        local entry = self._T.wallet[currencyId]
        if entry == nil or amount < 0 then return false end
        self:NormalizeWallet()
        if entry.n < amount then return false end
        entry.n = entry.n - amount
        self:PublishWallet()
        self:MarkDirty()
        log("[PlayerData] spent " .. currencyId .. " -" .. tostring(amount) .. " -> " .. tostring(entry.n))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean AddCurrency(string currencyId, integer amount)
        -- Gives `amount` of a currency; the result may exceed the currency's max. The caller decides when to save.
        if self.Loaded == false or self._T.wallet == nil then return false end
        local entry = self._T.wallet[currencyId]
        if entry == nil or amount <= 0 then return false end
        self:NormalizeWallet()
        entry.n = entry.n + amount
        self:NormalizeWallet()
        self:PublishWallet()
        self:MarkDirty()
        log("[PlayerData] gained " .. currencyId .. " +" .. tostring(amount) .. " -> " .. tostring(entry.n))
        return true
    end

    @ExecSpace("ServerOnly")
    method void LoadPurchases(any csv)
        -- Restores the list of recently processed World Shop purchase ids.
        local list = {}
        if csv ~= nil then
            for id in string.gmatch(tostring(csv), "[^,]+") do table.insert(list, id) end
        end
        self._T.purchases = list
    end

    @ExecSpace("ServerOnly")
    method boolean GrantPurchase(string purchaseId, string currencyId, integer amount)
        -- Delivers a World Shop purchase. Returns true when the purchase is (or already was) delivered,
        -- false when it cannot be delivered now and must be retried.
        if self.Loaded == false or self._T.purchases == nil then return false end
        for _, id in ipairs(self._T.purchases) do
            if id == purchaseId then
                log("[PlayerData] purchase " .. purchaseId .. " was already delivered")
                return true
            end
        end
        if self:AddCurrency(currencyId, amount) == false then return false end
        table.insert(self._T.purchases, purchaseId)
        while #self._T.purchases > self.PurchaseHistorySize do table.remove(self._T.purchases, 1) end
        self:MarkDirty()
        self:Save(false)
        log("[PlayerData] purchase " .. purchaseId .. " delivered " .. currencyId .. " +" .. tostring(amount))
        return true
    end

    -- ===== Mutations (server) =====

    @ExecSpace("ServerOnly")
    method string OpenChest(string chestId)
        -- Opens a chest: every card rolls a rarity by the chest's odds (one card raised to the chest's
        -- guaranteed rarity), then a random unit of that rarity. A unit not owned yet is unlocked at level 1
        -- and the card is kept as well. Returns the cards as "unitId:count,..." ("" when the chest is unknown).
        -- No save; the caller saves.
        local chest = _BattleConfig:GetChest(chestId)
        if chest == nil or self.Loaded == false then return "" end
        local rarities = _BattleConfig:GetRarities()
        local got = {}
        local unlocked = {}
        for n = 1, chest.cards do
            local roll = _UtilLogic:RandomDouble() * 100
            local rarity = rarities[1]
            local acc = 0
            for _, id in ipairs(rarities) do
                acc = acc + (chest.chance[id] or 0)
                if roll < acc then
                    rarity = id
                    break
                end
            end
            if n == 1 and chest.guarantee ~= "" and _BattleConfig:GetRarityRank(rarity) < _BattleConfig:GetRarityRank(chest.guarantee) then
                rarity = chest.guarantee
            end
            -- A rarity with no units falls back to the next lower one.
            local rank = _BattleConfig:GetRarityRank(rarity)
            local pool = _BattleConfig:GetUnitsByRarity(rarities[rank])
            while #pool == 0 and rank > 1 do
                rank = rank - 1
                pool = _BattleConfig:GetUnitsByRarity(rarities[rank])
            end
            if #pool > 0 then
                local unitId = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
                if self:GetUnitLevels()[unitId] == nil then
                    if self.UnitsCsv == "" then
                        self.UnitsCsv = unitId .. ":1"
                    else
                        self.UnitsCsv = self.UnitsCsv .. "," .. unitId .. ":1"
                    end
                    table.insert(unlocked, unitId)
                end
                self:AddCards(unitId, 1)
                got[unitId] = (got[unitId] or 0) + 1
            end
        end
        local ids = {}
        for id, _ in pairs(got) do table.insert(ids, id) end
        table.sort(ids)
        local parts = {}
        for _, id in ipairs(ids) do table.insert(parts, id .. ":" .. tostring(got[id])) end
        local result = table.concat(parts, ",")
        self:MarkDirty()
        log("[PlayerData] chest " .. chestId .. " opened: " .. result .. " unlocked=" .. table.concat(unlocked, ","))
        return result
    end

    @ExecSpace("ServerOnly")
    method string BuyChest(string chestId)
        -- Buys and opens a chest with meso. Returns the cards csv, or "" when refused (logged).
        if self.Loaded == false then return "" end
        local chest = _BattleConfig:GetChest(chestId)
        if chest == nil or chest.priceMeso <= 0 then
            log("[PlayerData] chest " .. chestId .. " is not for sale")
            return ""
        end
        if self.Meso < chest.priceMeso then
            log("[PlayerData] chest " .. chestId .. " refused: not enough meso " .. tostring(self.Meso) .. "/" .. tostring(chest.priceMeso))
            return ""
        end
        self.Meso = self.Meso - chest.priceMeso
        local result = self:OpenChest(chestId)
        self:Save(false)
        return result
    end

    @ExecSpace("Server")
    method void RequestBuyChest(string chestId)
        -- Client request: buy a chest; the cards are sent back for the result screen.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local result = self:BuyChest(chestId)
        if result ~= "" then self:OnChestOpened(chestId, result, senderUserId) end
    end

    @ExecSpace("Client")
    method void OnChestOpened(string chestId, string resultCsv)
        -- Client: a chest was opened for this player; the lobby shows its cards.
        local controller = _EntityService:GetEntityByPath("/ui/LobbyUI/Controller")
        if isvalid(controller) then
            ---@type LobbyUI
            local lobby = controller:GetComponent("script.LobbyUI")
            if lobby ~= nil then lobby:ShowChestResult(chestId, resultCsv) end
        end
        log("[PlayerData] chest result shown " .. chestId .. ": " .. resultCsv)
    end

    @ExecSpace("ServerOnly")
    method string GrantBattleResult(string stageId, integer meso, string chestId, boolean cleared)
        -- Battle end: adds the meso reward, opens the stage's reward chest, records a clear, and saves right away.
        -- Returns the chest cards as csv ("" when there was no chest).
        if self.Loaded == false then return "" end
        if meso > 0 then self.Meso = self.Meso + meso end
        local cards = ""
        if chestId ~= "" then cards = self:OpenChest(chestId) end
        if cleared and self:IsStageCleared(stageId) == false then
            if self.StagesCsv == "" then
                self.StagesCsv = stageId
            else
                self.StagesCsv = self.StagesCsv .. "," .. stageId
            end
        end
        self:MarkDirty()
        -- Async here: this runs inside the battle's update chain. Leaving the room flushes anything still pending.
        self:Save(false)
        log("[PlayerData] battle result stage=" .. stageId .. " meso+" .. tostring(meso) .. " chest=" .. chestId .. " cleared=" .. tostring(cleared) .. " total=" .. tostring(self.Meso))
        return cards
    end

    @ExecSpace("ServerOnly")
    method string BuyUnit(string unitId)
        -- Buys a unit with meso. Returns "" on success or the reason it was refused.
        if self.Loaded == false then return "not loaded" end
        local cfg = _BattleConfig:GetUnit(unitId)
        if cfg == nil or cfg.price <= 0 then return "not for sale" end
        local levels = self:GetUnitLevels()
        if levels[unitId] ~= nil then return "already owned" end
        if self.Meso < cfg.price then return "not enough meso" end
        self.Meso = self.Meso - math.floor(cfg.price)
        if self.UnitsCsv == "" then
            self.UnitsCsv = unitId .. ":1"
        else
            self.UnitsCsv = self.UnitsCsv .. "," .. unitId .. ":1"
        end
        self:MarkDirty()
        self:Save(false)
        return ""
    end

    @ExecSpace("ServerOnly")
    method void AddCards(string unitId, integer amount)
        -- Adds collected cards of a unit (no save; the caller saves).
        local counts = self:GetCardCounts()
        counts[unitId] = (counts[unitId] or 0) + amount
        local ids = {}
        for id, _ in pairs(counts) do table.insert(ids, id) end
        table.sort(ids)
        local parts = {}
        for _, id in ipairs(ids) do table.insert(parts, id .. ":" .. tostring(counts[id])) end
        self.CardsCsv = table.concat(parts, ",")
    end

    @ExecSpace("ServerOnly")
    method string LevelUpUnit(string unitId)
        -- Raises an owned unit by one level by spending the level's cards (UnitLevelTable CardsNeeded) and meso.
        -- Returns "" on success or the reason it was refused.
        if self.Loaded == false then return "not loaded" end
        local levels = self:GetUnitLevels()
        local level = levels[unitId]
        if level == nil then return "not owned" end
        if level >= _BattleConfig:GetMaxLevel() then return "max level" end
        local entry = _BattleConfig:GetLevels()[level]
        local cost = math.floor(entry.upgradeCost)
        local need = entry.cardsNeeded
        local have = self:GetCardCounts()[unitId] or 0
        if have < need then return "not enough cards (" .. tostring(have) .. "/" .. tostring(need) .. ")" end
        if self.Meso < cost then return "not enough meso" end
        self.Meso = self.Meso - cost
        if need > 0 then self:AddCards(unitId, -need) end
        levels[unitId] = level + 1
        -- Rebuild the csv in its existing order.
        local parts = {}
        for id in string.gmatch(self.UnitsCsv, "([^,:]+):%d+") do table.insert(parts, id .. ":" .. tostring(levels[id])) end
        self.UnitsCsv = table.concat(parts, ",")
        self:MarkDirty()
        self:Save(false)
        return ""
    end

    @ExecSpace("ServerOnly")
    method string UnlockCostLevel()
        -- Raises the in-battle cost level cap by one with meso. Returns "" on success or the reason it was refused.
        if self.Loaded == false then return "not loaded" end
        local nextLevel = _BattleConfig:GetCostLevels()[self.CostLevelCap + 1]
        if nextLevel == nil then return "max level" end
        local price = math.floor(nextLevel.unlockMeso)
        if self.Meso < price then return "not enough meso" end
        self.Meso = self.Meso - price
        self.CostLevelCap = self.CostLevelCap + 1
        self:MarkDirty()
        self:Save(false)
        return ""
    end

    @ExecSpace("ServerOnly")
    method string SetDeck(table deckIds)
        -- Replaces the deck. Units must be owned, unique, and at most DeckSize. Saved after a short debounce.
        if self.Loaded == false then return "not loaded" end
        if #deckIds < 1 then return "empty deck" end
        if #deckIds > _BattleConfig.DeckSize then return "too many units" end
        local levels = self:GetUnitLevels()
        local seen = {}
        for _, id in ipairs(deckIds) do
            if levels[id] == nil then return "not owned: " .. id end
            if seen[id] then return "duplicate: " .. id end
            seen[id] = true
        end
        local csv = table.concat(deckIds, ",")
        if csv == self.DeckCsv then return "" end
        self.DeckCsv = csv
        self:MarkDirty()
        if self.DeckTimerId ~= 0 then _TimerService:ClearTimer(self.DeckTimerId) end
        self.DeckTimerId = _TimerService:SetTimerOnce(function()
            self.DeckTimerId = 0
            self:Save(false)
        end, self.DeckSaveDelay)
        return ""
    end

    -- ===== Client requests =====

    @ExecSpace("Server")
    method void RequestBuyUnit(string unitId)
        -- Client request: buy a unit.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local reason = self:BuyUnit(unitId)
        log("[PlayerData] buy " .. unitId .. " -> " .. (reason == "" and "ok" or reason) .. " meso=" .. tostring(self.Meso))
    end

    @ExecSpace("Server")
    method void RequestLevelUp(string unitId)
        -- Client request: level up an owned unit.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local reason = self:LevelUpUnit(unitId)
        log("[PlayerData] level up " .. unitId .. " -> " .. (reason == "" and "ok" or reason) .. " meso=" .. tostring(self.Meso) .. " units=" .. self.UnitsCsv)
    end

    @ExecSpace("Server")
    method void RequestUnlockCostLevel()
        -- Client request: raise the in-battle cost level cap.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local reason = self:UnlockCostLevel()
        log("[PlayerData] unlock cost level -> " .. (reason == "" and "ok" or reason) .. " cap=" .. tostring(self.CostLevelCap) .. " meso=" .. tostring(self.Meso))
    end

    @ExecSpace("Server")
    method void RequestSetDeck(string deckCsv)
        -- Client request: replace the deck (comma-separated unit ids).
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local ids = {}
        for id in string.gmatch(deckCsv, "[^,]+") do table.insert(ids, id) end
        local reason = self:SetDeck(ids)
        log("[PlayerData] set deck -> " .. (reason == "" and "ok" or reason) .. " deck=" .. self.DeckCsv)
    end

end
-- build cache bump
