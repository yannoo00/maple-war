@Component
script LobbyUI extends Component

    -- Client-only lobby screen manager: main / stage select (campaign) / deck edit / shop (chests) / currency shop.
    -- One screen is visible at a time. Every screen is drawn from the local player's synced PlayerData and the
    -- BattleConfig tables, so it survives the client rebuild that happens when the player changes rooms.
    -- The deck screen is a collection view: card tiles (level, card progress, upgrade button) on the left and the
    -- deck list on the right. List items (stage cards, deck rows, card tiles, shop rows) are clones of one hidden
    -- template each, kept in a pool and refilled from data.
    property Entity root = "6b22638e-f8c3-4021-af16-83b6431b83d1"
    property TextGUIRendererComponent mesoText = "199ca810-1315-4c0c-a33d-28a8e6efbc26"
    property Entity backButton = "4275fc9b-8ee2-4be2-bb8d-3cb28b93872b"
    property Entity mainPanel = "ab6ea8ae-7a68-43a1-be5a-6e919aa02909"
    property Entity stagePanel = "247875af-5886-4c77-b76b-98b40878f8bb"
    property Entity deckPanel = "b3c5d4b9-102e-4315-a241-181122aa2ba1"
    property Entity shopPanel = "a7de029a-43b9-4fc7-88cb-6a2da3d555fc"
    property Entity campaignButton = "1d2c2c69-98ef-47be-bca5-6b1564a542f4"
    property Entity deckButton = "8d74687f-7c8c-4dbd-9c7b-9a39b46c9ae3"
    property Entity shopButton = "5e5e66d8-2776-4467-9012-c6bde1fbac24"
    property Entity stageCard = "02bc7b91-fea7-477e-96b4-140b8c9a7626"
    property Entity enterButton = "f4d775ac-a40c-4ab9-b8ef-c4635b630560"
    property TextGUIRendererComponent deckTitle = "1d5a7119-286c-47af-a77d-c5a07a6ce359"
    property Entity deckSlot = "0f34464a-cfcc-4a30-bf27-d6f1f91f3cb9"
    property Entity collectionTile = "05439b32-df4a-4a03-8a8f-fb3908c5ce15"
    -- Deck screen sort buttons: the key (rarity / cost) and the direction (ascending / descending) of the card tiles.
    property Entity sortKeyButton = "ad9135fd-cfc8-440b-995c-eb253782c88e"
    property Entity sortDirButton = "d9aac3a0-f8b3-4422-b8c8-a3f189602473"
    property Entity shopRow = "5caa3dd8-5041-415b-a902-7436445522d6"
    property TextGUIRendererComponent ticketText = "6689281e-c16f-4cbb-be3d-1d6a382a9e7f"
    property Entity ticketButton = "7e088d7b-0575-4603-9c7f-e9f1381bc4f8"
    property TextGUIRendererComponent premiumText = "17f2ba7e-00c3-4a38-a503-049ad0ab2f94"
    property Entity premiumButton = "1b1c2c5a-4643-4c32-a404-b02b83f21999"
    property Entity ticketPanel = "31e9cdb0-9466-4e48-9262-5b606dc46cf8"
    property Entity ticketRow = "3d367bb5-26bd-4492-8d98-1a00702da4ad"
    property Entity shopTabCurrency = "6e4fa773-66cf-40d0-8418-31f111257d01"
    property Entity ticketTabChest = "94d3ab31-999e-47ed-8024-e8934e1d87de"
    property Entity chestPanel = "26e604e2-dda9-4404-b4e3-36287366a07e"
    property TextGUIRendererComponent chestTitle = "d726864a-87fd-423a-b124-7316f419553e"
    property Entity chestCard = "553fac4c-3591-4dc0-be3f-b6acfdca11aa"
    property Entity chestCloseButton = "93ce1bff-33e8-4df7-9c05-61aff42232ec"
    -- Unit info popup (modal backdrop) and its window; the window's children are found by name.
    property Entity unitInfoPanel = "3b885e61-e590-4b4f-821c-3a4b2685d63b"
    property Entity unitInfoWindow = "498c4818-5292-4de6-9bb3-d122d6893d98"
    -- Summon screen: stone tiles (one per stone rarity), the summon button and the selected stone's details.
    property Entity summonButton = "a90502b6-f87a-457a-9690-91755368fd02"
    property Entity summonPanel = "d661a45b-5057-4374-9e33-da054ab7489c"
    property Entity stoneTile = "9f3c6850-6218-4a5c-bc12-6f16862c5604"
    property Entity summonActionButton = "daecdeb7-8f16-4c66-be3d-fc46f1e11160"
    -- Summon reveal (modal): effect clip, then one screen per summoned card kind; its children are found by name.
    property Entity revealPanel = "306da072-cf77-4280-a82d-e875b4e0a741"
    -- Development bar at the bottom of the lobby (test grants). Shown in Maker play only; its buttons are found by name.
    property Entity devBar = "5c8e4f53-deec-42d8-9dab-07443bc32c6d"
    @HideFromInspector property string Screen = "main"
    @HideFromInspector property string SelectedStage = ""
    property table clickHandlers = {}

    -- ===== Setup =====

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Hides everything until the first update decides lobby or battle, and wires the fixed buttons.
        self.clickHandlers = {}
        self._T.pools = {}
        self._T.view = {}
        self.Screen = "main"
        self.SelectedStage = ""
        if isvalid(self.root) then self.root.Enable = false end
        for _, template in ipairs({ self.stageCard, self.deckSlot, self.collectionTile, self.shopRow, self.ticketRow, self.chestCard }) do
            if isvalid(template) then template.Enable = false end
        end
        self:Bind(self.campaignButton, function() self:OnMenuClicked("stage") end)
        self:Bind(self.deckButton, function() self:OnMenuClicked("deck") end)
        self:Bind(self.shopButton, function() self:OnMenuClicked("shop") end)
        self:Bind(self.backButton, function() self:OnBackClicked() end)
        self:Bind(self.enterButton, function() self:OnEnterClicked() end)
        self:Bind(self.sortKeyButton, function() self:OnSortClicked(true) end)
        self:Bind(self.sortDirButton, function() self:OnSortClicked(false) end)
        -- The top bar "+" buttons and the shop tabs open the currency shop / chest shop.
        self:Bind(self.ticketButton, function() self:OnMenuClicked("ticket") end)
        self:Bind(self.premiumButton, function() self:OnMenuClicked("ticket") end)
        self:Bind(self.shopTabCurrency, function() self:OnMenuClicked("ticket") end)
        self:Bind(self.ticketTabChest, function() self:OnMenuClicked("shop") end)
        self:Bind(self.chestCloseButton, function() self:OnChestCloseClicked() end)
        self:Bind(self.summonButton, function() self:OnMenuClicked("summon") end)
        self:Bind(self.summonActionButton, function() self:OnSummonClicked() end)
        if isvalid(self.stoneTile) then self.stoneTile.Enable = false end
        if isvalid(self.revealPanel) then
            self:Bind(self.revealPanel:GetChildByName("Tap"), function() self:OnRevealTapped() end)
            self:Bind(self.revealPanel:GetChildByName("SkipBtn"), function() self:FinishReveal() end)
            self.revealPanel.Enable = false
        end
        if isvalid(self.unitInfoWindow) then
            self:Bind(self.unitInfoWindow:GetChildByName("CloseBtn"), function() self:CloseUnitInfo() end)
            self:Bind(self.unitInfoWindow:GetChildByName("UpgradeBtn"), function() self:OnUpgradeClicked(self._T.infoUnit or "") end)
        end
        if isvalid(self.chestPanel) then self.chestPanel.Enable = false end
        if isvalid(self.unitInfoPanel) then self.unitInfoPanel.Enable = false end
        self:SetupDevBar()
        log("[LobbyUI] initialized handlers=" .. tostring(#self.clickHandlers))
    end

    @ExecSpace("ClientOnly")
    method void Bind(Entity button, any callback)
        -- Connects a button click and remembers the handler so OnEndPlay can disconnect it.
        if not isvalid(button) then return end
        local clickHandler = button:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self.clickHandlers, { entity = button, eventHandler = clickHandler })
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Disconnects every button click handler and stops a running summon reveal timer.
        if self._T.revealTimer ~= nil then
            _TimerService:ClearTimer(self._T.revealTimer)
            self._T.revealTimer = nil
        end
        for _, rec in ipairs(self.clickHandlers) do
            if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
        end
        self.clickHandlers = {}
    end

    -- ===== Development bar (Maker play only) =====

    @ExecSpace("ClientOnly")
    method void SetupDevBar()
        -- Shows the development bar only while playing in Maker and wires its buttons to the server-side test grants
        -- (PlayerData.RequestDevGrant, which refuses outside Maker play as well).
        if not isvalid(self.devBar) then return end
        local dev = Environment:IsMakerPlay()
        self.devBar.Enable = dev
        log("[VRF] [LobbyUI] dev bar shown=" .. tostring(dev))
        if dev == false then return end
        local actions = { StonesBtn = "stones", CardsBtn = "cards", MesoBtn = "meso", TicketsBtn = "tickets", StagesBtn = "stages", ResetBtn = "reset" }
        for name, action in pairs(actions) do
            local devAction = action
            self:Bind(self.devBar:GetChildByName(name), function() self:OnDevClicked(devAction) end)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnDevClicked(string action)
        -- A development bar button: asks the server for that test grant. Reset wipes the save, so it needs a second
        -- click within 3 seconds.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil then return end
        _BattleSound:Play("click")
        local resetButton = self.devBar:GetChildByName("ResetBtn")
        if action == "reset" then
            local now = _UtilLogic.ElapsedSeconds
            if self._T.devResetAt == nil or now - self._T.devResetAt > 3 then
                self._T.devResetAt = now
                if isvalid(resetButton) then resetButton.TextGUIRendererComponent.Text = "한 번 더 누르면 초기화" end
                _TimerService:SetTimerOnce(function()
                    if isvalid(resetButton) then resetButton.TextGUIRendererComponent.Text = "초기화" end
                end, 3)
                return
            end
            self._T.devResetAt = nil
            if isvalid(resetButton) then resetButton.TextGUIRendererComponent.Text = "초기화" end
        end
        log("[VRF] [LobbyUI] dev button " .. action)
        data:RequestDevGrant(action)
    end

    -- ===== Data access =====

    @ExecSpace("ClientOnly")
    method any GetData()
        -- Returns the local player's PlayerData component, or nil until the player exists.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return nil end
        return player:GetComponent("script.PlayerData")
    end

    @ExecSpace("ClientOnly")
    method table GetOwnableUnits()
        -- Returns every card unit definition (monster / build / skill) in table order; all of them come from chests.
        -- Bases (except enemy-only ones) are listed too: they look like cards but fill the deck's separate base slot.
        local list = self._T.ownable
        if list ~= nil then return list end
        list = {}
        for _, unit in pairs(_BattleConfig:GetUnits()) do
            local playable = unit.kind == "monster" or unit.kind == "build" or unit.kind == "skill" or (unit.kind == "base" and unit.enemyOnly == false)
            if playable then table.insert(list, unit) end
        end
        table.sort(list, function(a, b) return a.order < b.order end)
        self._T.ownable = list
        return list
    end

    @ExecSpace("ClientOnly")
    method table GetSortedUnits()
        -- Returns the card units ordered for the collection: by rarity (default) or by cost, ascending or descending.
        -- Ties fall back to the other key, then to the table order.
        local key = self._T.sortKey or "rarity"
        local dir = self._T.sortDir or 1
        local list = {}
        for _, unit in ipairs(self:GetOwnableUnits()) do table.insert(list, unit) end
        local function rank(unit) return _BattleConfig:GetRarityRank(unit.rarity) end
        table.sort(list, function(a, b)
            local first, second
            if key == "cost" then
                first, second = { a.cost, b.cost }, { rank(a), rank(b) }
            else
                first, second = { rank(a), rank(b) }, { a.cost, b.cost }
            end
            if first[1] ~= first[2] then
                if dir > 0 then return first[1] < first[2] end
                return first[1] > first[2]
            end
            if second[1] ~= second[2] then return second[1] < second[2] end
            return a.order < b.order
        end)
        return list
    end

    @ExecSpace("ClientOnly")
    method void OnSortClicked(boolean changeKey)
        -- Sort button: the key button switches rarity / cost, the arrow button flips ascending / descending.
        _BattleSound:Play("click")
        if changeKey then
            if (self._T.sortKey or "rarity") == "rarity" then self._T.sortKey = "cost" else self._T.sortKey = "rarity" end
        else
            self._T.sortDir = -(self._T.sortDir or 1)
        end
        log("[VRF] [LobbyUI] collection sort key=" .. tostring(self._T.sortKey or "rarity") .. " dir=" .. tostring(self._T.sortDir or 1))
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method string KindLabel(string kind)
        -- Returns the display name of a unit kind.
        if kind == "monster" then return "몬스터" end
        if kind == "build" then return "설치물" end
        if kind == "skill" then return "스킬" end
        return kind
    end

    -- ===== Lobby / battle switch and change detection =====

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Shows the lobby UI only on a map without a BattleDirector, and redraws when the synced player data changes.
        local view = self._T.view
        if view == nil then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        local inLobby = map:GetComponent("script.BattleDirector") == nil
        if inLobby ~= view.inLobby then
            view.inLobby = inLobby
            view.signature = nil
            if isvalid(self.root) then self.root.Enable = inLobby end
            log("[LobbyUI] inLobby=" .. tostring(inLobby) .. " map=" .. map.Name)
            if inLobby then self:ShowScreen("main") end
        end
        if inLobby == false then return end
        ---@type PlayerData
        local data = player:GetComponent("script.PlayerData")
        if data == nil then return end
        local signature = tostring(data.Loaded) .. "|" .. tostring(data.Meso) .. "|" .. data.UnitsCsv .. "|" .. data.DeckCsv .. "|" .. data.StagesCsv .. "|" .. data.WalletCsv .. "|" .. data.CardsCsv .. "|" .. data.StonesCsv
        if signature ~= view.signature then
            view.signature = signature
            log("[LobbyUI] data changed loaded=" .. tostring(data.Loaded) .. " meso=" .. tostring(data.Meso) .. " units=" .. data.UnitsCsv .. " deck=" .. data.DeckCsv .. " stages=" .. data.StagesCsv .. " wallet=" .. data.WalletCsv)
            self:Render()
        end
        -- The refill countdown moves every second without any data change.
        self:UpdateWalletText(data)
    end

    @ExecSpace("ClientOnly")
    method void UpdateWalletText(PlayerData data)
        -- Writes the top bar currency readouts: the entry currency (amount / max and, while refilling, the time
        -- until the next +1) and the premium currency amount.
        local entry = _BattleConfig:GetCurrency(_BattleConfig.EntryCurrencyId)
        -- Icons come from CurrencyTable and never change, so they are applied once.
        if self._T.walletIconsApplied ~= true then
            self._T.walletIconsApplied = true
            if isvalid(self.ticketText) then self:SetCurrencyIcon(self.ticketText.Entity, _BattleConfig.EntryCurrencyId) end
            if isvalid(self.premiumText) then self:SetCurrencyIcon(self.premiumText.Entity, _BattleConfig.PremiumCurrencyId) end
        end
        if isvalid(self.ticketText) and entry ~= nil then
            local text = entry.name .. " -"
            if data.Loaded then
                text = entry.name .. " " .. tostring(data:GetCurrencyAmount(entry.id)) .. " / " .. tostring(entry.max)
                local nextAt = data:GetCurrencyNextAt(entry.id)
                if nextAt > 0 then
                    local remain = math.max(0, math.ceil(nextAt - _UtilLogic.ServerElapsedSeconds))
                    text = text .. string.format(" · +1 %02d:%02d", math.floor(remain / 60), math.floor(remain % 60))
                end
            end
            if text ~= self._T.ticketLabel then
                self._T.ticketLabel = text
                self.ticketText.Text = text
            end
        end
        local premium = _BattleConfig:GetCurrency(_BattleConfig.PremiumCurrencyId)
        if isvalid(self.premiumText) and premium ~= nil then
            local text = premium.name .. " -"
            if data.Loaded then text = premium.name .. " " .. tostring(data:GetCurrencyAmount(premium.id)) end
            if text ~= self._T.premiumLabel then
                self._T.premiumLabel = text
                self.premiumText.Text = text
                log("[LobbyUI] premium readout " .. text)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowScreen(string screen)
        -- Switches to one lobby screen (main / stage / deck / shop / ticket) and draws it.
        self.Screen = screen
        if isvalid(self.mainPanel) then self.mainPanel.Enable = screen == "main" end
        if isvalid(self.stagePanel) then self.stagePanel.Enable = screen == "stage" end
        if isvalid(self.deckPanel) then self.deckPanel.Enable = screen == "deck" end
        if isvalid(self.shopPanel) then self.shopPanel.Enable = screen == "shop" end
        if isvalid(self.ticketPanel) then self.ticketPanel.Enable = screen == "ticket" end
        if isvalid(self.summonPanel) then self.summonPanel.Enable = screen == "summon" end
        if isvalid(self.revealPanel) then self.revealPanel.Enable = false end
        if isvalid(self.chestPanel) then self.chestPanel.Enable = false end
        if isvalid(self.backButton) then self.backButton.Enable = screen ~= "main" end
        -- A card menu or the info popup never outlives the screen it was opened on.
        self._T.selection = nil
        self._T.infoUnit = nil
        if isvalid(self.unitInfoPanel) then self.unitInfoPanel.Enable = false end
        log("[LobbyUI] screen=" .. screen)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Draws the meso readout and the current screen from the synced player data.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil then return end
        if isvalid(self.mesoText) then
            if data.Loaded then
                self.mesoText.Text = "메소 " .. tostring(data.Meso)
            else
                self.mesoText.Text = "메소 -"
            end
        end
        if data.Loaded == false then return end
        if self.Screen == "stage" then
            self:RenderStages(data)
        elseif self.Screen == "deck" then
            self:RenderDeck(data)
            -- An open info popup follows the data too (e.g. the level and button after an upgrade).
            if self._T.infoUnit ~= nil then self:RenderUnitInfo(data, self._T.infoUnit) end
        elseif self.Screen == "shop" then
            self:RenderShop(data)
        elseif self.Screen == "summon" then
            self:RenderSummon(data)
        elseif self.Screen == "ticket" then
            self:RenderTicketShop()
        end
    end

    -- ===== List items =====

    @ExecSpace("ClientOnly")
    method table SyncPool(string key, Entity template, integer count, string buttonChild, any onClick)
        -- Keeps a pool of template clones for one list: creates missing items, shows the first `count`, hides the rest.
        -- buttonChild = "" means the item itself is the button; otherwise the named child is.
        local pool = self._T.pools[key]
        if pool == nil then
            pool = {}
            self._T.pools[key] = pool
        end
        while #pool < count do
            local index = #pool + 1
            local entity = template:Clone(key .. tostring(index))
            local item = { entity = entity, index = index, key = "", locked = false }
            local button = entity
            if buttonChild ~= "" then button = entity:GetChildByName(buttonChild) end
            item.button = button
            self:Bind(button, function() onClick(item) end)
            table.insert(pool, item)
        end
        for i, item in ipairs(pool) do
            local shown = i <= count
            if item.entity.Enable ~= shown then item.entity.Enable = shown end
        end
        return pool
    end

    @ExecSpace("ClientOnly")
    method void SetChildText(Entity parent, string childName, string text)
        -- Writes the text of a named child label.
        local child = parent:GetChildByName(childName)
        if isvalid(child) then child.TextGUIRendererComponent.Text = text end
    end

    @ExecSpace("ClientOnly")
    method string SetChildIcon(Entity parent, string unitId)
        -- Shows the unit / skill image in the item's "Icon" child, or hides it when there is none; returns the RUID used.
        local child = parent:GetChildByName("Icon")
        if not isvalid(child) then return "" end
        local ruid = ""
        if unitId ~= "" then ruid = _BattleConfig:GetIconRuid(unitId) end
        if ruid ~= "" then child.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid) end
        local shown = ruid ~= ""
        if child.Enable ~= shown then child.Enable = shown end
        return ruid
    end

    @ExecSpace("ClientOnly")
    method string SetCurrencyIcon(Entity parent, string currencyId)
        -- Shows a currency's icon (CurrencyTable Icon) in the item's "Icon" child, or hides it when there is none;
        -- returns the RUID used.
        local child = parent:GetChildByName("Icon")
        if not isvalid(child) then return "" end
        local ruid = ""
        local cfg = _BattleConfig:GetCurrency(currencyId)
        if cfg ~= nil then ruid = cfg.icon end
        if ruid ~= "" then child.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid) end
        local shown = ruid ~= ""
        if child.Enable ~= shown then child.Enable = shown end
        log("[LobbyUI] currency icon " .. currencyId .. " on " .. parent.Name .. " ruid=" .. ruid)
        return ruid
    end

    @ExecSpace("ClientOnly")
    method void SetChildEnable(Entity parent, string childName, boolean enable)
        -- Shows or hides a named child (overlays such as Lock / Select / Dim).
        local child = parent:GetChildByName(childName)
        if isvalid(child) and child.Enable ~= enable then child.Enable = enable end
    end

    @ExecSpace("ClientOnly")
    method void SetButtonEnabled(Entity button, boolean enabled)
        -- Enables or disables a button; a disabled button shows its Dim overlay.
        if not isvalid(button) then return end
        button.ButtonComponent.Enable = enabled
        self:SetChildEnable(button, "Dim", enabled == false)
    end

    -- ===== Stage select =====

    @ExecSpace("ClientOnly")
    method void RenderStages(PlayerData data)
        -- Builds one card per stage in table order: name, cleared / locked state, entry cost and reward.
        local ticket = _BattleConfig:GetCurrency(_BattleConfig.EntryCurrencyId)
        local ticketName = "입장권"
        if ticket ~= nil then ticketName = ticket.name end
        local held = data:GetCurrencyAmount(_BattleConfig.EntryCurrencyId)
        local ids = _BattleConfig:GetStageIds()
        local items = self:SyncPool("stage", self.stageCard, #ids, "", function(item) self:OnStageCardClicked(item.key) end)
        local states = {}
        local selectedValid = false
        for i, id in ipairs(ids) do
            local stage = _BattleConfig:GetStage(id)
            local item = items[i]
            local unlocked = stage.unlockStage == "" or data:IsStageCleared(stage.unlockStage)
            local cleared = data:IsStageCleared(id)
            item.key = id
            item.locked = unlocked == false
            local status = "도전 가능"
            local state = "open"
            if item.locked then
                status = "잠김"
                state = "locked"
            elseif cleared then
                status = "클리어"
                state = "cleared"
            end
            self:SetChildText(item.entity, "Name", stage.name)
            self:SetChildText(item.entity, "Status", status)
            self:SetChildText(item.entity, "Reward", "보상 " .. tostring(math.floor(stage.rewardMeso)) .. " 메소")
            self:SetChildText(item.entity, "Cost", ticketName .. " " .. tostring(math.floor(stage.entryCost)))
            self:SetChildEnable(item.entity, "Lock", item.locked)
            item.entity.ButtonComponent.Enable = unlocked
            if id == self.SelectedStage and unlocked then selectedValid = true end
            table.insert(states, id .. ":" .. state)
        end
        if selectedValid == false then self.SelectedStage = "" end
        for i = 1, #ids do
            self:SetChildEnable(items[i].entity, "Select", items[i].key == self.SelectedStage)
        end
        -- Enter button: needs a selected stage and enough entry tickets for it.
        local enterLabel = "입장"
        local canEnter = false
        if self.SelectedStage ~= "" then
            local cost = math.floor(_BattleConfig:GetStage(self.SelectedStage).entryCost)
            if held >= cost then
                canEnter = true
                if cost > 0 then enterLabel = "입장 (" .. ticketName .. " " .. tostring(cost) .. ")" end
            else
                enterLabel = ticketName .. " 부족"
            end
        end
        if isvalid(self.enterButton) then self.enterButton.TextGUIRendererComponent.Text = enterLabel end
        self:SetButtonEnabled(self.enterButton, canEnter)
        log("[LobbyUI] stage list built count=" .. tostring(#ids) .. " states=" .. table.concat(states, ",") .. " selected=" .. self.SelectedStage .. " enter=" .. enterLabel .. " held=" .. tostring(held))
    end

    @ExecSpace("ClientOnly")
    method void OnStageCardClicked(string stageId)
        -- Selects an unlocked stage card; a locked stage cannot be selected.
        ---@type PlayerData
        local data = self:GetData()
        local stage = _BattleConfig:GetStage(stageId)
        if data == nil or stage == nil then return end
        if stage.unlockStage ~= "" and data:IsStageCleared(stage.unlockStage) == false then
            log("[LobbyUI] stage " .. stageId .. " is locked, not selected")
            return
        end
        _BattleSound:Play("click")
        self.SelectedStage = stageId
        log("[LobbyUI] stage selected " .. stageId)
        self:RenderStages(data)
    end

    @ExecSpace("ClientOnly")
    method void OnEnterClicked()
        -- Asks the server to start a battle on the selected stage (the server checks the unlock again).
        if self.SelectedStage == "" then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        ---@type Commander
        local commander = player:GetComponent("script.Commander")
        if commander == nil then return end
        -- Same check as the button state; the server checks again and is the one that takes the tickets.
        ---@type PlayerData
        local data = self:GetData()
        local stage = _BattleConfig:GetStage(self.SelectedStage)
        if data == nil or stage == nil then return end
        if data:GetCurrencyAmount(_BattleConfig.EntryCurrencyId) < stage.entryCost then
            log("[LobbyUI] not enough entry tickets for " .. self.SelectedStage)
            return
        end
        _BattleSound:Play("click")
        log("[LobbyUI] enter battle requested stage=" .. self.SelectedStage)
        _LoadingLogic:Begin()
        commander:RequestEnterBattle(self.SelectedStage)
    end

    -- ===== Deck edit (collection on the left, deck list on the right) =====
    -- Tapping a card opens a small menu on it instead of acting at once:
    --   collection tile: [정보 | 강화] and [사용 | 제거]     deck row: [정보 | 강화] and [제거]
    -- 강화 replaces 정보 when the unit can level up now; both open the info popup, which holds the upgrade button.

    @ExecSpace("ClientOnly")
    method void RenderDeck(PlayerData data)
        -- Draws the deck list (one row per slot, in slot order) and the collection tiles beside it.
        local deck = data:GetDeckIds()
        local levels = data:GetUnitLevels()
        local deckSize = _BattleConfig.DeckSize
        -- Remember what is owned now, so a chest result arriving later can mark newly unlocked units.
        self._T.ownedBefore = levels
        if isvalid(self.deckTitle) then
            self.deckTitle.Text = "내 덱 (" .. tostring(#deck) .. " / " .. tostring(deckSize) .. ")"
        end
        local inDeck = {}
        -- The first row is the deck's base slot (not counted in the deck size); the card rows follow it.
        local rows = self:SyncPool("slot", self.deckSlot, deckSize + 1, "", function(item) self:SelectCard("slot", item.key) end)
        local baseItem = rows[1]
        self:BindCardMenu(baseItem, "slot")
        local baseId = data:GetSelectedBaseId()
        local baseCfg = _BattleConfig:GetUnit(baseId)
        if baseCfg ~= nil then
            baseItem.key = baseId
            self:SetChildText(baseItem.entity, "Name", "기지 · " .. baseCfg.name)
            self:SetChildText(baseItem.entity, "Level", "Lv " .. tostring(levels[baseId] or 1))
            self:SetChildIcon(baseItem.entity, baseId)
            _BattleConfig:PaintRarityFrame(baseItem.entity, baseId)
        else
            baseItem.key = ""
            self:SetChildText(baseItem.entity, "Name", "기지 없음")
            self:SetChildText(baseItem.entity, "Level", "")
            self:SetChildIcon(baseItem.entity, "")
            _BattleConfig:PaintRarityFrame(baseItem.entity, "")
        end
        self:SetChildEnable(baseItem.entity, "Cost", false)
        baseItem.entity.ButtonComponent.Enable = baseCfg ~= nil
        local baseMenu = baseItem.entity:GetChildByName("Menu")
        local baseOpen = baseCfg ~= nil and self:IsSelected("slot", baseItem.key)
        if isvalid(baseMenu) then
            if baseOpen then
                self:PaintInfoButton(baseMenu:GetChildByName("InfoBtn"), self:GetUpgradeState(data, baseItem.key).ready)
                -- The base slot cannot be emptied; a base is replaced by choosing another one in the collection.
                local removeButton = baseMenu:GetChildByName("RemoveBtn")
                if isvalid(removeButton) and removeButton.Enable then removeButton.Enable = false end
            end
            if baseMenu.Enable ~= baseOpen then baseMenu.Enable = baseOpen end
        end
        for i = 1, deckSize do
            local item = rows[i + 1]
            self:BindCardMenu(item, "slot")
            local unitId = deck[i]
            local cfg = nil
            if unitId ~= nil then cfg = _BattleConfig:GetUnit(unitId) end
            if cfg ~= nil then
                inDeck[unitId] = true
                item.key = unitId
                self:SetChildText(item.entity, "Name", cfg.name)
                self:SetChildText(item.entity, "Level", "Lv " .. tostring(levels[unitId] or 1))
                self:SetChildText(item.entity, "Cost", tostring(math.floor(cfg.cost)))
                self:SetChildIcon(item.entity, unitId)
                _BattleConfig:PaintRarityFrame(item.entity, unitId)
            else
                item.key = ""
                self:SetChildText(item.entity, "Name", "빈 슬롯")
                self:SetChildText(item.entity, "Level", "")
                self:SetChildIcon(item.entity, "")
                _BattleConfig:PaintRarityFrame(item.entity, "")
            end
            self:SetChildEnable(item.entity, "Cost", cfg ~= nil)
            item.entity.ButtonComponent.Enable = cfg ~= nil
            local menu = item.entity:GetChildByName("Menu")
            local open = cfg ~= nil and self:IsSelected("slot", item.key)
            if isvalid(menu) then
                if open then self:PaintInfoButton(menu:GetChildByName("InfoBtn"), self:GetUpgradeState(data, item.key).ready) end
                if menu.Enable ~= open then menu.Enable = open end
            end
        end
        self:RenderCollection(data, inDeck)
        log("[LobbyUI] deck rendered deck=" .. data.DeckCsv .. " count=" .. tostring(#deck) .. "/" .. tostring(deckSize))
    end

    @ExecSpace("ClientOnly")
    method void RenderCollection(PlayerData data, table inDeck)
        -- One tile per card unit: portrait, summon cost badge, level band, rarity frame, card progress towards the
        -- next level (green when it can level up now) and a deck mark. Units not owned yet are shaded; their menu
        -- only offers 정보.
        local units = self:GetSortedUnits()
        if isvalid(self.sortKeyButton) then self.sortKeyButton.TextGUIRendererComponent.Text = (self._T.sortKey or "rarity") == "cost" and "마나순" or "등급순" end
        if isvalid(self.sortDirButton) then self.sortDirButton.TextGUIRendererComponent.Text = (self._T.sortDir or 1) > 0 and "오름" or "내림" end
        local tiles = self:SyncPool("collection", self.collectionTile, #units, "", function(item) self:SelectCard("collection", item.key) end)
        local summary = {}
        for i, unit in ipairs(units) do
            local item = tiles[i]
            item.key = unit.id
            self:BindCardMenu(item, "collection")
            local state = self:GetUpgradeState(data, unit.id)
            self:SetChildIcon(item.entity, unit.id)
            _BattleConfig:PaintRarityFrame(item.entity, unit.id)
            local isBase = unit.kind == "base"
            -- A base is "in the deck" when it is the one in the base slot.
            local used = inDeck[unit.id] == true
            if isBase then used = data:GetSelectedBaseId() == unit.id end
            self:SetChildEnable(item.entity, "CostBadge", isBase == false)
            if isBase == false then self:SetChildText(item.entity, "CostBadge", tostring(math.floor(unit.cost))) end
            self:SetChildEnable(item.entity, "Dim", state.owned == false)
            self:SetChildEnable(item.entity, "InDeck", used)
            local progress = item.entity:GetChildByName("Progress")
            local fill = nil
            if isvalid(progress) then
                fill = progress:GetChildByName("Fill")
                -- The count sits on a label above the fill bar; the bar panel's own text stays empty.
                progress.TextGUIRendererComponent.Text = ""
            end
            if isBase then
                -- Bases: "기지" level band, upgrade progress as level / top level, and what the player can do next.
                if state.owned == false then
                    self:SetChildText(item.entity, "Level", "미보유")
                    if isvalid(progress) then self:SetChildText(progress, "Label", unit.productId ~= "" and "구매 가능" or "준비 중") end
                    if isvalid(fill) then fill.SpriteGUIRendererComponent.FillAmount = 0 end
                    table.insert(summary, unit.id .. "=none")
                else
                    self:SetChildText(item.entity, "Level", "기지 Lv " .. tostring(state.level))
                    if isvalid(progress) then
                        self:SetChildText(progress, "Label", state.maxed and "최대 강화" or ("강화 " .. tostring(state.cost) .. " 메소"))
                    end
                    if isvalid(fill) then
                        fill.SpriteGUIRendererComponent.FillAmount = math.min(1, state.level / _BattleConfig:GetMaxBaseLevel())
                        if state.ready then
                            fill.SpriteGUIRendererComponent.Color = Color(0.36, 0.84, 0.4, 1)
                        else
                            fill.SpriteGUIRendererComponent.Color = Color(0.27, 0.6, 1, 1)
                        end
                    end
                    table.insert(summary, unit.id .. "=B" .. tostring(state.level) .. (used and "*" or "") .. (state.ready and "+" or ""))
                end
            elseif state.owned == false then
                self:SetChildText(item.entity, "Level", "미보유")
                if isvalid(progress) then self:SetChildText(progress, "Label", "소환으로 획득") end
                if isvalid(fill) then fill.SpriteGUIRendererComponent.FillAmount = 0 end
                table.insert(summary, unit.id .. "=none")
            else
                self:SetChildText(item.entity, "Level", "레벨 " .. tostring(state.level))
                local text = "최대"
                local ratio = 1
                if state.maxed == false then
                    text = tostring(state.have) .. "/" .. tostring(state.need)
                    if state.need > 0 then ratio = math.min(1, state.have / state.need) end
                end
                if isvalid(progress) then self:SetChildText(progress, "Label", text) end
                if isvalid(fill) then
                    fill.SpriteGUIRendererComponent.FillAmount = ratio
                    if state.ready then
                        fill.SpriteGUIRendererComponent.Color = Color(0.36, 0.84, 0.4, 1)
                    else
                        fill.SpriteGUIRendererComponent.Color = Color(0.27, 0.6, 1, 1)
                    end
                end
                local marks = ""
                if state.ready then marks = marks .. "+" end
                if inDeck[unit.id] == true then marks = marks .. "*" end
                table.insert(summary, unit.id .. "=L" .. tostring(state.level) .. ":" .. text .. marks)
            end
            local menu = item.entity:GetChildByName("Menu")
            local open = self:IsSelected("collection", unit.id)
            if isvalid(menu) then
                if open then
                    self:PaintInfoButton(menu:GetChildByName("InfoBtn"), state.ready)
                    local action = menu:GetChildByName("ActionBtn")
                    if isvalid(action) then
                        local actionEnabled = state.owned
                        if isBase then
                            -- A base cannot be taken out of its slot, only replaced by another one.
                            action.TextGUIRendererComponent.Text = used and "사용 중" or "사용"
                            actionEnabled = state.owned and used == false
                        elseif used then
                            action.TextGUIRendererComponent.Text = "제거"
                        else
                            action.TextGUIRendererComponent.Text = "사용"
                        end
                        if action.Enable ~= actionEnabled then action.Enable = actionEnabled end
                    end
                end
                if menu.Enable ~= open then menu.Enable = open end
            end
        end
        log("[LobbyUI] collection rendered tiles=" .. tostring(#units) .. " [" .. table.concat(summary, " ") .. "]")
    end

    @ExecSpace("ClientOnly")
    method table GetUpgradeState(PlayerData data, string unitId)
        -- Returns a unit's level progress: { owned, level, have, need, cost, maxed, ready }.
        -- ready = it can level up right now (enough cards and meso); the server checks again.
        -- A base has no cards: it is upgraded with meso alone (BaseLevelTable), so need = 0 and ready = enough meso.
        local unitCfg = _BattleConfig:GetUnit(unitId)
        if unitCfg ~= nil and unitCfg.kind == "base" then
            local baseLevel = data:GetUnitLevels()[unitId]
            local baseState = { owned = baseLevel ~= nil, level = baseLevel or 1, have = 0, need = 0, cost = 0, maxed = false, ready = false }
            if baseLevel == nil then return baseState end
            local price = _BattleConfig:GetBaseLevel(baseLevel).upgradeCost
            if baseLevel >= _BattleConfig:GetMaxBaseLevel() or price <= 0 then
                baseState.maxed = true
                return baseState
            end
            baseState.cost = price
            baseState.ready = data.Meso >= price
            return baseState
        end
        local level = data:GetUnitLevels()[unitId]
        local state = { owned = level ~= nil, level = level or 1, have = data:GetCardCounts()[unitId] or 0, need = 0, cost = 0, maxed = false, ready = false }
        if level == nil then return state end
        if level >= _BattleConfig:GetMaxLevel() then
            state.maxed = true
            return state
        end
        local entry = _BattleConfig:GetLevels()[level]
        if entry ~= nil then
            state.need = entry.cardsNeeded
            state.cost = math.floor(entry.upgradeCost)
        end
        state.ready = state.have >= state.need and data.Meso >= state.cost
        return state
    end

    @ExecSpace("ClientOnly")
    method boolean IsSelected(string pool, string unitId)
        -- True when the card menu is open on this unit in this list ("collection" or "slot").
        local selection = self._T.selection
        return selection ~= nil and unitId ~= "" and selection.pool == pool and selection.key == unitId
    end

    @ExecSpace("ClientOnly")
    method void SelectCard(string pool, string unitId)
        -- Opens the card menu on a collection tile or deck row; tapping the same card again closes it.
        if unitId == "" then return end
        _BattleSound:Play("click")
        if self:IsSelected(pool, unitId) then
            self._T.selection = nil
            log("[LobbyUI] card menu closed")
        else
            self._T.selection = { pool = pool, key = unitId }
            log("[LobbyUI] card menu " .. pool .. ":" .. unitId)
        end
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void BindCardMenu(table item, string pool)
        -- Wires a pooled card's menu buttons once; they act on whatever unit the card shows at click time (item.key).
        if item.menuBound == true then return end
        item.menuBound = true
        local menu = item.entity:GetChildByName("Menu")
        if not isvalid(menu) then return end
        self:Bind(menu:GetChildByName("InfoBtn"), function() self:OpenUnitInfo(item.key) end)
        if pool == "slot" then
            self:Bind(menu:GetChildByName("RemoveBtn"), function() self:RemoveFromDeck(item.key) end)
        else
            self:Bind(menu:GetChildByName("ActionBtn"), function() self:OnCardActionClicked(item.key) end)
        end
    end

    @ExecSpace("ClientOnly")
    method void PaintInfoButton(Entity button, boolean ready)
        -- The info button reads 강화 (green fill) when the unit can level up now, 정보 (the usual gold button fill)
        -- otherwise. The button skin is a plain white square, so the sprite color is the fill color.
        if not isvalid(button) then return end
        if ready then
            button.TextGUIRendererComponent.Text = "강화"
            button.SpriteGUIRendererComponent.Color = Color(0.55, 0.85, 0.45, 1)
        else
            button.TextGUIRendererComponent.Text = "정보"
            button.SpriteGUIRendererComponent.Color = Color(0.95, 0.79, 0.3, 1)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCardActionClicked(string unitId)
        -- Collection menu: 사용 puts the unit in the deck, 제거 takes it out.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or unitId == "" then return end
        local unitCfg = _BattleConfig:GetUnit(unitId)
        if unitCfg ~= nil and unitCfg.kind == "base" then
            self:SelectBaseCard(unitId)
            return
        end
        for _, id in ipairs(data:GetDeckIds()) do
            if id == unitId then
                self:RemoveFromDeck(unitId)
                return
            end
        end
        self:AddToDeck(unitId)
    end

    @ExecSpace("ClientOnly")
    method void SelectBaseCard(string baseId)
        -- Collection menu 사용 on a base: puts that owned base into the deck's base slot.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or baseId == "" then return end
        if data:GetUnitLevels()[baseId] == nil then
            log("[LobbyUI] base " .. baseId .. " is not owned, not selected")
            return
        end
        if data:GetSelectedBaseId() == baseId then return end
        _BattleSound:Play("click")
        log("[VRF] LobbyUI base selected " .. baseId)
        self._T.selection = nil
        data:RequestSelectBase(baseId)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void AddToDeck(string unitId)
        -- Appends an owned unit that is not in the deck to the first empty slot and sends the new deck.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or unitId == "" then return end
        local addCfg = _BattleConfig:GetUnit(unitId)
        if addCfg ~= nil and addCfg.kind == "base" then
            self:SelectBaseCard(unitId)
            return
        end
        if data:GetUnitLevels()[unitId] == nil then
            log("[LobbyUI] " .. unitId .. " is not owned, not added to the deck")
            return
        end
        local deck = data:GetDeckIds()
        for _, id in ipairs(deck) do
            if id == unitId then
                log("[LobbyUI] " .. unitId .. " is already in the deck")
                return
            end
        end
        if #deck >= _BattleConfig.DeckSize then
            log("[LobbyUI] deck is full, " .. unitId .. " not added")
            return
        end
        _BattleSound:Play("click")
        table.insert(deck, unitId)
        local csv = table.concat(deck, ",")
        log("[LobbyUI] deck change sent (add " .. unitId .. ") csv=" .. csv)
        self._T.selection = nil
        data:RequestSetDeck(csv)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void RemoveFromDeck(string unitId)
        -- Takes a unit out of the deck and sends the new deck; the last unit cannot be removed.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or unitId == "" then return end
        local deck = data:GetDeckIds()
        local slot = nil
        for i, id in ipairs(deck) do
            if id == unitId then slot = i end
        end
        if slot == nil then return end
        if #deck <= 1 then
            log("[LobbyUI] the deck needs at least one unit, " .. unitId .. " kept")
            return
        end
        _BattleSound:Play("click")
        table.remove(deck, slot)
        local csv = table.concat(deck, ",")
        log("[LobbyUI] deck change sent (remove " .. unitId .. " slot " .. tostring(slot) .. ") csv=" .. csv)
        self._T.selection = nil
        data:RequestSetDeck(csv)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void OnUpgradeClicked(string unitId)
        -- Info popup 강화 button: levels the unit up when its cards and meso are enough (the server checks again).
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or unitId == "" then return end
        local state = self:GetUpgradeState(data, unitId)
        local clickedCfg = _BattleConfig:GetUnit(unitId)
        if clickedCfg ~= nil and clickedCfg.kind == "base" then
            -- A base: buy it when it is not owned (World Shop), otherwise upgrade it with meso.
            if state.owned == false then
                if clickedCfg.productId ~= "" then
                    _BattleSound:Play("click")
                    log("[VRF] LobbyUI base purchase window requested " .. unitId .. " product=" .. clickedCfg.productId)
                    _WorldShopService:PromptPurchase(clickedCfg.productId)
                end
                return
            end
            if state.ready == false then
                log("[LobbyUI] base " .. unitId .. " cannot be upgraded yet meso=" .. tostring(data.Meso) .. " cost=" .. tostring(state.cost))
                return
            end
            _BattleSound:Play("click")
            log("[VRF] LobbyUI base upgrade requested " .. unitId .. " cost=" .. tostring(state.cost))
            data:RequestUpgradeBase(unitId)
            return
        end
        if state.ready == false then
            log("[LobbyUI] " .. unitId .. " cannot level up yet cards=" .. tostring(state.have) .. "/" .. tostring(state.need) .. " meso=" .. tostring(data.Meso))
            return
        end
        _BattleSound:Play("click")
        log("[LobbyUI] level-up requested " .. unitId .. " cards=" .. tostring(state.have) .. " meso=" .. tostring(data.Meso))
        data:RequestLevelUp(unitId)
    end

    -- ===== Unit info popup =====

    @ExecSpace("ClientOnly")
    method void OpenUnitInfo(string unitId)
        -- Opens the info popup of a unit (from the card menu's 정보 / 강화 button) and closes the card menu.
        if unitId == "" or not isvalid(self.unitInfoPanel) then return end
        _BattleSound:Play("click")
        self._T.selection = nil
        self._T.infoUnit = unitId
        self.unitInfoPanel.Enable = true
        log("[LobbyUI] unit info opened " .. unitId)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void CloseUnitInfo()
        -- Closes the info popup.
        _BattleSound:Play("click")
        self._T.infoUnit = nil
        if isvalid(self.unitInfoPanel) then self.unitInfoPanel.Enable = false end
        log("[LobbyUI] unit info closed")
    end

    @ExecSpace("ClientOnly")
    method void RenderUnitInfo(PlayerData data, string unitId)
        -- Fills the info popup: portrait, name, kind / rarity / level, stats at the current level, attack type,
        -- attribute, effect, the one-line flavor text (Desc), card progress, and the upgrade button (shown only when it
        -- can level up now).
        local window = self.unitInfoWindow
        if not isvalid(window) then return end
        local base = _BattleConfig:GetUnit(unitId)
        if base == nil then return end
        local state = self:GetUpgradeState(data, unitId)
        local unit = _BattleConfig:GetUnitAtLevel(unitId, state.level) or base
        local isBase = base.kind == "base"
        -- A base's stats come from its own upgrade table (BaseLevelTable), not the card level table.
        if isBase then unit = _BattleConfig:GetBaseAtLevel(unitId, state.level) or base end
        local box = window:GetChildByName("IconBox")
        if isvalid(box) then
            self:SetChildIcon(box, unitId)
            _BattleConfig:PaintRarityFrame(box, unitId)
            self:SetChildEnable(box, "CostBadge", isBase == false)
            if isBase == false then self:SetChildText(box, "CostBadge", tostring(math.floor(base.cost))) end
        end
        self:SetChildText(window, "Name", base.name)
        local sub = self:KindLabel(base.kind) .. " · " .. _BattleConfig:GetRarityLabel(base.rarity)
        if state.owned then
            sub = sub .. (isBase and " · 강화 " or " · 레벨 ") .. tostring(state.level)
        else
            sub = sub .. " · 미보유"
        end
        self:SetChildText(window, "Sub", sub)
        local lines = {}
        if isBase then
            table.insert(lines, "HP  " .. self:FormatNumber(unit.maxHp))
            table.insert(lines, "시작 마나  " .. self:FormatNumber(base.manaStart or _BattleConfig.CostStart))
            table.insert(lines, "마나 최대  ×" .. self:FormatNumber(base.manaMaxRate) .. "     마나 회복  ×" .. self:FormatNumber(base.manaRegenRate))
            -- The mana level cap grows with the base's upgrade level; show the next step while it can still be upgraded.
            local capLine = "마나 적응 한도  Lv " .. tostring(unit.manaLevelCap)
            if state.owned and state.maxed == false then
                local following = _BattleConfig:GetBaseAtLevel(unitId, state.level + 1)
                if following ~= nil and following.manaLevelCap > unit.manaLevelCap then capLine = capLine .. "  (강화 시 Lv " .. tostring(following.manaLevelCap) .. ")" end
            end
            table.insert(lines, capLine)
            local discount = unit.manaDiscount or 0
            if discount > 0 then table.insert(lines, "마나 적응 강화 비용  -" .. self:FormatNumber(discount * 100) .. "%") end
        else
            table.insert(lines, "소환 마나  " .. self:FormatNumber(base.cost))
        end
        if isBase then
            -- (the base's lines are above)
        elseif base.kind == "skill" then
            table.insert(lines, "피해  " .. self:FormatNumber(unit.damage))
            table.insert(lines, "범위  " .. self:FormatNumber(base.radius))
        else
            if base.spawnCount > 1 then table.insert(lines, "한 번에 소환  " .. tostring(base.spawnCount) .. "마리") end
            table.insert(lines, "HP  " .. self:FormatNumber(unit.maxHp) .. "     공격력  " .. self:FormatNumber(unit.attack))
            table.insert(lines, "공격 간격  " .. self:FormatNumber(base.attackInterval) .. "초     사거리  " .. self:FormatNumber(base.range))
            if base.kind == "monster" then table.insert(lines, "이동 속도  " .. self:FormatNumber(base.speed)) end
            local attackType = _BattleConfig:GetAttackTypeLabel(base.attackType)
            if attackType ~= "" then table.insert(lines, "공격 유형  " .. attackType) end
            local attribute = _BattleConfig:GetAttributeLabel(base.attribute)
            if attribute ~= "" then table.insert(lines, "속성  " .. attribute) end
        end
        self:SetChildText(window, "Stats", table.concat(lines, "\n"))
        local desc = base.desc or ""
        self:SetChildEnable(window, "Desc", desc ~= "")
        if desc ~= "" then self:SetChildText(window, "Desc", desc) end
        if isBase then
            self:SetChildText(window, "Effect", self:DescribeBaseSkill(base))
        else
            self:SetChildText(window, "Effect", self:DescribeEffect(base))
        end
        local progress = ""
        if isBase and state.owned == false then
            if base.productId ~= "" then
                progress = "Worldcoin으로 구매하면\n사용할 수 있습니다."
            else
                progress = "아직 판매 준비 중입니다."
            end
        elseif isBase and state.maxed then
            progress = "최대 강화입니다."
        elseif isBase then
            progress = "강화 비용 메소 " .. tostring(state.cost)
            if data.Meso < state.cost then progress = progress .. "\n메소가 부족합니다." end
        elseif state.owned == false then
            progress = "소환의 돌로 카드를 얻으면\n사용할 수 있습니다."
        elseif state.maxed then
            progress = "최대 레벨입니다."
        else
            progress = "카드 " .. tostring(state.have) .. " / " .. tostring(state.need)
            if state.have < state.need then
                progress = progress .. "\n카드가 더 필요합니다."
            elseif data.Meso < state.cost then
                progress = progress .. "\n메소가 부족합니다 (" .. tostring(state.cost) .. ")"
            end
        end
        self:SetChildText(window, "Progress", progress)
        local upgrade = window:GetChildByName("UpgradeBtn")
        if isvalid(upgrade) then
            local actionEnabled = state.ready
            if state.ready then upgrade.TextGUIRendererComponent.Text = "강화 " .. tostring(state.cost) end
            if isBase and state.owned == false then
                -- An unowned base offers the World Shop purchase when it has a product.
                actionEnabled = base.productId ~= ""
                if actionEnabled then upgrade.TextGUIRendererComponent.Text = "구매" end
            end
            if upgrade.Enable ~= actionEnabled then upgrade.Enable = actionEnabled end
        end
        log("[LobbyUI] unit info rendered " .. unitId .. " level=" .. tostring(state.level) .. " owned=" .. tostring(state.owned) .. " ready=" .. tostring(state.ready) .. " cost=" .. tostring(state.cost))
    end

    @ExecSpace("ClientOnly")
    method string DescribeBaseSkill(table base)
        -- Describes a base's skill for the info popup: active (cooldown, used from the battle HUD) or passive (automatic).
        if base.baseSkill == "" then return "기지 스킬  없음" end
        local skill = _BattleConfig:GetUnit(base.baseSkill)
        if skill == nil then return "기지 스킬  없음" end
        local kind = "능동 · 쿨타임 " .. self:FormatNumber(base.baseSkillCooldown) .. "초"
        if base.baseSkillType == "passive" then kind = "패시브 · " .. self:FormatNumber(base.baseSkillCooldown) .. "초마다 자동" end
        return "기지 스킬  " .. skill.name .. " (" .. kind .. ", 피해 " .. self:FormatNumber(skill.damage) .. ", 범위 " .. self:FormatNumber(skill.radius) .. ")"
    end

    @ExecSpace("ClientOnly")
    method string DescribeEffect(table unit)
        -- Describes the effect rules of a monster / build (UnitEffectTable): one line per rule with the effect's name and
        -- what it does, when it triggers (on hit with its chance, or always on the unit itself), duration and magnitude.
        local rules = _BattleConfig:GetUnitEffects(unit.id)
        local lines = {}
        for _, rule in ipairs(rules) do
            local effect = _BattleConfig:GetEffect(rule.effectId)
            if effect ~= nil then
                local duration = rule.duration or effect.duration
                local power = rule.power or effect.power
                local parts = {}
                if rule.trigger == "on_hit" then
                    table.insert(parts, "공격 시 " .. self:FormatNumber(rule.chance) .. "%")
                    if duration > 0 then table.insert(parts, "지속 " .. self:FormatNumber(duration) .. "초") end
                elseif effect.id == "might" then
                    table.insert(parts, "공격마다 " .. self:FormatNumber(rule.chance) .. "%")
                else
                    table.insert(parts, "항상 자신에게")
                end
                if (effect.id == "warp" or effect.id == "blow") and power > 0 then table.insert(parts, "거리 " .. self:FormatNumber(power)) end
                if effect.id == "curse" and power > 0 then table.insert(parts, "공격력 -" .. self:FormatNumber(power) .. "%") end
                if effect.id == "poison" and power > 0 then table.insert(parts, "초당 피해 " .. self:FormatNumber(power)) end
                if effect.id == "might" and power > 0 then table.insert(parts, "피해 +" .. self:FormatNumber(power) .. "%") end
                if effect.id == "icy" and power > 0 then table.insert(parts, "속도 -" .. self:FormatNumber(power) .. "%") end
                if effect.id == "tough" and power > 0 then table.insert(parts, "받는 피해 -" .. self:FormatNumber(power) .. "%") end
                table.insert(lines, "효과  " .. effect.name .. " — " .. self:EffectTypeDescription(effect.id) .. " (" .. table.concat(parts, ", ") .. ")")
            end
        end
        if #lines == 0 then return "효과  없음" end
        return table.concat(lines, "\n")
    end

    @ExecSpace("ClientOnly")
    method string EffectTypeDescription(string effectType)
        -- One-line description of an effect by its id (see BattleEffects:GetDefs).
        if effectType == "nullify" then return "맞은 몬스터의 공격이 이 유닛에게 통하지 않음" end
        if effectType == "curse" then return "맞은 몬스터의 공격력을 감소시킴" end
        if effectType == "warp" then return "맞은 몬스터를 즉시 뒤로 보내고 묶어 둠" end
        if effectType == "blow" then return "맞은 몬스터를 뒤로 날려버림" end
        if effectType == "poison" then return "맞은 몬스터에게 지속 피해" end
        if effectType == "might" then return "확률로 더 큰 피해를 입힘" end
        if effectType == "titan" then return "넉백되지 않음" end
        if effectType == "tough" then return "받는 피해가 줄어듦" end
        if effectType == "siege" then return "몬스터를 무시하고 건물과 기지만 공격" end
        if effectType == "swamp" then return "독 피해를 받지 않음" end
        if effectType == "icy" then return "맞은 몬스터의 공격 속도와 이동 속도를 늦춤" end
        if effectType == "summon_slime" then return "일정 시간마다 슬라임을 소환" end
        return effectType
    end

    @ExecSpace("ClientOnly")
    method string FormatNumber(number value)
        -- Whole numbers without decimals, others with one decimal place.
        if math.abs(value - math.floor(value)) < 0.001 then return tostring(math.floor(value)) end
        return string.format("%.1f", value)
    end

    -- ===== Shop (chests) =====

    @ExecSpace("ClientOnly")
    method void RenderShop(PlayerData data)
        -- Draws one row per chest (ChestTable): name, odds, cards per chest and a buy button priced in meso.
        local ids = _BattleConfig:GetChestIds()
        -- Remember what is owned before a chest is opened, so the result can mark newly unlocked units.
        self._T.ownedBefore = data:GetUnitLevels()
        local rows = self:SyncPool("shop", self.shopRow, #ids, "Action", function(item) self:OnShopActionClicked(item.key) end)
        local summary = {}
        local held = data:GetStoneCounts()
        for i, id in ipairs(ids) do
            local chest = _BattleConfig:GetSummonStone(id)
            local item = rows[i]
            item.key = id
            self:PaintStone(item.entity, id)
            local odds = {}
            for _, rarity in ipairs(_BattleConfig:GetRarities()) do
                local pct = chest.chance[rarity] or 0
                if pct > 0 then table.insert(odds, _BattleConfig:GetRarityLabel(rarity) .. " " .. tostring(math.floor(pct)) .. "%") end
            end
            local guarantee = ""
            if chest.guarantee ~= "" then guarantee = " · " .. _BattleConfig:GetRarityLabel(chest.guarantee) .. " 이상 1장 보장" end
            self:SetChildText(item.entity, "Name", chest.name)
            self:SetChildText(item.entity, "Kind", table.concat(odds, " / ") .. guarantee)
            self:SetChildText(item.entity, "Level", "카드 " .. tostring(chest.cards) .. "장 · 보유 " .. tostring(held[id] or 0) .. "개")
            local label = "판매 안 함"
            local enabled = false
            if chest.priceMeso > 0 then
                label = "구매 " .. tostring(chest.priceMeso) .. " 메소"
                enabled = data.Meso >= chest.priceMeso
            end
            item.button.TextGUIRendererComponent.Text = label
            self:SetButtonEnabled(item.button, enabled)
            table.insert(summary, id .. "=" .. tostring(chest.priceMeso) .. (enabled and "+" or "-"))
        end
        log("[LobbyUI] shop rendered stones=" .. tostring(#ids) .. " meso=" .. tostring(data.Meso) .. " held=" .. data.StonesCsv .. " [" .. table.concat(summary, " ") .. "]")
    end

    @ExecSpace("ClientOnly")
    method void OnShopActionClicked(string stoneId)
        -- Sends a summon stone purchase; the stone goes to storage (the held count on the row goes up).
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or stoneId == "" then return end
        _BattleSound:Play("click")
        log("[LobbyUI] stone purchase requested " .. stoneId .. " meso=" .. tostring(data.Meso))
        data:RequestBuyStone(stoneId)
    end

    @ExecSpace("ClientOnly")
    method void PaintStone(Entity item, string stoneId)
        -- Draws a summon stone on an item: its icon (base stone icon unless the rarity overrides it) in the "Icon"
        -- child and its rarity color on the "Rarity" frame.
        local stone = _BattleConfig:GetSummonStone(stoneId)
        if stone == nil then return end
        local icon = item:GetChildByName("Icon")
        if isvalid(icon) then
            icon.SpriteGUIRendererComponent.ImageRUID = DataRef(stone.iconRuid)
            if icon.Enable == false then icon.Enable = true end
        end
        local frame = item:GetChildByName("Rarity")
        if isvalid(frame) then
            if frame.Enable == false then frame.Enable = true end
            for _, edge in ipairs(frame.Children) do
                if edge.SpriteGUIRendererComponent ~= nil then edge.SpriteGUIRendererComponent.Color = stone.frameColor end
            end
        end
    end

    -- ===== Summon (use held stones) =====

    @ExecSpace("ClientOnly")
    method void RenderSummon(PlayerData data)
        -- One tile per stone rarity with the held count (shaded at 0); the selected stone is highlighted and its
        -- details shown; the summon button works only for a held, selected stone.
        local ids = _BattleConfig:GetChestIds()
        local held = data:GetStoneCounts()
        self._T.ownedBefore = data:GetUnitLevels()
        local selected = self._T.selectedStone or ""
        if (held[selected] or 0) <= 0 then
            -- Keep a valid selection: the first held stone (or none).
            selected = ""
            for _, id in ipairs(ids) do
                if selected == "" and (held[id] or 0) > 0 then selected = id end
            end
            self._T.selectedStone = selected
        end
        local tiles = self:SyncPool("stone", self.stoneTile, #ids, "", function(item) self:OnStoneTileClicked(item.key) end)
        for i, id in ipairs(ids) do
            local item = tiles[i]
            local stone = _BattleConfig:GetSummonStone(id)
            item.key = id
            self:PaintStone(item.entity, id)
            self:SetChildText(item.entity, "Name", stone.name)
            self:SetChildText(item.entity, "CountBadge", "x" .. tostring(held[id] or 0))
            self:SetChildEnable(item.entity, "Dim", (held[id] or 0) <= 0)
            self:SetChildEnable(item.entity, "Select", id == selected)
        end
        local info = ""
        local stone = _BattleConfig:GetSummonStone(selected)
        if stone ~= nil then
            local odds = {}
            for _, rarity in ipairs(_BattleConfig:GetRarities()) do
                local pct = stone.chance[rarity] or 0
                if pct > 0 then table.insert(odds, _BattleConfig:GetRarityLabel(rarity) .. " " .. tostring(math.floor(pct)) .. "%") end
            end
            info = stone.name .. " — 카드 " .. tostring(stone.cards) .. "장"
            if stone.guarantee ~= "" then info = info .. " · " .. _BattleConfig:GetRarityLabel(stone.guarantee) .. " 이상 1장 보장" end
            info = info .. "\n" .. table.concat(odds, " / ")
        else
            info = "보유한 소환의 돌이 없습니다. 상점이나 전투 보상으로 얻을 수 있습니다."
        end
        if isvalid(self.summonPanel) then self:SetChildText(self.summonPanel, "Info", info) end
        self:SetButtonEnabled(self.summonActionButton, stone ~= nil and self._T.summoning ~= true)
        log("[LobbyUI] summon rendered held=" .. data.StonesCsv .. " selected=" .. selected)
    end

    @ExecSpace("ClientOnly")
    method void OnStoneTileClicked(string stoneId)
        -- Selects a held stone for the summon button.
        ---@type PlayerData
        local data = self:GetData()
        if data == nil or (data:GetStoneCounts()[stoneId] or 0) <= 0 then return end
        _BattleSound:Play("click")
        self._T.selectedStone = stoneId
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void OnSummonClicked()
        -- Uses the selected stone; the server rolls the cards and sends them back for the reveal.
        ---@type PlayerData
        local data = self:GetData()
        local stoneId = self._T.selectedStone or ""
        if data == nil or stoneId == "" or self._T.summoning == true then return end
        if (data:GetStoneCounts()[stoneId] or 0) <= 0 then return end
        _BattleSound:Play("click")
        self._T.summoning = true
        self:SetButtonEnabled(self.summonActionButton, false)
        -- If the server refuses (no result comes back), the button frees itself after a few seconds.
        _TimerService:SetTimerOnce(function()
            if self._T.summoning == true then
                self._T.summoning = false
                log("[LobbyUI] summon got no result, button re-enabled")
                self:Render()
            end
        end, 5)
        log("[LobbyUI] summon requested " .. stoneId)
        data:RequestSummon(stoneId)
    end

    @ExecSpace("ClientOnly")
    method void ShowSummonResult(string stoneId, string resultCsv)
        -- Starts the reveal: the effect plays for SummonRevealDelay, then one screen per summoned card kind
        -- ("슬라임 3장!"), rarest last. Tapping moves on; after the last one the summary of all cards is shown.
        self._T.summoning = false
        local entries = {}
        for id, count in string.gmatch(resultCsv, "([^,:]+):(%d+)") do
            local unit = _BattleConfig:GetUnit(id)
            local rank = 1
            if unit ~= nil then rank = _BattleConfig:GetRarityRank(unit.rarity) end
            table.insert(entries, { id = id, count = tonumber(count), rank = rank })
        end
        table.sort(entries, function(a, b)
            if a.rank ~= b.rank then return a.rank < b.rank end
            return a.count > b.count
        end)
        self._T.reveal = { stoneId = stoneId, csv = resultCsv, entries = entries, index = 0, ownedBefore = self._T.ownedBefore or {} }
        local panel = self.revealPanel
        if not isvalid(panel) or #entries == 0 then
            self:ShowChestResult(stoneId, resultCsv)
            return
        end
        panel.Enable = true
        local stone = _BattleConfig:GetSummonStone(stoneId)
        local effect = panel:GetChildByName("Effect")
        if isvalid(effect) and stone ~= nil then
            -- Re-enable so the clip starts from its first frame.
            effect.Enable = false
            effect.SpriteGUIRendererComponent.ImageRUID = DataRef(stone.effectRuid)
            effect.Enable = true
        end
        self:SetChildEnable(panel, "Card", false)
        self:SetChildText(panel, "Title", "")
        self:SetChildText(panel, "Sub", "")
        self:SetChildText(panel, "Counter", "")
        if self._T.revealTimer ~= nil then _TimerService:ClearTimer(self._T.revealTimer) end
        self._T.revealTimer = _TimerService:SetTimerOnce(function()
            self._T.revealTimer = nil
            self:ShowRevealEntry(1)
        end, _BattleConfig.SummonRevealDelay)
        log("[LobbyUI] summon reveal started " .. stoneId .. " kinds=" .. tostring(#entries))
    end

    @ExecSpace("ClientOnly")
    method void ShowRevealEntry(integer index)
        -- Shows one summoned card kind: its stand clip (monster / build) or icon (skill), rarity frame,
        -- "이름 N장!" and a NEW mark for a unit that was not owned before.
        local reveal = self._T.reveal
        local panel = self.revealPanel
        if reveal == nil or not isvalid(panel) then return end
        local entry = reveal.entries[index]
        if entry == nil then
            self:FinishReveal()
            return
        end
        reveal.index = index
        local unit = _BattleConfig:GetUnit(entry.id)
        local card = panel:GetChildByName("Card")
        if isvalid(card) then
            card.Enable = true
            local picture = card:GetChildByName("Unit")
            local ruid = _BattleConfig:GetRevealRuid(entry.id)
            if isvalid(picture) then
                if ruid ~= "" then picture.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid) end
                picture.Enable = ruid ~= ""
            end
            _BattleConfig:PaintRarityFrame(card, entry.id)
        end
        local name = entry.id
        local sub = ""
        if unit ~= nil then
            name = unit.name
            sub = _BattleConfig:GetRarityLabel(unit.rarity) .. " · " .. self:KindLabel(unit.kind)
            if unit.starter == false and reveal.ownedBefore[entry.id] == nil then sub = "NEW!  " .. sub end
        end
        self:SetChildText(panel, "Title", name .. " " .. tostring(entry.count) .. "장!")
        self:SetChildText(panel, "Sub", sub)
        self:SetChildText(panel, "Counter", tostring(index) .. " / " .. tostring(#reveal.entries))
        _BattleSound:Play("click")
        log("[LobbyUI] reveal " .. tostring(index) .. "/" .. tostring(#reveal.entries) .. " " .. entry.id .. " x" .. tostring(entry.count))
    end

    @ExecSpace("ClientOnly")
    method void OnRevealTapped()
        -- Tap during the reveal: skips the opening effect, or moves to the next card kind.
        local reveal = self._T.reveal
        if reveal == nil then return end
        if self._T.revealTimer ~= nil then
            _TimerService:ClearTimer(self._T.revealTimer)
            self._T.revealTimer = nil
        end
        self:ShowRevealEntry(reveal.index + 1)
    end

    @ExecSpace("ClientOnly")
    method void FinishReveal()
        -- Ends the reveal and shows the summary of every summoned card (the chest result panel).
        local reveal = self._T.reveal
        if self._T.revealTimer ~= nil then
            _TimerService:ClearTimer(self._T.revealTimer)
            self._T.revealTimer = nil
        end
        if isvalid(self.revealPanel) then self.revealPanel.Enable = false end
        self._T.reveal = nil
        if reveal == nil then return end
        log("[LobbyUI] reveal finished " .. reveal.stoneId)
        self:ShowChestResult(reveal.stoneId, reveal.csv)
    end

    -- ===== Chest result =====

    @ExecSpace("ClientOnly")
    method void ShowChestResult(string chestId, string resultCsv)
        -- Shows the cards a chest gave: one card per unit with its count, rarity frame and a NEW mark for units
        -- that were not owned before this result arrived.
        if not isvalid(self.chestPanel) then return end
        local chest = _BattleConfig:GetChest(chestId)
        local entries = {}
        local total = 0
        for id, count in string.gmatch(resultCsv, "([^,:]+):(%d+)") do
            table.insert(entries, { id = id, count = tonumber(count) })
            total = total + tonumber(count)
        end
        local ownedBefore = self._T.ownedBefore or {}
        ---@type PlayerData
        local data = self:GetData()
        local counts = {}
        if data ~= nil then counts = data:GetCardCounts() end
        local cards = self:SyncPool("chest", self.chestCard, #entries, "", function(item) end)
        for i, entry in ipairs(entries) do
            local item = cards[i]
            local unit = _BattleConfig:GetUnit(entry.id)
            item.key = entry.id
            self:SetChildIcon(item.entity, entry.id)
            _BattleConfig:PaintRarityFrame(item.entity, entry.id)
            self:SetChildText(item.entity, "Name", unit and unit.name or entry.id)
            self:SetChildText(item.entity, "CountBadge", "x" .. tostring(entry.count))
            local note = _BattleConfig:GetRarityLabel(unit and unit.rarity or "normal")
            -- NEW when the unit was not owned the last time this screen drew, or when every card it has came
            -- from this chest (starters are always owned, so they are never NEW).
            local isStarter = unit ~= nil and unit.starter
            local allFromChest = (counts[entry.id] or 0) == entry.count
            if isStarter == false and (ownedBefore[entry.id] == nil or allFromChest) then note = "NEW! " .. note end
            self:SetChildText(item.entity, "Note", note)
        end
        if isvalid(self.chestTitle) then
            self.chestTitle.Text = (chest and chest.name or chestId) .. " — 카드 " .. tostring(total) .. "장"
        end
        -- The result covers the screen behind it, so that screen's panel is hidden until the result is closed.
        for _, panel in ipairs({ self.mainPanel, self.stagePanel, self.deckPanel, self.shopPanel, self.ticketPanel, self.summonPanel, self.revealPanel }) do
            if isvalid(panel) then panel.Enable = false end
        end
        self.chestPanel.Enable = true
        log("[LobbyUI] chest result " .. chestId .. " cards=" .. tostring(total) .. " units=" .. tostring(#entries))
    end

    @ExecSpace("ClientOnly")
    method void OnChestCloseClicked()
        -- Closes the chest result and redraws the screen behind it.
        _BattleSound:Play("click")
        if isvalid(self.chestPanel) then self.chestPanel.Enable = false end
        self:ShowScreen(self.Screen)
    end

    -- ===== Ticket shop (World Shop products paid with Worldcoin) =====

    @ExecSpace("ClientOnly")
    method void RenderTicketShop()
        -- Draws one row per product of ShopProductTable; a product without a World Shop id is not on sale yet.
        local products = _BattleConfig:GetShopProducts()
        local rows = self:SyncPool("ticket", self.ticketRow, #products, "Action", function(item) self:OnTicketBuyClicked(item.index) end)
        local summary = {}
        for i, product in ipairs(products) do
            local item = rows[i]
            local onSale = product.productId ~= ""
            if item.iconCurrency ~= product.currencyId then
                item.iconCurrency = product.currencyId
                self:SetCurrencyIcon(item.entity, product.currencyId)
            end
            self:SetChildText(item.entity, "Name", product.label)
            local price = nil
            if self._T.prices ~= nil then price = self._T.prices[product.productId] end
            if price ~= nil then
                self:SetChildText(item.entity, "Kind", "월드 코인 " .. tostring(price) .. " · 결제 즉시 지급")
            else
                self:SetChildText(item.entity, "Kind", "월드 코인으로 구매 · 결제 즉시 지급")
            end
            if onSale then
                item.button.TextGUIRendererComponent.Text = "구매"
            else
                item.button.TextGUIRendererComponent.Text = "준비 중"
            end
            self:SetButtonEnabled(item.button, onSale)
            table.insert(summary, product.label .. (onSale and "+" or "-"))
        end
        log("[LobbyUI] ticket shop rendered rows=" .. tostring(#products) .. " [" .. table.concat(summary, ", ") .. "]")
    end

    @ExecSpace("ClientOnly")
    method void LoadTicketPrices()
        -- Asks the World Shop once for the registered price of each product (this waits for the service),
        -- then redraws the ticket shop so the rows show the price.
        if self._T.pricesRequested == true then return end
        self._T.pricesRequested = true
        local prices = {}
        for _, product in ipairs(_BattleConfig:GetShopProducts()) do
            if product.productId ~= "" then
                local info = _WorldShopService:GetProductAndWait(product.productId)
                if info ~= nil then
                    prices[product.productId] = info.Price
                    log("[LobbyUI] product " .. product.productId .. " price=" .. tostring(info.Price) .. " name=" .. tostring(info.Name))
                else
                    log("[LobbyUI] product " .. product.productId .. " was not found in the World Shop")
                end
            end
        end
        self._T.prices = prices
        if self.Screen == "ticket" then self:RenderTicketShop() end
    end

    @ExecSpace("ClientOnly")
    method void OnTicketBuyClicked(integer index)
        -- Opens the World Shop purchase window of the product; the server delivers it when the payment completes.
        local product = _BattleConfig:GetShopProducts()[index]
        if product == nil or product.productId == "" then return end
        _BattleSound:Play("click")
        log("[LobbyUI] purchase window requested product=" .. product.productId .. " (" .. product.label .. ")")
        _WorldShopService:PromptPurchase(product.productId)
    end

    -- ===== Navigation =====

    @ExecSpace("ClientOnly")
    method void OnMenuClicked(string screen)
        -- Menu / tab button: opens the stage select (campaign), deck edit, chest shop or currency shop screen.
        _BattleSound:Play("click")
        self:ShowScreen(screen)
        -- The price lookup waits for the World Shop, so it runs on its own after the screen is already up.
        if screen == "ticket" then
            _TimerService:SetTimerOnce(function() self:LoadTicketPrices() end, 0.05)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnBackClicked()
        -- Back button: returns to the lobby main screen.
        _BattleSound:Play("click")
        self:ShowScreen("main")
    end

end
