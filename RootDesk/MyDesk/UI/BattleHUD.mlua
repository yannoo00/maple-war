@Component
script BattleHUD extends Component

    property Entity slot1 = "2f3c1e79-defe-4d1f-a6a3-db5bccf656f3"
    property Entity slot2 = "edf4367e-faf0-4ddc-8a3f-83ed27a0b6b0"
    property Entity slot3 = "9c7a19b5-2bef-43c5-9e8f-dc5961519b54"
    property Entity slot4 = "c581ddfe-ba86-43c6-8437-8888cd7bc44e"
    property Entity slot5 = "bc2f845e-6b01-4693-9a4a-fa32b1d49cf6"
    property Entity slot6 = "9259cbd7-0378-4ddb-a2d3-68d3a5affaff"
    property Entity slot7 = "c6f95009-b338-4b3d-af12-0377b0144e7c"
    property Entity slot8 = "696bef19-2e8f-4f53-9514-d970b7cb4a8c"
    -- Card slots (DeckBar/Slot1..8): one per deck card, fixed for the whole battle. Each shows the card's picture, name
    -- and mana cost; Dim covers a card that cannot be afforded, and while the card's summon cooldown runs a dark shade
    -- (Cool) drains away downward with the seconds left on it (Time).
    -- Mana bar above the cards, always as wide as the eight card slots (ManaBarSpan) with the mana upgrade button at its
    -- end. The gray track stands for the top mana level's cap (the most mana a battle can ever hold); the blue capacity
    -- band over it is the current level's cap, and the bright fill is the current mana. Each upgrade turns more of the
    -- gray into blue. When the upgrade can be bought, the button turns gold and pulses with a glow behind it.
    property TextGUIRendererComponent costText = "b92d3aba-b29d-4ec9-8adf-65da42154e40"
    property Entity manaBar = "34f25da6-2ff1-46e9-80ff-95bd4eb21611"
    property Entity manaTrack = "96b8354c-93ec-4b43-a7d6-ac12c6d72303"
    property Entity manaCap = "4a0eff02-4110-4f6c-a9e2-61ff78920254"
    property Entity manaFill = "8f4ca85f-cb77-4d68-8871-c5a1c9b39c35"
    property Entity costUpGlow = "920ac2d9-4785-48a3-a61a-8b7f37866d06"
    property number ManaBarSpan = 1124
    property number ManaButtonGap = 8
    property number ManaFillInset = 4
    -- Upgrade-ready highlight: glow alpha and button scale pulse UpgradePulseSpeed radians per second.
    property number UpgradePulseSpeed = 6
    property number UpgradePulseScale = 0.06
    property Color UpgradeReadyColor = Color(1, 0.76, 0.18, 1)
    property Color UpgradeReadyTextColor = Color(0.18, 0.1, 0, 1)
    property Entity hintText = "f91a8765-50c0-45b7-aaa1-4958e8617766"
    property Entity resultPanel = "7dbea0c5-0735-4c23-91be-a514da25bba0"
    property TextGUIRendererComponent resultTitle = "9a5c134a-9e8a-48db-8a8c-2b9b91a04a42"
    property Entity restartButton = "5f7e38cf-9da6-47a9-ab56-153cefc9653f"
    property TextGUIRendererComponent rewardText = "17d0fb37-ff25-42b2-8be3-a2140dd7511c"
    property TextGUIRendererComponent cardsText = "b78ce39a-906e-46f4-8ab3-5e486d318f9f"
    property Entity lobbyButton = "177bfba2-0e4e-4206-97f5-2d4e28890fea"
    property Entity leaveButton = "d2dd96f0-9b59-4e54-a4a6-264ae4c6a6dd"
    property Entity costUpButton = "4a9f0d6a-4976-4ed4-bd97-0f528cb31862"
    -- Base skill slots (bottom right, SkillQuickSlot/slot_01..03): one round button per skill of my base. Each shows the
    -- skill's icon, a dark radial shade (Cool) that shrinks as the cooldown runs out and the seconds left (Time);
    -- pressing a ready active skill starts aiming it. A slot the base has no skill for is hidden.
    property Entity skillPanel = "fb8928c6-4916-4b8f-986f-ce26d7ef9f8b"
    property Entity skillSlot1 = "69d3d846-f543-440d-85f5-9888559e6384"
    property Entity skillSlot2 = "6a700d9a-67bb-4954-b340-730eb9fa6f72"
    property Entity skillSlot3 = "59f00c8d-d907-4cbc-8d3c-238984f1211c"
    property table skillHandlers = {}
    -- The slot whose skill is being aimed is drawn this much larger.
    property number SkillAimScale = 1.12
    property any costUpHandler = nil
    -- Highlight when a card's cooldown ends: it swells by ReadyPulseScale and settles over ReadyPulseSeconds.
    property number ReadyPulseSeconds = 0.3
    property number ReadyPulseScale = 0.18
    property any restartHandler = nil
    property any lobbyHandler = nil
    property any leaveHandler = nil
    property table slotHandlers = {}

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Binds the card slots, clears the card texts and wires the button clicks.
        local slotEntities = { self.slot1, self.slot2, self.slot3, self.slot4, self.slot5, self.slot6, self.slot7, self.slot8 }
        -- Slots start empty; ApplyDeck fills them from the deck of the side this player controls.
        local slots = {}
        local cards = 0
        self.slotHandlers = {}
        for i = 1, _BattleConfig.DeckSize do
            local entity = slotEntities[i]
            if isvalid(entity) then
                local nameEntity = entity:GetChildByName("Name")
                local costEntity = entity:GetChildByName("Cost")
                local dimEntity = entity:GetChildByName("Dim")
                local iconEntity = entity:GetChildByName("Icon")
                local coolEntity = entity:GetChildByName("Cool")
                local timeEntity = entity:GetChildByName("Time")
                if isvalid(iconEntity) then iconEntity.Enable = false end
                if isvalid(coolEntity) then coolEntity.Enable = false end
                if isvalid(timeEntity) then timeEntity.TextGUIRendererComponent.Text = "" end
                local slotIndex = i
                local clickHandler = entity:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked(slotIndex) end)
                table.insert(self.slotHandlers, { entity = entity, eventHandler = clickHandler })
                nameEntity.TextGUIRendererComponent.Text = ""
                costEntity.TextGUIRendererComponent.Text = ""
                entity.ButtonComponent.Enable = false
                dimEntity.Enable = true
                table.insert(slots, {
                    entity = entity, nameText = nameEntity.TextGUIRendererComponent, costText = costEntity.TextGUIRendererComponent,
                    cfg = nil, unitId = "", dim = dimEntity, icon = iconEntity, dimmed = true, readyPulse = 0,
                    cool = coolEntity, time = timeEntity, cooling = false, shade = -1, timeLabel = "",
                })
            end
        end
        self._T.slots = slots
        self._T.view = {}

        if isvalid(self.restartButton) then
            self.restartHandler = self.restartButton:ConnectEvent(ButtonClickEvent, self.OnRestartClicked)
        end
        if isvalid(self.lobbyButton) then
            self.lobbyHandler = self.lobbyButton:ConnectEvent(ButtonClickEvent, self.OnLeaveClicked)
        end
        if isvalid(self.leaveButton) then
            self.leaveHandler = self.leaveButton:ConnectEvent(ButtonClickEvent, self.OnLeaveClicked)
            self.leaveButton.Enable = false
        end
        if isvalid(self.costUpButton) then
            self.costUpHandler = self.costUpButton:ConnectEvent(ButtonClickEvent, self.OnCostUpClicked)
            self.costUpButton.Enable = false
        end
        -- Base skill slots: hidden until the battle tells which skills my base has.
        local skillSlots = {}
        self.skillHandlers = {}
        for i, entity in ipairs({ self.skillSlot1, self.skillSlot2, self.skillSlot3 }) do
            if isvalid(entity) then
                local skillIndex = i
                local clickHandler = entity:ConnectEvent(ButtonClickEvent, function() self:OnBaseSkillClicked(skillIndex) end)
                table.insert(self.skillHandlers, { entity = entity, eventHandler = clickHandler })
                skillSlots[i] = {
                    entity = entity, icon = entity:GetChildByName("Icon"), cool = entity:GetChildByName("Cool"), time = entity:GetChildByName("Time"),
                    skillId = "", label = "", usable = nil, shade = -1, aimed = false,
                }
                entity.Enable = false
            end
        end
        self._T.skillSlots = skillSlots
        if isvalid(self.skillPanel) then self.skillPanel.Enable = false end
        if isvalid(self.hintText) then self.hintText.Enable = false end
        if isvalid(self.resultPanel) then self.resultPanel.Enable = false end
        log("[BattleHUD] initialized slots=" .. tostring(#slots) .. " cards=" .. tostring(cards))
    end

    @ExecSpace("ClientOnly")
    method void ApplyDeck(table deckIds)
        -- Fills the card slots from the synced deck (unit ids in slot order; a slot past the end of the deck stays
        -- empty). Only slots whose card changed are redrawn.
        local changed = {}
        for i, slot in ipairs(self._T.slots) do
            local unitId = deckIds[i] or ""
            if unitId ~= slot.unitId then
                slot.unitId = unitId
                local cfg = nil
                if unitId ~= "" then cfg = _BattleConfig:GetUnit(unitId) end
                slot.cfg = cfg
                self:PaintCard(slot.entity, unitId)
                if cfg ~= nil then
                    slot.nameText.Text = cfg.name
                    slot.costText.Text = tostring(math.floor(cfg.cost))
                else
                    slot.nameText.Text = ""
                    slot.costText.Text = ""
                end
                slot.entity.ButtonComponent.Enable = cfg ~= nil
                slot.dimmed = (cfg == nil)
                slot.dim.Enable = slot.dimmed
                slot.entity.UITransformComponent.UIScale = Vector3(1, 1, 1)
                slot.readyPulse = 0
                self:PaintCooldown(slot, 0)
                table.insert(changed, tostring(i) .. "=" .. (unitId ~= "" and unitId or "-"))
            end
        end
        log("[BattleHUD] deck applied [" .. table.concat(changed, " ") .. "] cards=" .. tostring(#deckIds))
    end

    @ExecSpace("ClientOnly")
    method void PaintCooldown(table slot, number left)
        -- Draws a card slot's summon cooldown: the shade covers the card and drains away with the time left (left
        -- seconds of the card's Cooldown), with the seconds on it. The moment the cooldown ends the card pulses once.
        local cooling = left > 0 and slot.cfg ~= nil
        if cooling ~= slot.cooling then
            local ended = slot.cooling and cooling == false and slot.cfg ~= nil
            slot.cooling = cooling
            slot.shade = -1
            if isvalid(slot.cool) then slot.cool.Enable = cooling end
            if ended then slot.readyPulse = self.ReadyPulseSeconds end
        end
        local label = ""
        if cooling then
            label = tostring(math.ceil(left))
            local shade = 1
            if slot.cfg.cooldown > 0 then shade = math.max(0, math.min(1, left / slot.cfg.cooldown)) end
            if isvalid(slot.cool) and math.abs(shade - slot.shade) > 0.005 then
                slot.shade = shade
                slot.cool.SpriteGUIRendererComponent.FillAmount = shade
            end
        end
        if label ~= slot.timeLabel then
            slot.timeLabel = label
            if isvalid(slot.time) then slot.time.TextGUIRendererComponent.Text = label end
        end
    end

    @ExecSpace("ClientOnly")
    method void PaintCard(Entity card, string unitId)
        -- Draws a card's unit image (Icon child) and rarity frame; both hidden for an empty card.
        local icon = card:GetChildByName("Icon")
        local iconRuid = ""
        if unitId ~= "" then iconRuid = _BattleConfig:GetIconRuid(unitId) end
        if isvalid(icon) then
            if iconRuid ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = DataRef(iconRuid) end
            icon.Enable = iconRuid ~= ""
        end
        _BattleConfig:PaintRarityFrame(card, unitId)
    end

    @ExecSpace("ClientOnly")
    method any GetCommander()
        -- Returns the local player's Commander component, or nil until the player exists.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return nil end
        return player:GetComponent("script.Commander")
    end

    @ExecSpace("ClientOnly")
    method any GetDirector()
        -- Returns the BattleDirector on the battle map, or nil until the map is loaded on this client.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return nil end
        local map = player.CurrentMap
        if not isvalid(map) then return nil end
        return map:GetComponent("script.BattleDirector")
    end

    @ExecSpace("ClientOnly")
    method void SetHudVisible(boolean visible)
        -- Shows or hides the battle panels; the hint and result panel stay hidden until the battle state turns them on.
        if isvalid(self.slot1) then self.slot1.Parent:SetEnable(visible) end
        if isvalid(self.manaBar) then self.manaBar:SetEnable(visible) end
        if isvalid(self.leaveButton) then self.leaveButton:SetEnable(visible) end
        if isvalid(self.costUpButton) then self.costUpButton:SetEnable(visible) end
        if isvalid(self.costUpGlow) then self.costUpGlow.Enable = false end
        if isvalid(self.skillPanel) then self.skillPanel:SetEnable(visible) end
        if isvalid(self.hintText) then self.hintText.Enable = false end
        if isvalid(self.resultPanel) then self.resultPanel.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void LayoutManaBar(number cost, number costMax, integer level)
        -- Sizes the mana bar. The track is fixed (hand width minus the upgrade button) and is scaled to the top mana
        -- level's cap (CostLevelTable CostMax), so one pixel always means the same mana: the capacity band is
        -- costMax wide, the fill cost wide (never past the band). The upgrade button and its glow sit after the track.
        if not isvalid(self.manaTrack) then return end
        local levels = _BattleConfig:GetCostLevels()
        local top = levels[#levels]
        local topMax = costMax
        if top ~= nil and top.costMax > topMax then topMax = top.costMax end
        local buttonWidth = 0
        if isvalid(self.costUpButton) then buttonWidth = self.costUpButton.UITransformComponent.RectSize.x end
        local width = math.floor(self.ManaBarSpan - buttonWidth - self.ManaButtonGap)
        local view = self._T.view
        if width ~= view.manaWidth then
            view.manaWidth = width
            local track = self.manaTrack.UITransformComponent
            track.RectSize = Vector2(width, track.RectSize.y)
            if isvalid(self.costText) then
                local textTransform = self.costText.Entity.UITransformComponent
                textTransform.RectSize = Vector2(width, textTransform.RectSize.y)
            end
            if isvalid(self.costUpButton) then
                local pos = self.costUpButton.UITransformComponent.anchoredPosition
                self.costUpButton.UITransformComponent.anchoredPosition = Vector2(width + self.ManaButtonGap, pos.y)
            end
            if isvalid(self.costUpGlow) then
                -- Centered on the button: the glow is a few pixels larger on every side.
                local glow = self.costUpGlow.UITransformComponent
                local pad = (glow.RectSize.x - buttonWidth) * 0.5
                glow.anchoredPosition = Vector2(width + self.ManaButtonGap - pad, glow.anchoredPosition.y)
            end
        end
        local inner = width - self.ManaFillInset * 2
        local capRatio = 0
        if topMax > 0 then capRatio = math.max(0, math.min(1, costMax / topMax)) end
        local capWidth = inner * capRatio
        if isvalid(self.manaCap) then
            local capTransform = self.manaCap.UITransformComponent
            capTransform.RectSize = Vector2(capWidth, capTransform.RectSize.y)
        end
        if isvalid(self.manaFill) then
            local fillWidth = 0
            if topMax > 0 then fillWidth = math.min(capWidth, inner * math.max(0, cost) / topMax) end
            local fillTransform = self.manaFill.UITransformComponent
            fillTransform.RectSize = Vector2(fillWidth, fillTransform.RectSize.y)
            -- A sliced sprite still draws its borders at width 0, so an empty bar hides the fill.
            local shown = fillWidth >= 1
            if self.manaFill.Enable ~= shown then self.manaFill.Enable = shown end
        end
        if math.floor(costMax) ~= view.manaCapLogged then
            view.manaCapLogged = math.floor(costMax)
            log("[VRF] BattleHUD mana bar level=" .. tostring(level) .. " max=" .. tostring(math.floor(costMax)) .. "/" .. tostring(math.floor(topMax)) .. " capWidth=" .. tostring(math.floor(capWidth)) .. "/" .. tostring(inner))
        end
    end

    @ExecSpace("ClientOnly")
    method void SetUpgradeReady(boolean ready)
        -- Switches the mana upgrade button between its normal look and the gold "ready to buy" look; the pulse itself
        -- runs in UpdateUpgradePulse.
        local button = self.costUpButton
        if not isvalid(button) then return end
        local view = self._T.view
        if view.upgradeNormalColor == nil then
            view.upgradeNormalColor = button.SpriteGUIRendererComponent.Color
            view.upgradeNormalTextColor = button.TextGUIRendererComponent.FontColor
        end
        if ready then
            button.SpriteGUIRendererComponent.Color = self.UpgradeReadyColor
            button.TextGUIRendererComponent.FontColor = self.UpgradeReadyTextColor
        else
            button.SpriteGUIRendererComponent.Color = view.upgradeNormalColor
            button.TextGUIRendererComponent.FontColor = view.upgradeNormalTextColor
            button.UITransformComponent.UIScale = Vector3(1, 1, 1)
        end
        if isvalid(self.costUpGlow) and self.costUpGlow.Enable ~= ready then self.costUpGlow.Enable = ready end
        view.upgradePulse = 0
        log("[VRF] BattleHUD mana upgrade ready=" .. tostring(ready))
    end

    @ExecSpace("ClientOnly")
    method void UpdateUpgradePulse(number delta)
        -- While the upgrade can be bought: the glow behind the button breathes and the button gently swells.
        local view = self._T.view
        if view.costUpUsable ~= true or not isvalid(self.costUpButton) then return end
        view.upgradePulse = (view.upgradePulse or 0) + delta * self.UpgradePulseSpeed
        local wave = (math.sin(view.upgradePulse) + 1) * 0.5
        local s = 1 + self.UpgradePulseScale * wave
        self.costUpButton.UITransformComponent.UIScale = Vector3(s, s, 1)
        if isvalid(self.costUpGlow) then
            local c = self.UpgradeReadyColor
            self.costUpGlow.SpriteGUIRendererComponent.Color = Color(c.r, c.g, c.b, 0.25 + 0.5 * wave)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnSlotClicked(integer slot)
        -- Plays or selects the deck card of the clicked slot through the Commander.
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] slot clicked " .. tostring(slot))
        commander:SelectSlot(slot)
    end

    @ExecSpace("ClientOnly")
    method void OnBaseSkillClicked(integer index)
        -- Starts aiming the base skill of a slot through the Commander (the cooldown is checked there and again on the server).
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] base skill clicked slot=" .. tostring(index))
        commander:SelectBaseSkill(index)
    end

    @ExecSpace("ClientOnly")
    method void OnCostUpClicked()
        -- Asks the server to raise the in-battle cost level (bigger cost cap, faster income).
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] cost upgrade clicked")
        commander:RequestUpgradeCost()
    end

    @ExecSpace("ClientOnly")
    method void OnRestartClicked()
        -- Asks the server to restart the battle from the result panel.
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] restart clicked")
        commander:RequestRestart()
    end

    @ExecSpace("ClientOnly")
    method void OnLeaveClicked()
        -- Asks the server to return this player to the lobby (leave button and the result panel's lobby button).
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] leave clicked, returning to lobby")
        _LoadingLogic:Begin()
        commander:RequestLeaveBattle()
    end

    @ExecSpace("ClientOnly")
    method void UpdateBaseSkills(any side, string state, integer pending, integer pendingBase)
        -- Shows my base's skills on the skill slots. Slot n shows skill n: its icon, the cooldown shade and the seconds
        -- left ("자동" for a passive skill, which the base casts by itself). An active skill's button is usable only when
        -- its cooldown is over and the battle is running; the slot being aimed (pending) is drawn larger.
        local skillSlots = self._T.skillSlots
        if skillSlots == nil then return end
        ---@type BattleSide
        local s = side
        local skills = s:GetBaseSkills()
        local now = _UtilLogic.ServerElapsedSeconds
        for i, slot in pairs(skillSlots) do
            local skill = skills[i]
            local shown = skill ~= nil
            if slot.entity.Enable ~= shown then slot.entity.Enable = shown end
            if skill ~= nil then
                if skill.id ~= slot.skillId then
                    slot.skillId = skill.id
                    slot.usable = nil
                    slot.label = nil
                    local iconRuid = _BattleConfig:GetIconRuid(skill.id)
                    if isvalid(slot.icon) then
                        if iconRuid ~= "" then slot.icon.SpriteGUIRendererComponent.ImageRUID = DataRef(iconRuid) end
                        slot.icon.Enable = iconRuid ~= ""
                    end
                    log("[BattleHUD] base skill slot " .. tostring(i) .. " = " .. skill.id .. " type=" .. skill.type .. " cooldown=" .. tostring(skill.cooldown))
                end
                local left = math.max(0, skill.readyAt - now)
                local label = ""
                local usable = false
                if skill.type == "passive" then
                    label = "자동"
                elseif left > 0 then
                    label = tostring(math.ceil(left))
                else
                    usable = state == "PLAYING"
                end
                if label ~= slot.label then
                    slot.label = label
                    if isvalid(slot.time) then slot.time.TextGUIRendererComponent.Text = label end
                end
                -- The shade covers the slot while the skill cools down and drains away with the time left.
                local shade = 0
                if skill.cooldown > 0 then shade = math.max(0, math.min(1, left / skill.cooldown)) end
                if isvalid(slot.cool) then
                    local shading = shade > 0
                    if slot.cool.Enable ~= shading then slot.cool.Enable = shading end
                    if shading and math.abs(shade - slot.shade) > 0.005 then
                        slot.shade = shade
                        slot.cool.SpriteGUIRendererComponent.FillAmount = shade
                    end
                end
                if usable ~= slot.usable then
                    slot.usable = usable
                    slot.entity.ButtonComponent.Enable = usable
                end
                local aimed = pending == pendingBase + i
                if aimed ~= slot.aimed then
                    slot.aimed = aimed
                    local size = 1
                    if aimed then size = self.SkillAimScale end
                    slot.entity.UITransformComponent.UIScale = Vector3(size, size, 1)
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Mirrors the battle state into the HUD; widgets are only written when their value changes.
        local slots = self._T.slots
        local view = self._T.view
        if slots == nil or view == nil then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end

        -- The HUD only shows on a map that has a BattleDirector (a battle instance), not in the lobby.
        local inBattle = director ~= nil
        if inBattle ~= view.inBattle then
            self:SetHudVisible(inBattle)
            view = { inBattle = inBattle }
            self._T.view = view
            if inBattle == false then _BattleSound:StopBgm() end
            log("[BattleHUD] inBattle=" .. tostring(inBattle))
        end
        if inBattle == false then return end

        -- Everything below is read from "my side" and "the other side", never from fixed teams.
        ---@type BattleSide
        local mySide = commander:GetSideOf(true)
        ---@type BattleSide
        local otherSide = commander:GetSideOf(false)
        if mySide == nil or otherSide == nil then return end
        if mySide.DeckCsv ~= view.deckCsv then
            view.deckCsv = mySide.DeckCsv
            self:ApplyDeck(mySide:GetDeckIds())
        end

        local state = director.State
        if state == "ENDED" then
            if director.WinnerTeam == mySide.Team then state = "WIN" else state = "LOSE" end
        end
        local cost = math.floor(mySide.Cost)
        if cost ~= view.cost then
            view.cost = cost
            if isvalid(self.costText) then
                self.costText.Text = tostring(cost) .. " / " .. tostring(math.floor(mySide.CostMax))
            end
            self:LayoutManaBar(mySide.Cost, mySide.CostMax, mySide.CostLevel)
            -- Cost level button: shows the level and the price of the next one; dimmed when it cannot be bought now.
            if isvalid(self.costUpButton) then
                local current = _BattleConfig:GetCostLevels()[mySide.CostLevel]
                -- The price already includes the base's upgrade discount (BattleSide.UpgradeCost).
                local upgradePrice = mySide.UpgradeCost
                local atCap = mySide.CostLevel >= mySide.CostLevelCap or current == nil or upgradePrice <= 0
                local label = "Lv " .. tostring(mySide.CostLevel)
                local usable = false
                if atCap then
                    label = label .. "  최대"
                else
                    label = label .. "  " .. tostring(math.floor(upgradePrice))
                    usable = cost >= upgradePrice and state == "PLAYING"
                end
                if label ~= view.costUpLabel then
                    view.costUpLabel = label
                    self.costUpButton.TextGUIRendererComponent.Text = label
                    log("[BattleHUD] cost level " .. tostring(mySide.CostLevel) .. "/" .. tostring(mySide.CostLevelCap) .. " max=" .. tostring(math.floor(mySide.CostMax)))
                end
                if usable ~= view.costUpUsable then
                    view.costUpUsable = usable
                    self.costUpButton.ButtonComponent.Enable = usable
                    local dim = self.costUpButton:GetChildByName("Dim")
                    if isvalid(dim) then dim.Enable = usable == false end
                    self:SetUpgradeReady(usable)
                end
            end
            local step = cost // 100
            if step ~= view.costStep then
                view.costStep = step
                log("[BattleHUD] cost=" .. tostring(cost))
            end
        end


        for i, slot in ipairs(slots) do
            if slot.cfg ~= nil then
                self:PaintCooldown(slot, mySide:GetCardCooldownLeft(i))
                if slot.readyPulse > 0 then
                    slot.readyPulse = slot.readyPulse - delta
                    local k = math.max(0, slot.readyPulse / self.ReadyPulseSeconds)
                    -- Scale swells quickly and settles back: 1 -> 1 + ReadyPulseScale -> 1.
                    local s = 1 + self.ReadyPulseScale * math.sin(k * math.pi)
                    if slot.readyPulse <= 0 then s = 1 end
                    slot.entity.UITransformComponent.UIScale = Vector3(s, s, 1)
                end
                -- Dim: the card's cost is not affordable (or the battle is not running). The cooldown has its own shade.
                local dimmed = cost < slot.cfg.cost or state ~= "PLAYING"
                if dimmed ~= slot.dimmed then
                    slot.dimmed = dimmed
                    slot.dim.Enable = dimmed
                end
            end
        end

        self:UpdateUpgradePulse(delta)
        local pending = commander.PendingSlot
        self:UpdateBaseSkills(mySide, state, pending, commander.BaseSkillSlot)

        if pending ~= view.pending then
            view.pending = pending
            if isvalid(self.hintText) then
                self.hintText.Enable = pending ~= 0
                -- A monster card waits for a portal, everything else for a position.
                local waiting = commander:GetPendingUnit()
                if waiting ~= nil then
                    local hint = "전장을 클릭해 위치를 지정하세요 (Esc 취소)"
                    if waiting.kind == "monster" then hint = "소환할 포탈을 클릭하세요 (Esc 취소)" end
                    self.hintText.TextGUIRendererComponent.Text = hint
                end
            end
            log("[BattleHUD] targeting hint " .. tostring(pending ~= 0) .. " slot=" .. tostring(pending))
        end

        if state ~= view.state then
            view.state = state
            local ended = state == "WIN" or state == "LOSE"
            if isvalid(self.resultTitle) then
                if state == "WIN" then
                    self.resultTitle.Text = "승리"
                elseif state == "LOSE" then
                    self.resultTitle.Text = "패배"
                end
            end
            if isvalid(self.resultPanel) then self.resultPanel.Enable = ended end
            if state == "PLAYING" then
                _BattleSound:PlayBgm("bgm_battle")
            elseif ended then
                _BattleSound:StopBgm()
                if state == "WIN" then
                    _BattleSound:Play("win")
                else
                    _BattleSound:Play("lose")
                end
            end
            log("[BattleHUD] state=" .. state .. " resultPanel=" .. tostring(ended))
        end

        -- Earned meso line of the result panel, from the director's synced reward of the finished battle.
        if state == "WIN" or state == "LOSE" then
            local reward = director.RewardMeso
            if reward ~= view.reward then
                view.reward = reward
                if isvalid(self.rewardText) then self.rewardText.Text = "획득 메소 +" .. tostring(reward) end
                log("[BattleHUD] result reward shown: 획득 메소 +" .. tostring(reward))
            end
            -- Reward stone line: the summon stone the battle gave (it goes to storage and is used in the lobby).
            local stoneId = director.RewardChest
            if stoneId ~= view.cardsCsv then
                view.cardsCsv = stoneId
                local text = ""
                local stone = _BattleConfig:GetSummonStone(stoneId)
                if stone ~= nil then text = "보상: " .. stone.name .. " 1개  (로비의 [소환]에서 사용)" end
                if isvalid(self.cardsText) then self.cardsText.Text = text end
                log("[BattleHUD] result stone shown: " .. text)
            end
            -- Restart is another entry: the button shows the stage's entry cost and is off when the player cannot pay it.
            local stage = _BattleConfig:GetStage(director.StageId)
            ---@type PlayerData
            local data = commander.Entity:GetComponent("script.PlayerData")
            if stage ~= nil and data ~= nil and isvalid(self.restartButton) then
                local cost = math.floor(stage.entryCost)
                local held = data:GetCurrencyAmount(_BattleConfig.EntryCurrencyId)
                local ticket = _BattleConfig:GetCurrency(_BattleConfig.EntryCurrencyId)
                local label = "다시 하기"
                if cost > 0 and ticket ~= nil then
                    label = "다시 하기\n" .. ticket.name .. " " .. tostring(cost)
                    if held < cost then label = ticket.name .. " 부족\n" .. tostring(held) .. " / " .. tostring(cost) end
                end
                if label ~= view.restartLabel then
                    view.restartLabel = label
                    self.restartButton.TextGUIRendererComponent.Text = label
                    self.restartButton.ButtonComponent.Enable = held >= cost
                    log("[BattleHUD] restart button cost=" .. tostring(cost) .. " held=" .. tostring(held) .. " enabled=" .. tostring(held >= cost))
                end
            end
        else
            view.reward = nil
            view.restartLabel = nil
            view.cardsCsv = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Disconnects every button click handler.
        for _, rec in ipairs(self.slotHandlers) do
            if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
        end
        self.slotHandlers = {}
        if self.restartHandler ~= nil and isvalid(self.restartButton) then
            self.restartButton:DisconnectEvent(ButtonClickEvent, self.restartHandler)
        end
        self.restartHandler = nil
        if self.lobbyHandler ~= nil and isvalid(self.lobbyButton) then
            self.lobbyButton:DisconnectEvent(ButtonClickEvent, self.lobbyHandler)
        end
        self.lobbyHandler = nil
        if self.leaveHandler ~= nil and isvalid(self.leaveButton) then
            self.leaveButton:DisconnectEvent(ButtonClickEvent, self.leaveHandler)
        end
        self.leaveHandler = nil
        if self.costUpHandler ~= nil and isvalid(self.costUpButton) then
            self.costUpButton:DisconnectEvent(ButtonClickEvent, self.costUpHandler)
        end
        self.costUpHandler = nil
        for _, rec in ipairs(self.skillHandlers) do
            if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
        end
        self.skillHandlers = {}
    end

end
