@Component
script BattleHUD extends Component

    property Entity slot1 = "2f3c1e79-defe-4d1f-a6a3-db5bccf656f3"
    property Entity slot2 = "edf4367e-faf0-4ddc-8a3f-83ed27a0b6b0"
    property Entity slot3 = "9c7a19b5-2bef-43c5-9e8f-dc5961519b54"
    property Entity slot4 = "c581ddfe-ba86-43c6-8437-8888cd7bc44e"
    property Entity slot5 = "bc2f845e-6b01-4693-9a4a-fa32b1d49cf6"
    -- Small preview of the next queued card (the one that fills the next played slot).
    property Entity nextCard = "a5d88760-570a-4549-ae6d-4064dabd9a45"
    property TextGUIRendererComponent costText = "72569f18-c8ed-4434-a834-15eecbc46c00"
    property Entity hintText = "f91a8765-50c0-45b7-aaa1-4958e8617766"
    property TextGUIRendererComponent allyHpText = "7500f34a-4dbf-454b-a622-bbed41c9c0db"
    property TextGUIRendererComponent enemyHpText = "09161ae3-a861-4ae2-8704-115070d396af"
    property UITransformComponent allyHpFill = "f4a07fbe-c85a-4d22-a639-1d17a629f942"
    property UITransformComponent enemyHpFill = "c7249ef5-e749-4c15-9f87-eb41e6c590a3"
    property Entity resultPanel = "7dbea0c5-0735-4c23-91be-a514da25bba0"
    property TextGUIRendererComponent resultTitle = "9a5c134a-9e8a-48db-8a8c-2b9b91a04a42"
    property Entity restartButton = "5f7e38cf-9da6-47a9-ab56-153cefc9653f"
    property TextGUIRendererComponent rewardText = "17d0fb37-ff25-42b2-8be3-a2140dd7511c"
    property TextGUIRendererComponent cardsText = "b78ce39a-906e-46f4-8ab3-5e486d318f9f"
    property Entity lobbyButton = "177bfba2-0e4e-4206-97f5-2d4e28890fea"
    property Entity leaveButton = "d2dd96f0-9b59-4e54-a4a6-264ae4c6a6dd"
    property Entity costUpButton = "47981bee-9856-4688-bb7d-1f67bf65d72e"
    property any costUpHandler = nil
    property number HpBarWidth = 400
    -- Highlight when a new card arrives in a hand slot: it swells by ReadyPulseScale and settles over ReadyPulseSeconds.
    property number ReadyPulseSeconds = 0.3
    property number ReadyPulseScale = 0.18
    property any restartHandler = nil
    property any lobbyHandler = nil
    property any leaveHandler = nil
    property table slotHandlers = {}

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Binds the hand slots, clears the card texts and wires the button clicks.
        local slotEntities = { self.slot1, self.slot2, self.slot3, self.slot4, self.slot5 }
        -- Slots start empty; ApplyHand fills them from the hand of the side this player controls.
        local slots = {}
        local cards = 0
        self.slotHandlers = {}
        for i = 1, _BattleConfig.HandSize do
            local entity = slotEntities[i]
            if isvalid(entity) then
                local nameEntity = entity:GetChildByName("Name")
                local costEntity = entity:GetChildByName("Cost")
                local dimEntity = entity:GetChildByName("Dim")
                local iconEntity = entity:GetChildByName("Icon")
                if isvalid(iconEntity) then iconEntity.Enable = false end
                local slotIndex = i
                local clickHandler = entity:ConnectEvent(ButtonClickEvent, function() self:OnSlotClicked(slotIndex) end)
                table.insert(self.slotHandlers, { entity = entity, eventHandler = clickHandler })
                nameEntity.TextGUIRendererComponent.Text = ""
                costEntity.TextGUIRendererComponent.Text = ""
                entity.ButtonComponent.Enable = false
                dimEntity.Enable = true
                table.insert(slots, {
                    entity = entity, nameText = nameEntity.TextGUIRendererComponent, costText = costEntity.TextGUIRendererComponent,
                    cfg = nil, unitId = "", dim = dimEntity, icon = iconEntity, dimmed = true, readyPulse = 0,
                })
            end
        end
        self._T.slots = slots
        self._T.view = {}
        if isvalid(self.nextCard) then self.nextCard.Parent.Enable = false end

        if isvalid(self.restartButton) then
            self.restartHandler = self.restartButton:ConnectEvent(ButtonClickEvent, self.OnRestartClicked)
        end
        if isvalid(self.lobbyButton) then
            self.lobbyHandler = self.lobbyButton:ConnectEvent(ButtonClickEvent, self.OnLeaveClicked)
        end
        if isvalid(self.leaveButton) then
            self.leaveHandler = self.leaveButton:ConnectEvent(ButtonClickEvent, self.OnLeaveClicked)
            self.leaveButton.Enable = false
        end
        if isvalid(self.costUpButton) then
            self.costUpHandler = self.costUpButton:ConnectEvent(ButtonClickEvent, self.OnCostUpClicked)
            self.costUpButton.Enable = false
        end
        if isvalid(self.hintText) then self.hintText.Enable = false end
        if isvalid(self.resultPanel) then self.resultPanel.Enable = false end
        log("[BattleHUD] initialized slots=" .. tostring(#slots) .. " cards=" .. tostring(cards))
    end

    @ExecSpace("ClientOnly")
    method void ApplyHand(table handIds)
        -- Fills the hand slots from the synced hand (unit ids in slot order, "" = empty). Only slots whose card
        -- changed are redrawn, and a card that replaces a played one pulses once.
        local changed = {}
        for i, slot in ipairs(self._T.slots) do
            local unitId = handIds[i] or ""
            if unitId ~= slot.unitId then
                local hadCard = slot.unitId ~= ""
                slot.unitId = unitId
                local cfg = nil
                if unitId ~= "" then cfg = _BattleConfig:GetUnit(unitId) end
                slot.cfg = cfg
                self:PaintCard(slot.entity, unitId)
                if cfg ~= nil then
                    slot.nameText.Text = cfg.name
                    slot.costText.Text = tostring(math.floor(cfg.cost))
                else
                    slot.nameText.Text = ""
                    slot.costText.Text = ""
                end
                slot.entity.ButtonComponent.Enable = cfg ~= nil
                slot.dimmed = (cfg == nil)
                slot.dim.Enable = slot.dimmed
                slot.entity.UITransformComponent.UIScale = Vector3(1, 1, 1)
                slot.readyPulse = 0
                if hadCard and cfg ~= nil then slot.readyPulse = self.ReadyPulseSeconds end
                table.insert(changed, tostring(i) .. "=" .. (unitId ~= "" and unitId or "-"))
            end
        end
        log("[BattleHUD] hand applied [" .. table.concat(changed, " ") .. "]")
    end

    @ExecSpace("ClientOnly")
    method void ApplyNext(string unitId)
        -- Shows the next queued card in the small preview (hidden when nothing is waiting).
        if not isvalid(self.nextCard) then return end
        local shown = unitId ~= ""
        self.nextCard.Parent.Enable = shown
        if shown then self:PaintCard(self.nextCard, unitId) end
        log("[BattleHUD] next card " .. (shown and unitId or "none"))
    end

    @ExecSpace("ClientOnly")
    method void PaintCard(Entity card, string unitId)
        -- Draws a card's unit / skill image (Icon child) and rarity frame; both hidden for an empty card.
        local icon = card:GetChildByName("Icon")
        local iconRuid = ""
        if unitId ~= "" then iconRuid = _BattleConfig:GetIconRuid(unitId) end
        if isvalid(icon) then
            if iconRuid ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = DataRef(iconRuid) end
            icon.Enable = iconRuid ~= ""
        end
        _BattleConfig:PaintRarityFrame(card, unitId)
    end

    @ExecSpace("ClientOnly")
    method any GetCommander()
        -- Returns the local player's Commander component, or nil until the player exists.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return nil end
        return player:GetComponent("script.Commander")
    end

    @ExecSpace("ClientOnly")
    method any GetDirector()
        -- Returns the BattleDirector on the battle map, or nil until the map is loaded on this client.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return nil end
        local map = player.CurrentMap
        if not isvalid(map) then return nil end
        return map:GetComponent("script.BattleDirector")
    end

    @ExecSpace("ClientOnly")
    method void SetHudVisible(boolean visible)
        -- Shows or hides the battle panels; the hint and result panel stay hidden until the battle state turns them on.
        if isvalid(self.slot1) then self.slot1.Parent:SetEnable(visible) end
        if isvalid(self.costText) then self.costText.Entity:SetEnable(visible) end
        if isvalid(self.allyHpText) then self.allyHpText.Entity.Parent.Parent:SetEnable(visible) end
        if isvalid(self.leaveButton) then self.leaveButton:SetEnable(visible) end
        if isvalid(self.costUpButton) then self.costUpButton:SetEnable(visible) end
        if isvalid(self.hintText) then self.hintText.Enable = false end
        if isvalid(self.resultPanel) then self.resultPanel.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void OnSlotClicked(integer slot)
        -- Plays or selects the deck card of the clicked slot through the Commander.
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] slot clicked " .. tostring(slot))
        commander:SelectSlot(slot)
    end

    @ExecSpace("ClientOnly")
    method void OnCostUpClicked()
        -- Asks the server to raise the in-battle cost level (bigger cost cap, faster income).
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] cost upgrade clicked")
        commander:RequestUpgradeCost()
    end

    @ExecSpace("ClientOnly")
    method void OnRestartClicked()
        -- Asks the server to restart the battle from the result panel.
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] restart clicked")
        commander:RequestRestart()
    end

    @ExecSpace("ClientOnly")
    method void OnLeaveClicked()
        -- Asks the server to return this player to the lobby (leave button and the result panel's lobby button).
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end
        _BattleSound:Play("click")
        log("[BattleHUD] leave clicked, returning to lobby")
        _LoadingLogic:Begin()
        commander:RequestLeaveBattle()
    end

    @ExecSpace("ClientOnly")
    method void SetBaseHp(TextGUIRendererComponent label, UITransformComponent fill, string title, number hp, number maxHp)
        -- Writes one base HP readout and resizes its fill bar.
        if isvalid(label) then
            label.Text = title .. " " .. tostring(math.floor(hp)) .. " / " .. tostring(math.floor(maxHp))
        end
        if isvalid(fill) then
            local ratio = 0
            if maxHp > 0 then ratio = math.max(0, math.min(1, hp / maxHp)) end
            fill.RectSize = Vector2(self.HpBarWidth * ratio, fill.RectSize.y)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Mirrors the battle state into the HUD; widgets are only written when their value changes.
        local slots = self._T.slots
        local view = self._T.view
        if slots == nil or view == nil then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        ---@type Commander
        local commander = self:GetCommander()
        if commander == nil then return end

        -- The HUD only shows on a map that has a BattleDirector (a battle instance), not in the lobby.
        local inBattle = director ~= nil
        if inBattle ~= view.inBattle then
            self:SetHudVisible(inBattle)
            view = { inBattle = inBattle }
            self._T.view = view
            if inBattle == false then _BattleSound:StopBgm() end
            log("[BattleHUD] inBattle=" .. tostring(inBattle))
        end
        if inBattle == false then return end

        -- Everything below is read from "my side" and "the other side", never from fixed teams.
        ---@type BattleSide
        local mySide = commander:GetSideOf(true)
        ---@type BattleSide
        local otherSide = commander:GetSideOf(false)
        if mySide == nil or otherSide == nil then return end
        if mySide.HandCsv ~= view.handCsv then
            view.handCsv = mySide.HandCsv
            self:ApplyHand(mySide:GetHandIds())
        end
        if mySide.NextCardId ~= view.nextCard then
            view.nextCard = mySide.NextCardId
            self:ApplyNext(mySide.NextCardId)
        end

        local state = director.State
        if state == "ENDED" then
            if director.WinnerTeam == mySide.Team then state = "WIN" else state = "LOSE" end
        end
        local cost = math.floor(mySide.Cost)
        if cost ~= view.cost then
            view.cost = cost
            if isvalid(self.costText) then
                self.costText.Text = "코스트 " .. tostring(cost) .. " / " .. tostring(math.floor(mySide.CostMax))
            end
            -- Cost level button: shows the level and the price of the next one; dimmed when it cannot be bought now.
            if isvalid(self.costUpButton) then
                local current = _BattleConfig:GetCostLevels()[mySide.CostLevel]
                local atCap = mySide.CostLevel >= mySide.CostLevelCap or current == nil or current.upgradeCost <= 0
                local label = "코스트 Lv " .. tostring(mySide.CostLevel)
                local usable = false
                if atCap then
                    label = label .. "\n최대"
                else
                    label = label .. "\n강화 " .. tostring(math.floor(current.upgradeCost))
                    usable = cost >= current.upgradeCost and state == "PLAYING"
                end
                if label ~= view.costUpLabel then
                    view.costUpLabel = label
                    self.costUpButton.TextGUIRendererComponent.Text = label
                    log("[BattleHUD] cost level " .. tostring(mySide.CostLevel) .. "/" .. tostring(mySide.CostLevelCap) .. " max=" .. tostring(math.floor(mySide.CostMax)))
                end
                if usable ~= view.costUpUsable then
                    view.costUpUsable = usable
                    self.costUpButton.ButtonComponent.Enable = usable
                    local dim = self.costUpButton:GetChildByName("Dim")
                    if isvalid(dim) then dim.Enable = usable == false end
                end
            end
            local step = cost // 100
            if step ~= view.costStep then
                view.costStep = step
                log("[BattleHUD] cost=" .. tostring(cost))
            end
        end

        ---@type BattleUnit
        local myBase = mySide.Entity:GetComponent("script.BattleUnit")
        ---@type BattleUnit
        local otherBase = otherSide.Entity:GetComponent("script.BattleUnit")
        local maxHp = myBase.MaxHp
        if myBase.Hp ~= view.allyHp or maxHp ~= view.maxHp then
            view.allyHp = myBase.Hp
            self:SetBaseHp(self.allyHpText, self.allyHpFill, "아군 기지", view.allyHp, maxHp)
        end
        if otherBase.Hp ~= view.enemyHp or maxHp ~= view.maxHp then
            view.enemyHp = otherBase.Hp
            self:SetBaseHp(self.enemyHpText, self.enemyHpFill, "적 기지", view.enemyHp, maxHp)
        end
        view.maxHp = maxHp

        for _, slot in ipairs(slots) do
            if slot.cfg ~= nil then
                if slot.readyPulse > 0 then
                    slot.readyPulse = slot.readyPulse - delta
                    local k = math.max(0, slot.readyPulse / self.ReadyPulseSeconds)
                    -- Scale swells quickly and settles back: 1 -> 1 + ReadyPulseScale -> 1.
                    local s = 1 + self.ReadyPulseScale * math.sin(k * math.pi)
                    if slot.readyPulse <= 0 then s = 1 end
                    slot.entity.UITransformComponent.UIScale = Vector3(s, s, 1)
                end
                -- No cooldowns: a card is only dimmed while its cost is not affordable (or the battle is not running).
                local dimmed = cost < slot.cfg.cost or state ~= "PLAYING"
                if dimmed ~= slot.dimmed then
                    slot.dimmed = dimmed
                    slot.dim.Enable = dimmed
                end
            end
        end

        local pending = commander.PendingSlot
        if pending ~= view.pending then
            view.pending = pending
            if isvalid(self.hintText) then self.hintText.Enable = pending ~= 0 end
            log("[BattleHUD] targeting hint " .. tostring(pending ~= 0) .. " slot=" .. tostring(pending))
        end

        if state ~= view.state then
            view.state = state
            local ended = state == "WIN" or state == "LOSE"
            if isvalid(self.resultTitle) then
                if state == "WIN" then
                    self.resultTitle.Text = "승리"
                elseif state == "LOSE" then
                    self.resultTitle.Text = "패배"
                end
            end
            if isvalid(self.resultPanel) then self.resultPanel.Enable = ended end
            if state == "PLAYING" then
                _BattleSound:PlayBgm("bgm_battle")
            elseif ended then
                _BattleSound:StopBgm()
                if state == "WIN" then
                    _BattleSound:Play("win")
                else
                    _BattleSound:Play("lose")
                end
            end
            log("[BattleHUD] state=" .. state .. " resultPanel=" .. tostring(ended))
        end

        -- Earned meso line of the result panel, from the director's synced reward of the finished battle.
        if state == "WIN" or state == "LOSE" then
            local reward = director.RewardMeso
            if reward ~= view.reward then
                view.reward = reward
                if isvalid(self.rewardText) then self.rewardText.Text = "획득 메소 +" .. tostring(reward) end
                log("[BattleHUD] result reward shown: 획득 메소 +" .. tostring(reward))
            end
            -- Reward stone line: the summon stone the battle gave (it goes to storage and is used in the lobby).
            local stoneId = director.RewardChest
            if stoneId ~= view.cardsCsv then
                view.cardsCsv = stoneId
                local text = ""
                local stone = _BattleConfig:GetSummonStone(stoneId)
                if stone ~= nil then text = "보상: " .. stone.name .. " 1개  (로비의 [소환]에서 사용)" end
                if isvalid(self.cardsText) then self.cardsText.Text = text end
                log("[BattleHUD] result stone shown: " .. text)
            end
            -- Restart is another entry: the button shows the stage's entry cost and is off when the player cannot pay it.
            local stage = _BattleConfig:GetStage(director.StageId)
            ---@type PlayerData
            local data = commander.Entity:GetComponent("script.PlayerData")
            if stage ~= nil and data ~= nil and isvalid(self.restartButton) then
                local cost = math.floor(stage.entryCost)
                local held = data:GetCurrencyAmount(_BattleConfig.EntryCurrencyId)
                local ticket = _BattleConfig:GetCurrency(_BattleConfig.EntryCurrencyId)
                local label = "다시 하기"
                if cost > 0 and ticket ~= nil then
                    label = "다시 하기\n" .. ticket.name .. " " .. tostring(cost)
                    if held < cost then label = ticket.name .. " 부족\n" .. tostring(held) .. " / " .. tostring(cost) end
                end
                if label ~= view.restartLabel then
                    view.restartLabel = label
                    self.restartButton.TextGUIRendererComponent.Text = label
                    self.restartButton.ButtonComponent.Enable = held >= cost
                    log("[BattleHUD] restart button cost=" .. tostring(cost) .. " held=" .. tostring(held) .. " enabled=" .. tostring(held >= cost))
                end
            end
        else
            view.reward = nil
            view.restartLabel = nil
            view.cardsCsv = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Disconnects every button click handler.
        for _, rec in ipairs(self.slotHandlers) do
            if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
        end
        self.slotHandlers = {}
        if self.restartHandler ~= nil and isvalid(self.restartButton) then
            self.restartButton:DisconnectEvent(ButtonClickEvent, self.restartHandler)
        end
        self.restartHandler = nil
        if self.lobbyHandler ~= nil and isvalid(self.lobbyButton) then
            self.lobbyButton:DisconnectEvent(ButtonClickEvent, self.lobbyHandler)
        end
        self.lobbyHandler = nil
        if self.leaveHandler ~= nil and isvalid(self.leaveButton) then
            self.leaveButton:DisconnectEvent(ButtonClickEvent, self.leaveHandler)
        end
        self.leaveHandler = nil
        if self.costUpHandler ~= nil and isvalid(self.costUpButton) then
            self.costUpButton:DisconnectEvent(ButtonClickEvent, self.costUpHandler)
        end
        self.costUpHandler = nil
    end

end
