@Component
script Commander extends Component

    property number ScrollSpeed = 8
    -- Lobby: name of the map entity the fixed view is centred on (optional; see HoldLobbyView).
    property string LobbyCameraName = "LobbyCamera"
    @HideFromInspector property number CamX = -16.8
    -- What waits for a click on the battlefield: 0 = nothing, 1..HandSize = the card in that hand slot (a monster card
    -- waits for one of my portals, a build / skill card for a position), BaseSkillSlot + n = base skill n is being aimed.
    @HideFromInspector property integer PendingSlot = 0
    property integer BaseSkillSlot = 100

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Starts the commander view on the ally base side.
        if self.Entity ~= _UserService.LocalPlayer then return end
        self.CamX = 0
        self._T.camReady = false
        log("[Commander] client ready camX=" .. tostring(self.CamX))
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Scrolls the camera left/right along the battlefield with A/D or the arrow keys.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        ---@type BattleDirector
        local director = map:GetComponent("script.BattleDirector")
        if director == nil then
            self:HoldLobbyView(map)
            return
        end
        if director.AllyBaseX == director.EnemyBaseX then return end
        -- This map's zoom (BattleDirector.CameraZoom, percent): a lower zoom shows a wider part of the field.
        local zoom = math.max(30, math.min(500, director.CameraZoom))
        local camera = self.Entity.CameraComponent
        if isvalid(camera) and math.abs(camera.ZoomRatio - zoom) > 0.01 then
            camera.ZoomRatio = zoom
            self._T.camReady = false
            log("[Commander] camera zoom " .. tostring(zoom) .. "% offsetY=" .. tostring(director.CameraOffsetY))
        end
        -- Camera range: keep both towers inside the screen. If the whole field fits, min == max and the view is fixed.
        local reach = _BattleConfig.ScreenHalfWidth * 100 / zoom - _BattleConfig.FieldMargin
        local center = (director.AllyBaseX + director.EnemyBaseX) * 0.5
        local camMin = math.min(center, director.AllyBaseX + reach)
        local camMax = math.max(center, director.EnemyBaseX - reach)
        local useStart = director.CameraUseStart
        self:SetCenterMode(useStart)
        if self._T.camReady ~= true then
            self._T.camReady = true
            self.CamX = camMin
            if useStart then
                self.CamX = math.max(camMin, math.min(camMax, director.CameraStart.x))
            end
            log("[Commander] camera range " .. string.format("%.2f", camMin) .. " ~ " .. string.format("%.2f", camMax))
        end
        local move = 0
        if _InputService:IsKeyPressed(KeyboardKey.A) or _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then move = move - 1 end
        if _InputService:IsKeyPressed(KeyboardKey.D) or _InputService:IsKeyPressed(KeyboardKey.RightArrow) then move = move + 1 end
        if move ~= 0 then
            local nextX = self.CamX + move * self.ScrollSpeed * delta
            self.CamX = math.max(camMin, math.min(camMax, nextX))
        end
        if isvalid(camera) then
            local here = self.Entity.TransformComponent.WorldPosition
            local offsetY = director.CameraOffsetY
            if useStart then
                offsetY = director.CameraStart.y - here.y
            end
            camera.CameraOffset = Vector2(self.CamX - here.x, offsetY)
        end
    end

    @ExecSpace("ClientOnly")
    method void SetCenterMode(boolean on)
        -- On: the point the camera is told to look at lands exactly on the centre of the screen (no map confinement,
        -- no screen offset, no dead zone), so a world position typed in Maker is what the player sees. Off: the camera
        -- settings the player model came with are put back.
        if self._T.centerMode == on then return end
        local camera = self.Entity.CameraComponent
        if not isvalid(camera) then return end
        self._T.centerMode = on
        if on then
            if self._T.camOrig == nil then
                self._T.camOrig = { confine = camera.ConfineCameraArea, screen = camera.ScreenOffset, dead = camera.DeadZone }
            end
            camera.ConfineCameraArea = false
            camera.ScreenOffset = Vector2(0.5, 0.5)
            camera.DeadZone = Vector2(0, 0)
        elseif self._T.camOrig ~= nil then
            camera.ConfineCameraArea = self._T.camOrig.confine
            camera.ScreenOffset = self._T.camOrig.screen
            camera.DeadZone = self._T.camOrig.dead
        end
    end

    @ExecSpace("ClientOnly")
    method void HoldLobbyView(Entity map)
        -- Lobby (a map without a battle): the view must not move. The player entity is invisible but still has a body, and
        -- the camera follows it, so a falling body drags the view down and back. Gravity is switched off and the body is
        -- stopped where it is; the view then stays put. A map entity named LobbyCameraName, when the map has one, is
        -- what the view is centred on (move it in Maker to frame the lobby).
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) and body.Gravity ~= 0 then
            body.Gravity = 0
            body:SetForce(Vector2(0, 0))
            body.MoveVelocity = Vector2(0, 0)
            log("[Commander] lobby view held: gravity off at y=" .. string.format("%.2f", self.Entity.TransformComponent.WorldPosition.y))
        end
        local camera = self.Entity.CameraComponent
        if not isvalid(camera) then return end
        -- Set on every lobby frame it differs, so the zoom of the battle map the player came from does not stay.
        -- Zoom and centre of this map come from its LobbyView component (map entity); without one the view is 100%.
        ---@type LobbyView
        local view = map:GetComponent("script.LobbyView")
        local zoom = 100
        if view ~= nil then zoom = math.max(30, math.min(500, view.CameraZoom)) end
        if math.abs(camera.ZoomRatio - zoom) > 0.01 then
            camera.ZoomRatio = zoom
            log("[Commander] lobby camera zoom " .. tostring(zoom) .. "%")
        end
        -- The next battle map starts its view from its own start position again.
        self._T.camReady = false
        local offset = Vector2(0, 0)
        local here = self.Entity.TransformComponent.WorldPosition
        local marker = map:GetChildByName(self.LobbyCameraName)
        if isvalid(marker) then
            local to = marker.TransformComponent.WorldPosition
            offset = Vector2(to.x - here.x, to.y - here.y)
            self:SetCenterMode(true)
        elseif view ~= nil and view.CameraUseStart then
            offset = Vector2(view.CameraStart.x - here.x, view.CameraStart.y - here.y)
            self:SetCenterMode(true)
        else
            self:SetCenterMode(false)
        end
        camera.CameraOffset = offset
    end

    @ExecSpace("ClientOnly")
    method any GetSideOf(boolean mine)
        -- Client: returns the BattleSide this player controls (mine = true) or the opposing one (mine = false).
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return nil end
        local userId = self.Entity.PlayerComponent.UserId
        local found = nil
        for _, name in ipairs({ "AllyBase", "EnemyBase" }) do
            local base = map:GetChildByName(name)
            if isvalid(base) then
                ---@type BattleSide
                local side = base:GetComponent("script.BattleSide")
                if side ~= nil and (side.ControllerUserId == userId) == mine then found = side end
            end
        end
        return found
    end

    @ExecSpace("ClientOnly")
    method any GetMySide()
        -- Client: returns the BattleSide this player controls, or nil outside a battle.
        return self:GetSideOf(true)
    end

    @ExecSpace("ClientOnly")
    method any GetBattleDirector()
        -- Client: returns the BattleDirector of the map this player is on, or nil outside a battle.
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return nil end
        return map:GetComponent("script.BattleDirector")
    end

    @ExecSpace("ClientOnly")
    method void SelectSlot(integer slot)
        -- Selects the card in a hand slot. A monster card then waits for a click on one of my portals (it is played at
        -- once when my side has a single portal); build and skill cards wait for a battlefield position. Selecting the
        -- waiting slot again cancels.
        ---@type BattleSide
        local side = self:GetMySide()
        if side == nil then return end
        local unitId = side:GetHandIds()[slot]
        if unitId == nil or unitId == "" then return end
        local cfg = _BattleConfig:GetUnit(unitId)
        if cfg == nil then return end
        if cfg.kind == "monster" then
            ---@type BattleDirector
            local director = self:GetBattleDirector()
            local portals = {}
            if director ~= nil then portals = director:GetPortals(side.Team) end
            if #portals <= 1 then
                self.PendingSlot = 0
                self:RequestUseCard(slot, unitId, 0, 0, 1)
                return
            end
        end
        if self.PendingSlot == slot then
            self.PendingSlot = 0
            return
        end
        self.PendingSlot = slot
        self._T.pendingUnit = unitId
        log("[Commander] targeting slot=" .. tostring(slot) .. " " .. unitId .. " kind=" .. cfg.kind)
    end

    @ExecSpace("ClientOnly")
    method void SelectBaseSkill(integer index)
        -- Starts aiming the base skill in a slot (a free skill card with a cooldown); pressing it again cancels. The
        -- touch that follows picks the position, like a skill card from the hand.
        ---@type BattleSide
        local side = self:GetMySide()
        if side == nil then return end
        local skill = side:GetBaseSkills()[index]
        if skill == nil or skill.type ~= "active" then return end
        local pending = self.BaseSkillSlot + index
        if self.PendingSlot == pending then
            self.PendingSlot = 0
            return
        end
        if _UtilLogic.ServerElapsedSeconds < skill.readyAt then return end
        self.PendingSlot = pending
        self._T.pendingUnit = skill.id
        log("[Commander] targeting base skill " .. tostring(index) .. " " .. skill.id)
    end

    @ExecSpace("ClientOnly")
    method any GetPendingUnit()
        -- Client: returns the unit definition of what is waiting for a battlefield click (a hand card or a base skill), or nil.
        local slot = self.PendingSlot
        if slot == 0 then return nil end
        ---@type BattleSide
        local side = self:GetMySide()
        if side == nil then return nil end
        local unitId = ""
        if slot > self.BaseSkillSlot then
            local skill = side:GetBaseSkills()[slot - self.BaseSkillSlot]
            if skill ~= nil then unitId = skill.id end
        else
            unitId = side:GetHandIds()[slot] or ""
        end
        if unitId == "" then return nil end
        return _BattleConfig:GetUnit(unitId)
    end

    @ExecSpace("ClientOnly")
    method integer PickPortal(Vector2 world)
        -- Returns the index of my portal a battlefield click at world picks (the nearest one within
        -- BattleConfig.PortalPickRadius), or 0 when the click is not on a portal.
        ---@type BattleSide
        local side = self:GetMySide()
        ---@type BattleDirector
        local director = self:GetBattleDirector()
        if side == nil or director == nil then return 0 end
        local best = 0
        local bestDist = _BattleConfig.PortalPickRadius
        for _, portal in ipairs(director:GetPortals(side.Team)) do
            local dx = portal.x - world.x
            local dy = portal.y - world.y
            local dist = math.sqrt(dx * dx + dy * dy)
            if dist <= bestDist then
                best = portal.index
                bestDist = dist
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- Number keys 1~5 select hand slots, Esc cancels targeting.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local key = event.key
        local slotKeys = { KeyboardKey.Alpha1, KeyboardKey.Alpha2, KeyboardKey.Alpha3, KeyboardKey.Alpha4, KeyboardKey.Alpha5 }
        for slot, slotKey in ipairs(slotKeys) do
            if slot <= _BattleConfig.HandSize and key == slotKey then
                self:SelectSlot(slot)
                return
            end
        end
        if key == KeyboardKey.Escape then
            self.PendingSlot = 0
        end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleScreenTouchEvent(ScreenTouchEvent event)
        -- While something waits for a target, a battlefield touch (not on UI) gives it: a monster card takes the portal
        -- that was clicked (a click elsewhere keeps waiting), a build / skill card and a base skill take the position.
        if self.Entity ~= _UserService.LocalPlayer then return end
        if self.PendingSlot == 0 then return end
        if _InputService:IsPointerOverUI() then return end
        local world = _UILogic:ScreenToWorldPosition(event.TouchPoint)
        local slot = self.PendingSlot
        if slot > self.BaseSkillSlot then
            self.PendingSlot = 0
            self:RequestUseBaseSkill(slot - self.BaseSkillSlot, world.x, world.y)
            return
        end
        local unitId = self._T.pendingUnit or ""
        local cfg = _BattleConfig:GetUnit(unitId)
        if cfg ~= nil and cfg.kind == "monster" then
            local portalIndex = self:PickPortal(world)
            if portalIndex == 0 then return end
            self.PendingSlot = 0
            self:RequestUseCard(slot, unitId, 0, 0, portalIndex)
            return
        end
        self.PendingSlot = 0
        self:RequestUseCard(slot, unitId, world.x, world.y, 0)
    end

    @ExecSpace("Server")
    method void RequestUseBaseSkill(integer index, number targetX, number targetY)
        -- Asks the battle director to use this player's active base skill in a slot at the target (the cooldown is checked there).
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        if director == nil then return end
        ---@type BattleSide
        local side = director:GetSideByUser(senderUserId)
        if side == nil then return end
        director:UseBaseSkill(side.Team, index, targetX, targetY)
    end

    @ExecSpace("Server")
    method void RequestUpgradeCost()
        -- Asks the battle director to raise this player's in-battle cost level.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        if director == nil then return end
        ---@type BattleSide
        local side = director:GetSideByUser(senderUserId)
        if side == nil then return end
        director:UpgradeCostLevel(side.Team)
    end

    @ExecSpace("Server")
    method void RequestUseCard(integer slot, string unitId, number targetX, number targetY, integer portalIndex)
        -- Asks the battle director to play the card the client saw in a hand slot and reports the result back.
        -- portalIndex = the portal a monster card comes out of; (targetX, targetY) = where a build / skill card goes.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        if director == nil then return end
        ---@type BattleSide
        local side = director:GetSideByUser(senderUserId)
        if side == nil then return end
        if director:UseCard(side.Team, slot, unitId, targetX, targetY, portalIndex) then
            self:OnCardUsed(slot, unitId, targetX, director:SnapFloorY(targetX, targetY), senderUserId)
        end
    end

    @ExecSpace("Server")
    method void RequestEnterBattle(string stageId)
        -- Lobby only: asks for a private battle instance of the given stage.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local userId = senderUserId
        -- One entry at a time: the steps below wait for storage, and a second click must not pay twice.
        if self._T.entering == true then return end
        -- Server-side entry check: the stage must exist, its unlock stage must already be cleared,
        -- and the player must hold the stage's entry cost.
        local stage = _BattleConfig:GetStage(stageId)
        if stage == nil then
            self:RefuseEnter("unknown stage " .. stageId, userId)
            return
        end
        ---@type PlayerData
        local data = self.Entity:GetComponent("script.PlayerData")
        if data == nil or data.Loaded == false then
            self:RefuseEnter("player data not loaded", userId)
            return
        end
        if stage.unlockStage ~= "" and data:IsStageCleared(stage.unlockStage) == false then
            self:RefuseEnter(stageId .. " is locked (needs " .. stage.unlockStage .. ")", userId)
            return
        end
        local currencyId = _BattleConfig.EntryCurrencyId
        local cost = math.floor(stage.entryCost)
        self._T.entering = true
        if cost > 0 then
            if data:SpendCurrency(currencyId, cost) == false then
                self._T.entering = false
                self:RefuseEnter("not enough " .. currencyId .. " (needs " .. tostring(cost) .. ", has " .. tostring(data:GetCurrencyAmount(currencyId)) .. ")", userId)
                return
            end
            -- The battle room reads storage again, so the spend must be stored before the move.
            if data:SaveNow() == false then
                data:AddCurrency(currencyId, cost)
                self._T.entering = false
                self:RefuseEnter("save failed, entry cost returned", userId)
                return
            end
        end
        if _MatchService:EnterBattle(userId, stageId) == false then
            -- The player was not moved: give the entry cost back.
            if cost > 0 then
                data:AddCurrency(currencyId, cost)
                data:Save(false)
            end
            self._T.entering = false
            self:RefuseEnter("battle room failed, entry cost returned", userId)
        end
    end

    @ExecSpace("ServerOnly")
    method void RefuseEnter(string reason, string userId)
        -- Logs a refused entry and tells the requesting client so it can drop its loading screen.
        log("[Commander] enter refused: " .. reason .. " user=" .. userId)
        self:OnEnterRefused(reason, userId)
    end

    @ExecSpace("Client")
    method void OnEnterRefused(string reason)
        -- Client: the server did not start the battle; hide the loading screen shown at the click.
        _LoadingLogic:Cancel()
        log("[Commander] enter refused by server: " .. reason)
    end

    @ExecSpace("Server")
    method void RequestLeaveBattle()
        -- Battle only: returns this player to the lobby.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        _MatchService:LeaveBattle(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestBattleReady()
        -- Battle only: this client has loaded the battle resources; the director may start.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        if director == nil then return end
        director:SetPlayerReady(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestRestart()
        -- Restarts the battle once it has ended. A restart is another entry, so it pays the stage's entry cost.
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        ---@type BattleDirector
        local director = self:GetDirector()
        if director == nil then return end
        if director:GetSideByUser(senderUserId) == nil then return end
        if director.State ~= "ENDED" then return end
        local stage = _BattleConfig:GetStage(director.StageId)
        local cost = 0
        if stage ~= nil then cost = math.floor(stage.entryCost) end
        if cost > 0 then
            local currencyId = _BattleConfig.EntryCurrencyId
            ---@type PlayerData
            local data = self.Entity:GetComponent("script.PlayerData")
            if data == nil or data:SpendCurrency(currencyId, cost) == false then
                log("[Commander] restart refused: not enough " .. currencyId .. " (needs " .. tostring(cost) .. ") user=" .. senderUserId)
                return
            end
            data:Save(false)
        end
        director:Restart()
    end

    @ExecSpace("ServerOnly")
    method any GetDirector()
        -- Returns the BattleDirector of the player's current map.
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return nil end
        local director = map:GetComponent("script.BattleDirector")
        if director == nil then log_error("[Commander] BattleDirector not found on map") end
        return director
    end

    @ExecSpace("Client")
    method void OnCardUsed(integer slot, string unitId, number targetX, number floorY)
        -- Client-side presentation for a played card: the card sound and the skill effect.
        -- (The hand refill itself arrives through the synced BattleSide.HandCsv.)
        local cfg = _BattleConfig:GetUnit(unitId)
        _BattleSound:Play("card")
        if cfg ~= nil and cfg.kind == "skill" then
            -- The effect is placed over the actual damage area by FieldFx.
            _FieldFx:PlaySkillEffect(cfg, targetX, floorY)
        end
        log("[Commander] card used slot=" .. tostring(slot) .. " " .. unitId)
    end

end
