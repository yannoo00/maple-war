@Component
script BattleSide extends Component

    -- One side of a battle. Lives on that side's base entity next to its BattleUnit.
    -- Holds everything a controller (a player or a stage AI) plays with: deck, card cooldowns and cost.
    -- The whole deck (up to BattleConfig.DeckSize monster / build cards) is in play from the start, one slot per card:
    -- no hand, no queue. Playing a card starts that card's own cooldown (UnitTable Cooldown).
    @Sync property integer Team = 0
    @Sync property string ControllerUserId = ""
    @Sync property string DeckCsv = ""
    -- Per deck slot, the _UtilLogic.ServerElapsedSeconds at which its card can be played again ("0.00,12.50,...";
    -- 0 = ready). Read it with GetCardReadyTimes.
    @Sync property string CardReadyCsv = ""
    @Sync property number Cost = 0
    @Sync property number CostMax = 0
    -- In-battle cost level: starts at 1 every battle, raised by paying cost, up to the player's unlocked cap.
    @Sync property integer CostLevel = 1
    @Sync property integer CostLevelCap = 1
    -- Mana it costs now to raise the in-battle level (the level's price minus the base's upgrade discount); 0 = no next level.
    @Sync property number UpgradeCost = 0
    -- The base this side plays (UnitTable id, Kind = base) and its skills, up to MaxBaseSkills, in slot order:
    -- "id:type:cooldown:readyAt;..." where type is active / passive, cooldown is in seconds and readyAt is the
    -- _UtilLogic.ServerElapsedSeconds at which that skill can be used next. Read it with GetBaseSkills.
    @Sync property string BaseId = ""
    @Sync property string BaseSkillsCsv = ""
    property integer MaxBaseSkills = 3
    property boolean FreePlay = false

    method table GetDeckIds()
        -- Returns the deck as an array of unit ids (slot order). Usable on server and client.
        local ids = {}
        for id in string.gmatch(self.DeckCsv, "[^,]+") do table.insert(ids, id) end
        return ids
    end

    method table GetCardReadyTimes()
        -- Returns, per deck slot, the server time at which its card can be played again (0 = ready). Usable on server
        -- and client; parsed again only when the synced text changed.
        local csv = self.CardReadyCsv
        if self._T.readyCsv == csv and self._T.readyTimes ~= nil then return self._T.readyTimes end
        local times = {}
        for value in string.gmatch(csv, "[^,]+") do table.insert(times, tonumber(value) or 0) end
        self._T.readyCsv = csv
        self._T.readyTimes = times
        return times
    end

    method number GetCardCooldownLeft(integer slot)
        -- Returns the seconds left before the card in a deck slot can be played again (0 = ready). Server and client.
        local readyAt = self:GetCardReadyTimes()[slot] or 0
        return math.max(0, readyAt - _UtilLogic.ServerElapsedSeconds)
    end

    @ExecSpace("ServerOnly")
    method void StartCardCooldown(integer slot, table cfg)
        -- The card in this deck slot was played: its cooldown (the unit's Cooldown seconds) starts now.
        if self.FreePlay or cfg.cooldown <= 0 then return end
        local times = self:GetCardReadyTimes()
        if times[slot] == nil then return end
        times[slot] = _UtilLogic.ServerElapsedSeconds + cfg.cooldown
        local parts = {}
        for _, readyAt in ipairs(times) do table.insert(parts, string.format("%.2f", readyAt)) end
        self.CardReadyCsv = table.concat(parts, ",")
        log("[BattleSide] team " .. tostring(self.Team) .. " slot " .. tostring(slot) .. " " .. cfg.id .. " cooldown " .. tostring(cfg.cooldown) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void Reset(integer team, table deckIds, table unitLevels, string controllerUserId, boolean freePlay, integer costLevelCap, table baseCfg)
        -- Prepares the side for a new battle. unitLevels maps unit id -> level for the deck's units;
        -- costLevelCap is the highest in-battle cost level this side may reach. baseCfg is the side's base
        -- (BattleConfig:GetBaseAtLevel): its starting mana, mana max / income multipliers, upgrade discount and skill.
        self.Team = team
        self.ControllerUserId = controllerUserId
        self.FreePlay = freePlay
        -- Only cards go into play: an id that is not a monster / build (a skill left in an old save) is dropped, and
        -- the deck never exceeds DeckSize.
        local deck = {}
        for _, id in ipairs(deckIds) do
            local unit = _BattleConfig:GetUnit(id)
            if unit ~= nil and _BattleConfig:IsCardKind(unit.kind) and #deck < _BattleConfig.DeckSize then table.insert(deck, id) end
        end
        self.DeckCsv = table.concat(deck, ",")
        -- Every card starts ready.
        local ready = {}
        for i = 1, #deck do ready[i] = "0.00" end
        self.CardReadyCsv = table.concat(ready, ",")
        self.Cost =baseCfg.manaStart or _BattleConfig.CostStart
        local costLevels = _BattleConfig:GetCostLevels()
        self.CostLevel = 1
        self.CostLevelCap = math.max(1, math.min(#costLevels, costLevelCap))
        self._T.maxRate = baseCfg.manaMaxRate or 1
        self._T.regenMul = baseCfg.manaRegenRate or 1
        self._T.discount = baseCfg.manaDiscount or 0
        self.CostMax = costLevels[1].costMax * self._T.maxRate
        self._T.regenRate = costLevels[1].regenRate * self._T.regenMul
        self.UpgradeCost = math.floor(costLevels[1].upgradeCost * (1 - self._T.discount))
        self:InitBaseSkills(baseCfg)
        self._T.levels = unitLevels
        log("[BattleSide] reset team=" .. tostring(team) .. " controller=" .. (controllerUserId ~= "" and controllerUserId or "AI") .. " deck=" .. self.DeckCsv .. " cards=" .. tostring(#deck))
    end

    method table GetBaseSkills()
        -- Returns the base's skills in slot order as an array of { index, id, type, cooldown, readyAt }. Usable on server
        -- and client; parsed again only when the synced text changed.
        local csv = self.BaseSkillsCsv
        if self._T.skillsCsv == csv and self._T.skills ~= nil then return self._T.skills end
        local skills = {}
        for id, kind, cooldown, readyAt in string.gmatch(csv, "([^:;]+):([^:;]+):([^:;]+):([^:;]+)") do
            table.insert(skills, { index = #skills + 1, id = id, type = kind, cooldown = tonumber(cooldown) or 0, readyAt = tonumber(readyAt) or 0 })
        end
        self._T.skillsCsv = csv
        self._T.skills = skills
        return skills
    end

    @ExecSpace("ServerOnly")
    method void PublishBaseSkills(table skills)
        -- Writes the base skills to their synced text.
        local parts = {}
        for _, skill in ipairs(skills) do
            table.insert(parts, skill.id .. ":" .. skill.type .. ":" .. string.format("%.2f", skill.cooldown) .. ":" .. string.format("%.2f", skill.readyAt))
        end
        self.BaseSkillsCsv = table.concat(parts, ";")
    end

    @ExecSpace("ServerOnly")
    method void InitBaseSkills(table baseCfg)
        -- Loads the base's skills (its BaseSkill / BaseSkill2 / BaseSkill3 cells). An id that is not a skill unit is
        -- ignored. Every cooldown starts at the beginning of the battle, so a skill can first be used one full cooldown in.
        self.BaseId = baseCfg.id
        local now = _UtilLogic.ServerElapsedSeconds
        local skills = {}
        for _, def in ipairs(baseCfg.baseSkills or {}) do
            local skill = _BattleConfig:GetUnit(def.id)
            if skill == nil or skill.kind ~= "skill" then
                log_warning("[BattleSide] base " .. baseCfg.id .. " skill " .. tostring(def.id) .. " is not a skill unit, ignored")
            elseif #skills < self.MaxBaseSkills then
                local kind = def.type
                if kind ~= "passive" then kind = "active" end
                table.insert(skills, { id = skill.id, type = kind, cooldown = def.cooldown, readyAt = now + def.cooldown })
            end
        end
        self:PublishBaseSkills(skills)
        log("[BattleSide] team=" .. tostring(self.Team) .. " base=" .. baseCfg.id .. " skills=" .. self.BaseSkillsCsv)
    end

    @ExecSpace("ServerOnly")
    method boolean IsBaseSkillReady(integer index)
        -- True when the base has a skill in that slot and its cooldown is over.
        local skill = self:GetBaseSkills()[index]
        return skill ~= nil and _UtilLogic.ServerElapsedSeconds >= skill.readyAt
    end

    @ExecSpace("ServerOnly")
    method void StartBaseSkillCooldown(integer index)
        -- Starts the cooldown of the base skill in a slot after it was used.
        local skills = self:GetBaseSkills()
        local skill = skills[index]
        if skill == nil then return end
        skill.readyAt = _UtilLogic.ServerElapsedSeconds + skill.cooldown
        self:PublishBaseSkills(skills)
    end

    @ExecSpace("ServerOnly")
    method integer GetUnitLevel(string unitId)
        -- Returns the level this side plays the unit at (1 when unknown).
        local levels = self._T.levels
        if levels == nil or levels[unitId] == nil then return 1 end
        return levels[unitId]
    end

    @ExecSpace("ServerOnly")
    method void Tick(number delta)
        -- Cost income, driven by the director's clock.
        self.Cost = math.min(self.CostMax, self.Cost + _BattleConfig.CostPerSecond * (self._T.regenRate or 1) * delta)
    end

    @ExecSpace("ServerOnly")
    method string UpgradeCostLevel()
        -- Pays cost to raise the in-battle cost level by one (bigger cap, faster income).
        -- Returns "" on success or the reason it was refused.
        local costLevels = _BattleConfig:GetCostLevels()
        local current = costLevels[self.CostLevel]
        local nextLevel = costLevels[self.CostLevel + 1]
        if current == nil or nextLevel == nil then return "max level" end
        if self.CostLevel >= self.CostLevelCap then return "cap " .. tostring(self.CostLevelCap) end
        local price = math.floor(current.upgradeCost * (1 - (self._T.discount or 0)))
        if self.Cost < price then return "cost " .. string.format("%.0f", self.Cost) .. "/" .. tostring(price) end
        self.Cost = self.Cost - price
        self.CostLevel = self.CostLevel + 1
        self.CostMax = nextLevel.costMax * (self._T.maxRate or 1)
        self._T.regenRate = nextLevel.regenRate * (self._T.regenMul or 1)
        local following = costLevels[self.CostLevel]
        self.UpgradeCost = following ~= nil and math.floor(following.upgradeCost * (1 - (self._T.discount or 0))) or 0
        return ""
    end

    @ExecSpace("ServerOnly")
    method string CheckCard(integer slot, table cfg)
        -- Returns "" when the card in a deck slot may be played now (its cooldown is over and its cost is affordable),
        -- otherwise the reason it is rejected.
        if self.FreePlay then return "" end
        local left = self:GetCardCooldownLeft(slot)
        if left > 0 then return "cooldown " .. string.format("%.1f", left) .. "s" end
        if self.Cost < cfg.cost then return "cost " .. string.format("%.0f", self.Cost) .. "/" .. tostring(cfg.cost) end
        return ""
    end

    @ExecSpace("ServerOnly")
    method void PayCard(table cfg)
        -- Charges the card's cost.
        if self.FreePlay then return end
        self.Cost = self.Cost - cfg.cost
    end

end
