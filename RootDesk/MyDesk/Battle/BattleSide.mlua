@Component
script BattleSide extends Component

    -- One side of a battle. Lives on that side's base entity next to its BattleUnit.
    -- Holds everything a controller (a player or a stage AI) plays with: deck, hand, card queue and cost.
    -- Card cycle: at Reset the deck is shuffled into a queue and the front HandSize cards form the hand. Playing a
    -- hand card pushes it to the back of the queue and the queue's front card takes the same hand slot.
    @Sync property integer Team = 0
    @Sync property string ControllerUserId = ""
    @Sync property string DeckCsv = ""
    -- Hand cards in slot order ("" = empty slot when the deck is smaller than the hand) and the next queued card.
    @Sync property string HandCsv = ""
    @Sync property string NextCardId = ""
    @Sync property number Cost = 0
    @Sync property number CostMax = 0
    -- In-battle cost level: starts at 1 every battle, raised by paying cost, up to the player's unlocked cap.
    @Sync property integer CostLevel = 1
    @Sync property integer CostLevelCap = 1
    -- Mana it costs now to raise the in-battle level (the level's price minus the base's upgrade discount); 0 = no next level.
    @Sync property number UpgradeCost = 0
    -- The base this side plays (UnitTable id, Kind = base) and its skill: skill unit id ("" = none), type (active / passive),
    -- cooldown seconds and the _UtilLogic.ServerElapsedSeconds at which it can be used next.
    @Sync property string BaseId = ""
    @Sync property string BaseSkillId = ""
    @Sync property string BaseSkillType = ""
    @Sync property number BaseSkillCooldown = 0
    @Sync property number BaseSkillReadyAt = 0
    property boolean FreePlay = false

    method table GetDeckIds()
        -- Returns the deck as an array of unit ids (slot order). Usable on server and client.
        local ids = {}
        for id in string.gmatch(self.DeckCsv, "[^,]+") do table.insert(ids, id) end
        return ids
    end

    method table GetHandIds()
        -- Returns the hand as an array of HandSize unit ids in slot order ("" for an empty slot). Server and client.
        local ids = {}
        local start = 1
        local csv = self.HandCsv
        if csv == "" then return ids end
        while true do
            local comma, commaEnd = string.find(csv, ",", start, true)
            if comma == nil then
                table.insert(ids, string.sub(csv, start))
                break
            end
            table.insert(ids, string.sub(csv, start, comma - 1))
            start = comma + 1
        end
        return ids
    end

    @ExecSpace("ServerOnly")
    method void PublishHand(table hand)
        -- Writes the hand and the next queued card to their synced properties.
        self.HandCsv = table.concat(hand, ",")
        local queue = self._T.queue or {}
        self.NextCardId = queue[1] or ""
    end

    @ExecSpace("ServerOnly")
    method void Reset(integer team, table deckIds, table unitLevels, string controllerUserId, boolean freePlay, integer costLevelCap, table baseCfg)
        -- Prepares the side for a new battle. unitLevels maps unit id -> level for the deck's units;
        -- costLevelCap is the highest in-battle cost level this side may reach. baseCfg is the side's base
        -- (BattleConfig:GetBaseAtLevel): its starting mana, mana max / income multipliers, upgrade discount and skill.
        self.Team = team
        self.ControllerUserId = controllerUserId
        self.FreePlay = freePlay
        self.DeckCsv = table.concat(deckIds, ",")
        self.Cost = baseCfg.manaStart or _BattleConfig.CostStart
        local costLevels = _BattleConfig:GetCostLevels()
        self.CostLevel = 1
        self.CostLevelCap = math.max(1, math.min(#costLevels, costLevelCap))
        self._T.maxRate = baseCfg.manaMaxRate or 1
        self._T.regenMul = baseCfg.manaRegenRate or 1
        self._T.discount = baseCfg.manaDiscount or 0
        self.CostMax = costLevels[1].costMax * self._T.maxRate
        self._T.regenRate = costLevels[1].regenRate * self._T.regenMul
        self.UpgradeCost = math.floor(costLevels[1].upgradeCost * (1 - self._T.discount))
        self:InitBaseSkill(baseCfg)
        self._T.levels = unitLevels
        -- Shuffle the deck into the card queue, then deal the front cards into the hand.
        local queue = {}
        for _, id in ipairs(deckIds) do table.insert(queue, id) end
        for i = #queue, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            queue[i], queue[j] = queue[j], queue[i]
        end
        local hand = {}
        for i = 1, _BattleConfig.HandSize do
            if #queue > 0 then
                hand[i] = table.remove(queue, 1)
            else
                hand[i] = ""
            end
        end
        self._T.queue = queue
        self:PublishHand(hand)
        log("[BattleSide] reset team=" .. tostring(team) .. " controller=" .. (controllerUserId ~= "" and controllerUserId or "AI") .. " deck=" .. self.DeckCsv .. " hand=" .. self.HandCsv .. " queue=" .. table.concat(queue, ","))
    end

    @ExecSpace("ServerOnly")
    method void InitBaseSkill(table baseCfg)
        -- Loads the base's skill. A skill id that is not a skill unit is ignored. The cooldown starts at the beginning
        -- of the battle, so the skill can first be used one full cooldown in.
        self.BaseId = baseCfg.id
        local skill = nil
        if baseCfg.baseSkill ~= nil and baseCfg.baseSkill ~= "" then skill = _BattleConfig:GetUnit(baseCfg.baseSkill) end
        if skill == nil or skill.kind ~= "skill" then
            if baseCfg.baseSkill ~= nil and baseCfg.baseSkill ~= "" then
                log_warning("[BattleSide] base " .. baseCfg.id .. " skill " .. baseCfg.baseSkill .. " is not a skill unit, ignored")
            end
            self.BaseSkillId = ""
            self.BaseSkillType = ""
            self.BaseSkillCooldown = 0
            self.BaseSkillReadyAt = 0
            return
        end
        self.BaseSkillId = skill.id
        self.BaseSkillType = baseCfg.baseSkillType
        self.BaseSkillCooldown = baseCfg.baseSkillCooldown
        self.BaseSkillReadyAt = _UtilLogic.ServerElapsedSeconds + baseCfg.baseSkillCooldown
        log("[VRF] BattleSide team=" .. tostring(self.Team) .. " base=" .. baseCfg.id .. " skill=" .. skill.id .. " type=" .. baseCfg.baseSkillType .. " cooldown=" .. tostring(baseCfg.baseSkillCooldown))
    end

    @ExecSpace("ServerOnly")
    method boolean IsBaseSkillReady()
        -- True when the base has a skill and its cooldown is over.
        return self.BaseSkillId ~= "" and _UtilLogic.ServerElapsedSeconds >= self.BaseSkillReadyAt
    end

    @ExecSpace("ServerOnly")
    method void StartBaseSkillCooldown()
        -- Starts the base skill's cooldown after it was used.
        self.BaseSkillReadyAt = _UtilLogic.ServerElapsedSeconds + self.BaseSkillCooldown
    end

    @ExecSpace("ServerOnly")
    method integer GetUnitLevel(string unitId)
        -- Returns the level this side plays the unit at (1 when unknown).
        local levels = self._T.levels
        if levels == nil or levels[unitId] == nil then return 1 end
        return levels[unitId]
    end

    @ExecSpace("ServerOnly")
    method void Tick(number delta)
        -- Cost income, driven by the director's clock.
        self.Cost = math.min(self.CostMax, self.Cost + _BattleConfig.CostPerSecond * (self._T.regenRate or 1) * delta)
    end

    @ExecSpace("ServerOnly")
    method string UpgradeCostLevel()
        -- Pays cost to raise the in-battle cost level by one (bigger cap, faster income).
        -- Returns "" on success or the reason it was refused.
        local costLevels = _BattleConfig:GetCostLevels()
        local current = costLevels[self.CostLevel]
        local nextLevel = costLevels[self.CostLevel + 1]
        if current == nil or nextLevel == nil then return "max level" end
        if self.CostLevel >= self.CostLevelCap then return "cap " .. tostring(self.CostLevelCap) end
        local price = math.floor(current.upgradeCost * (1 - (self._T.discount or 0)))
        if self.Cost < price then return "cost " .. string.format("%.0f", self.Cost) .. "/" .. tostring(price) end
        self.Cost = self.Cost - price
        self.CostLevel = self.CostLevel + 1
        self.CostMax = nextLevel.costMax * (self._T.maxRate or 1)
        self._T.regenRate = nextLevel.regenRate * (self._T.regenMul or 1)
        local following = costLevels[self.CostLevel]
        self.UpgradeCost = following ~= nil and math.floor(following.upgradeCost * (1 - (self._T.discount or 0))) or 0
        return ""
    end

    @ExecSpace("ServerOnly")
    method string CheckCard(table cfg)
        -- Returns "" when the card may be played now (its cost is affordable), otherwise the reason it is rejected.
        if self.FreePlay then return "" end
        if self.Cost < cfg.cost then return "cost " .. string.format("%.0f", self.Cost) .. "/" .. tostring(cfg.cost) end
        return ""
    end

    @ExecSpace("ServerOnly")
    method void PayCard(table cfg)
        -- Charges the card's cost.
        if self.FreePlay then return end
        self.Cost = self.Cost - cfg.cost
    end

    @ExecSpace("ServerOnly")
    method void CycleCard(integer handIndex)
        -- The card in this hand slot was played: it goes to the back of the queue and the queue's front card takes
        -- the slot. With no other card waiting (deck no bigger than the hand) the same card comes straight back.
        local hand = self:GetHandIds()
        local played = hand[handIndex]
        if played == nil or played == "" then return end
        local queue = self._T.queue or {}
        table.insert(queue, played)
        hand[handIndex] = table.remove(queue, 1)
        self._T.queue = queue
        self:PublishHand(hand)
        log("[BattleSide] team " .. tostring(self.Team) .. " cycled slot " .. tostring(handIndex) .. ": " .. played .. " -> " .. hand[handIndex] .. " hand=" .. self.HandCsv .. " next=" .. self.NextCardId)
    end

end
