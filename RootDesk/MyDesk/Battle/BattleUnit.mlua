@Component
script BattleUnit extends Component

    @Sync property integer Team = 0
    @Sync property number MaxHp = 100
    @Sync property number Hp = 100
    @Sync property string UnitId = ""
    -- Effects currently shown on this unit, for the client icons: "type:endAt,..." (endAt in ServerElapsedSeconds).
    @Sync property string StatusCsv = ""
    property string Kind = "monster"
    property number AttackPower = 10
    -- melee / ranged hit one target; melee_area / ranged_area hit every enemy in range (UnitTable AttackType).
    property string AttackType = "melee"
    property boolean IsAreaAttack = false
    property number AttackRange = 0.7
    property number AttackInterval = 1.0
    property number AttackPlayRate = 1.0
    property number AttackPose = 0.35
    property number AttackHitDelay = 0
    property number MoveSpeed = 1.0
    property number GoalX = 0
    property string StandRUID = ""
    property string MoveRUID = ""
    property string AttackRUID = ""
    property string DieRUID = ""
    property string HitRUID = ""
    -- Monsters only (UnitTable): attribute, the effect this unit's attacks can apply, and knockback settings.
    property string Attribute = ""
    property string EffectId = ""
    -- HP lost per knockback (0 = never knocked back), push distance in world units and push time.
    property number KnockStep = 0
    property number KnockDistance = 0
    property number KnockSeconds = 0
    @HideFromInspector property integer KnockCount = 0
    @HideFromInspector property number KnockRemain = 0
    @HideFromInspector property number KnockSpeed = 0
    @HideFromInspector property number KnockStartX = 0
    @HideFromInspector property number KnockTarget = 0
    @HideFromInspector property number WalkSpeed = 0
    -- Effects received: cursed = this unit's own effect is off; nullify = its attacks do nothing to NullifyTarget.
    @HideFromInspector property number CurseRemain = 0
    @HideFromInspector property number NullifyRemain = 0
    @HideFromInspector property any NullifyTarget = nil

    @HideFromInspector property boolean Ready = false
    @HideFromInspector property boolean IsDead = false
    @HideFromInspector property string Mode = ""
    @HideFromInspector property number AttackTimer = 0
    @HideFromInspector property number PoseTimer = 0
    @HideFromInspector property number HitTimer = 0
    @HideFromInspector property any PendingTarget = nil
    @HideFromInspector property any Director = nil
    @HideFromInspector property boolean HasProjectile = false

    @ExecSpace("ServerOnly")
    method void Setup(integer team, string unitId, table cfg, any director, number goalX)
        -- Applies a unit definition (monster / build / base) and starts its battle behavior.
        self.Team = team
        self.UnitId = unitId
        self.Kind = cfg.kind
        self.MaxHp = cfg.maxHp
        self.Hp = cfg.maxHp
        self.AttackPower = cfg.attack
        self.AttackType = cfg.attackType or ""
        self.IsAreaAttack = cfg.areaAttack == true
        self.AttackRange = cfg.range * _BattleConfig.RangeScale
        self.AttackInterval = cfg.attackInterval
        self.AttackPlayRate = cfg.attackPlayRate
        self.AttackPose = cfg.attackPose
        self.AttackHitDelay = cfg.attackHitDelay
        self.MoveSpeed = cfg.speed
        self.StandRUID = cfg.standRuid
        self.MoveRUID = cfg.moveRuid
        self.AttackRUID = cfg.attackRuid
        self.DieRUID = cfg.dieRuid
        self.HitRUID = cfg.hitRuid or ""
        self.Attribute = ""
        self.EffectId = ""
        self.KnockStep = 0
        if cfg.kind == "monster" then
            self.Attribute = cfg.attribute or ""
            self.EffectId = cfg.effectId or ""
            if cfg.knockbackHpPercent ~= nil and cfg.knockbackHpPercent > 0 then
                self.KnockStep = cfg.maxHp * cfg.knockbackHpPercent / 100
            end
            self.KnockDistance = (cfg.knockbackDistance or 0) * _BattleConfig.RangeScale
            self.KnockSeconds = cfg.knockbackSeconds or 0
        end
        self.KnockCount = 0
        self.KnockRemain = 0
        self.CurseRemain = 0
        self.NullifyRemain = 0
        self.NullifyTarget = nil
        self._T.statuses = {}
        self.StatusCsv = ""
        self.WalkSpeed = cfg.speed * _BattleConfig.SpeedScale
        self.GoalX = goalX
        self.Director = director
        self.HasProjectile = cfg.projectileRuid ~= nil
        self.IsDead = false
        self.PendingTarget = nil
        self.PoseTimer = 0
        self.Mode = ""

        local movement = self.Entity.MovementComponent
        if isvalid(movement) and cfg.speed > 0 then movement.InputSpeed = cfg.speed * _BattleConfig.SpeedScale end

        if cfg.kind ~= "base" then
            -- Sprites face left by default: allies (team 1) face right, so flip Scale.x negative.
            local dir = self:GetDirection()
            local size = cfg.scale * _BattleConfig.UnitScale
            self.Entity.TransformComponent.Scale = Vector3(-dir * size, size, 1)
        end

        self.Ready = true
        if cfg.speed > 0 then
            self:SetMode("MOVE")
        else
            self:SetMode("HOLD")
        end
        log("[BattleUnit] setup " .. self.Entity.Name .. " kind=" .. cfg.kind .. " team=" .. tostring(team) .. " hp=" .. tostring(self.Hp) .. " attackType=" .. self.AttackType .. " area=" .. tostring(self.IsAreaAttack) .. " attribute=" .. self.Attribute .. " effect=" .. self.EffectId .. " knockStep=" .. string.format("%.1f", self.KnockStep))
    end

    method integer GetDirection()
        -- Returns +1 for allies (advance right) and -1 for enemies (advance left).
        if self.Team == 1 then return 1 end
        return -1
    end

    @ExecSpace("ServerOnly")
    method void SetSprite(string ruid, number playRate)
        -- Swaps the playing clip and its play rate.
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) and ruid ~= "" then
            sprite.PlayRate = playRate
            sprite.SpriteRUID = ruid
        end
    end

    @ExecSpace("ServerOnly")
    method void StopMoving()
        -- Stops body movement when the unit has a movement component.
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then movement:Stop() end
    end

    @ExecSpace("ServerOnly")
    method void SetMode(string newMode)
        -- Switches behavior mode (MOVE / ATTACK / HOLD) and its clip.
        if self.Mode == newMode then return end
        self.Mode = newMode
        if newMode == "MOVE" then
            self:SetSprite(self.MoveRUID, 1)
        else
            self:StopMoving()
            self:SetSprite(self.StandRUID, 1)
            if newMode == "ATTACK" then self.AttackTimer = 0.3 end
        end
    end

    @ExecSpace("ServerOnly")
    method void Halt()
        -- Freezes the unit when the battle ends.
        self.Ready = false
        self.PendingTarget = nil
        self:StopMoving()
        if self.IsDead == false then self:SetSprite(self.StandRUID, 1) end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- Advances toward the enemy base, stopping to fight any enemy target in range.
        if self.Ready == false or self.IsDead then return end
        local director = self.Director
        if director == nil then return end

        if self.PoseTimer > 0 then
            self.PoseTimer = self.PoseTimer - delta
            if self.PoseTimer <= 0 and self.Mode ~= "MOVE" then self:SetSprite(self.StandRUID, 1) end
        end

        if self.StatusCsv ~= "" then self:RefreshStatus(false) end
        if self.CurseRemain > 0 then self.CurseRemain = self.CurseRemain - delta end
        if self.NullifyRemain > 0 then
            self.NullifyRemain = self.NullifyRemain - delta
            if self.NullifyRemain <= 0 then self.NullifyTarget = nil end
        end

        local x = self.Entity.TransformComponent.WorldPosition.x
        if self.KnockRemain > 0 then
            -- Knocked back (or held by an effect): no attacking or advancing until it ends.
            self.KnockRemain = self.KnockRemain - delta
            local back = -self:GetDirection()
            -- Never pushed behind its own base tower.
            local room = (x - director:GetBaseX(self.Team)) * -back
            -- The push itself is a physics impulse given in StartKnockback; here the unit only waits it out.
            -- A unit shoved against its own base tower is stopped there.
            if room <= 0.3 then
                local body = self.Entity.RigidbodyComponent
                if isvalid(body) then body:SetForce(Vector2(0, 0)) end
            end
            if self.KnockRemain <= 0 then self:EndKnockback() end
            return
        end

        if self.PendingTarget ~= nil then
            self.HitTimer = self.HitTimer - delta
            if self.HitTimer <= 0 then
                local pending = self.PendingTarget
                self.PendingTarget = nil
                self:ApplyHit(pending, x)
            end
        end

        if self.AttackPower <= 0 then return end

        local dir = self:GetDirection()
        local target = director:FindTarget(self.Team, x, self.AttackRange)
        if target ~= nil then
            self:SetMode("ATTACK")
            self.AttackTimer = self.AttackTimer - delta
            if self.AttackTimer <= 0 then
                self.AttackTimer = self.AttackInterval
                self.PoseTimer = self.AttackPose
                self:SetSprite(self.AttackRUID, self.AttackPlayRate)
                self.PendingTarget = target
                self.HitTimer = self.AttackHitDelay
                -- Every attack is announced: clients show the attack effect, play the attack sound and fly the projectile.
                self:NotifyAttack(target.Entity, self.AttackHitDelay)
            end
        elseif self.MoveSpeed <= 0 or (self.GoalX - x) * dir <= self.AttackRange then
            self:SetMode("HOLD")
        else
            self:SetMode("MOVE")
            self.Entity.MovementComponent:MoveToDirection(Vector2(dir, 0), delta)
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyHit(any aimed, number x)
        -- The attack lands. A single-target attack damages the target it was aimed at when the attack started;
        -- an area attack damages every enemy that is within attack range of this unit at this moment.
        if self.IsAreaAttack then
            local targets = self.Director:FindTargetsInRange(self.Team, x, self.AttackRange)
            for _, target in ipairs(targets) do self:DealDamage(target) end
            log("[BattleUnit] " .. self.Entity.Name .. " area hit (" .. self.AttackType .. ") targets=" .. tostring(#targets) .. " damage=" .. tostring(self.AttackPower))
            return
        end
        if aimed.IsDead == false and isvalid(aimed.Entity) then self:DealDamage(aimed) end
    end

    @ExecSpace("ServerOnly")
    method void DealDamage(any target)
        -- Damages one unit with this unit's attack, then rolls this unit's effect on it.
        if self.NullifyRemain > 0 and self.NullifyTarget == target then
            log("[BattleUnit] " .. self.Entity.Name .. " attack on " .. target.Entity.Name .. " nullified")
            return
        end
        target:TakeDamage(self.AttackPower)
        self:TryApplyEffect(target)
    end

    @ExecSpace("ServerOnly")
    method void TryApplyEffect(any target)
        -- A monster's attack may apply its one effect to a monster it damaged. The chance comes from the
        -- effect's row in EffectTable, by the attribute of the unit that was hit. A cursed unit applies nothing.
        if self.Kind ~= "monster" or self.EffectId == "" or self.CurseRemain > 0 then return end
        if target.Kind ~= "monster" or target.IsDead or target.Attribute == "" then return end
        local effect = _BattleConfig:GetEffect(self.EffectId)
        if effect == nil then return end
        local chance = effect.chance[target.Attribute] or 0
        if chance <= 0 or _UtilLogic:RandomDouble() * 100 >= chance then return end
        target:ReceiveEffect(effect, self)
    end

    @ExecSpace("ServerOnly")
    method void ReceiveEffect(table effect, any source)
        -- Applies an effect to this unit by its type:
        -- nullify = this unit's attacks do nothing to the source for the duration,
        -- curse   = this unit's own effect is off for the duration,
        -- warp    = moved back by power at once and held for the duration,
        -- blow    = pushed back by power over the duration.
        log("[BattleUnit] effect " .. effect.id .. " (" .. effect.type .. ") " .. source.Entity.Name .. " -> " .. self.Entity.Name .. " attribute=" .. self.Attribute .. " duration=" .. tostring(effect.duration) .. " power=" .. tostring(effect.power))
        local distance = effect.power * _BattleConfig.RangeScale
        -- The icon stays at least IconMinSeconds so very short effects (a push) are still readable.
        self._T.statuses[effect.type] = _UtilLogic.ServerElapsedSeconds + math.max(effect.duration, _BattleConfig.StatusIconMinSeconds)
        self:RefreshStatus(true)
        if effect.type == "nullify" then
            self.NullifyTarget = source
            self.NullifyRemain = effect.duration
        elseif effect.type == "curse" then
            self.CurseRemain = effect.duration
        elseif effect.type == "warp" then
            local pos = self.Entity.TransformComponent.WorldPosition
            local dir = self:GetDirection()
            local baseX = self.Director:GetBaseX(self.Team)
            local newX = pos.x - dir * distance
            if (newX - baseX) * dir < 0.3 then newX = baseX + dir * 0.3 end
            self.Entity.MovementComponent:SetWorldPosition(Vector2(newX, pos.y))
            self:StartKnockback(0, effect.duration, false)
        elseif effect.type == "blow" then
            self:StartKnockback(distance, math.max(0.1, effect.duration), true)
        else
            log_warning("[BattleUnit] unknown effect type " .. effect.type .. " in EffectTable row " .. effect.id)
        end
    end

    @ExecSpace("ServerOnly")
    method void RefreshStatus(boolean changed)
        -- Drops expired effect entries and rewrites StatusCsv when the set changed.
        local statuses = self._T.statuses
        if statuses == nil then return end
        local now = _UtilLogic.ServerElapsedSeconds
        local parts = {}
        for kind, endAt in pairs(statuses) do
            if endAt <= now then
                statuses[kind] = nil
                changed = true
            else
                table.insert(parts, kind .. ":" .. string.format("%.2f", endAt))
            end
        end
        if changed == false then return end
        table.sort(parts)
        self.StatusCsv = table.concat(parts, ",")
    end

    @ExecSpace("ServerOnly")
    method void StartKnockback(number distance, number seconds, boolean useHitClip)
        -- Pushes this monster back by distance over seconds (distance 0 = held in place). While it lasts the
        -- unit neither attacks nor advances, and with useHitClip its hit clip plays.
        if self.Kind ~= "monster" or self.IsDead or seconds <= 0 then return end
        self.PendingTarget = nil
        self.PoseTimer = 0
        self.Mode = "KNOCKBACK"
        self.KnockRemain = seconds
        self.KnockStartX = self.Entity.TransformComponent.WorldPosition.x
        self.KnockTarget = distance
        self.KnockSpeed = 0
        self:StopMoving()
        -- The push is a physics impulse: a force backwards (sized from the distance) with a small lift, which the
        -- engine then damps on its own, so the unit hops back and slows down like a real shove.
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) and distance > 0 then
            local back = -self:GetDirection()
            body:SetForce(Vector2(back * distance * _BattleConfig.KnockbackForcePerUnit, _BattleConfig.KnockbackLift))
        end
        if useHitClip and self.HitRUID ~= "" then
            self:SetSprite(self.HitRUID, 1)
        else
            self:SetSprite(self.StandRUID, 1)
        end
        log("[BattleUnit] " .. self.Entity.Name .. " knockback distance=" .. string.format("%.2f", distance) .. " seconds=" .. string.format("%.2f", seconds) .. " hp=" .. tostring(self.Hp) .. " count=" .. tostring(self.KnockCount) .. " x=" .. string.format("%.2f", self.Entity.TransformComponent.WorldPosition.x))
    end

    @ExecSpace("ServerOnly")
    method void EndKnockback()
        -- Ends a knockback: walking speed is restored and the normal behavior picks the next mode.
        self.KnockRemain = 0
        self.KnockSpeed = 0
        self.Mode = ""
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then
            movement:Stop()
            if self.WalkSpeed > 0 then movement.InputSpeed = self.WalkSpeed end
        end
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) then body:SetForce(Vector2(0, 0)) end
        log("[BattleUnit] " .. self.Entity.Name .. " knockback ended x=" .. string.format("%.2f", self.Entity.TransformComponent.WorldPosition.x))
    end

    @ExecSpace("ServerOnly")
    method void TakeDamage(number amount)
        -- Reduces HP and kills the unit at zero. A monster is knocked back each time it has lost another
        -- KnockStep of HP (several steps crossed by one hit give one knockback).
        if self.IsDead or self.Ready == false then return end
        self.Hp = math.max(0, self.Hp - amount)
        if self.Hp <= 0 then
            self:Die()
            return
        end
        if self.KnockStep > 0 then
            local steps = math.floor((self.MaxHp - self.Hp) / self.KnockStep)
            if steps > self.KnockCount then
                self.KnockCount = steps
                self:StartKnockback(self.KnockDistance, self.KnockSeconds, true)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void Die()
        -- Monsters and builds play the death clip and are destroyed; a base ends the battle instead.
        self.IsDead = true
        self.PendingTarget = nil
        self._T.statuses = {}
        self.StatusCsv = ""
        self:StopMoving()
        local director = self.Director
        log("[BattleUnit] " .. self.Entity.Name .. " died")
        if self.Kind == "base" then
            if director ~= nil then director:OnBaseDestroyed(self.Team) end
            return
        end
        self:SetSprite(self.DieRUID, 1)
        if director ~= nil then director:RemoveUnit(self) end
        local entity = self.Entity
        _TimerService:SetTimerOnce(function()
            if isvalid(entity) then entity:Destroy() end
        end, 0.6)
    end

    @ExecSpace("Multicast")
    method void NotifyAttack(Entity target, number travelTime)
        -- Tells every client that an attack started, so it can show the attack effect, sound and projectile (presentation only).
        _BattleFx:OnAttackFired(self, target, travelTime)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Registers this unit with the client presentation layer (HP bar, hit feedback).
        _BattleFx:RegisterUnit(self)
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- Forwards synced HP changes to the client presentation layer.
        if name == "Hp" or name == "MaxHp" then _BattleFx:OnUnitHpSync(self) end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Removes this unit's client presentation when it leaves play.
        _BattleFx:UnregisterUnit(self)
    end

end
