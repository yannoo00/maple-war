@Component
script BattleUnit extends Component

    @Sync property integer Team = 0
    @Sync property number MaxHp = 100
    @Sync property number Hp = 100
    @Sync property string UnitId = ""
    -- Effects currently shown on this unit, for the client icons: "type:endAt,..." (endAt in ServerElapsedSeconds).
    @Sync property string StatusCsv = ""
    -- Presentation state for the clients, as "state:serial". The server only decides the state; each client picks
    -- and plays the clip itself from the unit's UnitTable row (see ApplyAnim). States: move / stand / attack / hit /
    -- die. The serial changes on every state change, so a repeated attack is still a new event.
    @Sync property string Anim = ""
    -- Generation of this entity. Unit entities are pooled and reused (EntityPool): every Setup starts a new life, and
    -- clients rebuild their presentation of the unit when it changes. References held across time compare it too,
    -- so an attack aimed at a previous life never lands on the next one.
    @Sync property integer Life = 0
    property string Kind = "monster"
    property number AttackPower = 10
    -- melee / ranged hit one target; melee_area / ranged_area hit every enemy in range (UnitTable AttackType).
    property string AttackType = "melee"
    property boolean IsAreaAttack = false
    property number AttackRange = 0.7
    -- ranged_area: radius (world units) around the attacked target within which every enemy is hit.
    property number AreaRadius = 0
    -- Area attacks: most units one attack can hit (0 = no limit).
    property integer MaxTargets = 0
    property number AttackInterval = 1.0
    property number AttackHitDelay = 0
    property number MoveSpeed = 1.0
    property number GoalX = 0
    -- UnitTable: attribute and knockback settings (monsters only). The effects a unit uses are its UnitEffectTable rules.
    property string Attribute = ""
    -- HP lost per knockback (0 = never knocked back), push distance in world units and push time.
    property number KnockStep = 0
    property number KnockDistance = 0
    property number KnockSeconds = 0
    @HideFromInspector property integer KnockCount = 0
    @HideFromInspector property number KnockRemain = 0
    @HideFromInspector property number KnockSpeed = 0
    @HideFromInspector property number KnockStartX = 0
    @HideFromInspector property number KnockTarget = 0
    @HideFromInspector property number WalkSpeed = 0
    -- The effects on this unit live in _T.effects and are run by _BattleEffects (registry, ticking, damage pipeline).

    @HideFromInspector property boolean Ready = false
    @HideFromInspector property boolean IsDead = false
    @HideFromInspector property string Mode = ""
    @HideFromInspector property number AttackTimer = 0
    @HideFromInspector property number HitTimer = 0
    @HideFromInspector property any PendingTarget = nil
    @HideFromInspector property integer PendingLife = 0
    @HideFromInspector property any Director = nil
    @HideFromInspector property boolean HasProjectile = false
    -- True when this unit's row has a HitEffectRuid: every unit its attack damages is announced to the clients.
    @HideFromInspector property boolean HasHitEffect = false

    @ExecSpace("ServerOnly")
    method void Setup(integer team, string unitId, table cfg, any director, number goalX)
        -- Applies a unit definition (monster / build / base) and starts its battle behavior. Every call is a new life
        -- of this entity (a fresh spawn or a pooled entity taken out again), so all per-life state is reset here.
        self.Life = self.Life + 1
        self.Team = team
        self.UnitId = unitId
        self.Kind = cfg.kind
        self.MaxHp = cfg.maxHp
        self.Hp = cfg.maxHp
        self.AttackPower = cfg.attack
        self.AttackType = cfg.attackType or ""
        self.IsAreaAttack = cfg.areaAttack == true
        self.AttackRange = cfg.range * _BattleConfig.RangeScale
        self.AreaRadius = (cfg.areaRadius or 1) * _BattleConfig.RangeScale
        self.MaxTargets = math.max(0, cfg.maxTargets or 0)
        self.AttackInterval = cfg.attackInterval
        self.AttackHitDelay = cfg.attackHitDelay
        self.MoveSpeed = cfg.speed
        self.Attribute = ""
        self.KnockStep = 0
        if cfg.kind == "monster" then
            self.Attribute = cfg.attribute or ""
            if cfg.knockbackHpPercent ~= nil and cfg.knockbackHpPercent > 0 then
                self.KnockStep = cfg.maxHp * cfg.knockbackHpPercent / 100
            end
            self.KnockDistance = (cfg.knockbackDistance or 0) * _BattleConfig.RangeScale
            self.KnockSeconds = cfg.knockbackSeconds or 0
        end
        -- Monsters and builds carry effect rules (UnitEffectTable): on_hit rules fire when this unit's attack damages an
        -- enemy, always rules are applied to the unit itself at the end of Setup (so a pooled entity gets them again).
        self._T.effectRules = nil
        if cfg.kind == "monster" or cfg.kind == "build" then
            self._T.effectRules = _BattleConfig:GetUnitEffects(unitId)
        end
        self.KnockCount = 0
        self.KnockRemain = 0
        _BattleEffects:Clear(self)
        self._T.statuses = {}
        self.StatusCsv = ""
        self.WalkSpeed = cfg.speed * _BattleConfig.SpeedScale
        self.GoalX = goalX
        self.Director = director
        self.HasProjectile = cfg.projectileRuid ~= nil
        self.HasHitEffect = cfg.hitEffectRuid ~= nil
        -- Card level of this life (a summon trait spawns its units at the same level).
        self._T.level = cfg.level or 1
        self.IsDead = false
        self.PendingTarget = nil
        self.Mode = ""

        local movement = self.Entity.MovementComponent
        if isvalid(movement) and cfg.speed > 0 then movement.InputSpeed = cfg.speed * _BattleConfig.SpeedScale end

        if cfg.kind ~= "base" then
            -- Sprites face left by default: allies (team 1) face right, so flip Scale.x negative.
            local dir = self:GetDirection()
            local size = cfg.scale * _BattleConfig.UnitScale
            self.Entity.TransformComponent.Scale = Vector3(-dir * size, size, 1)
        end

        self.Ready = true
        if cfg.speed > 0 then
            self:SetMode("MOVE")
        else
            self:SetMode("HOLD")
        end
        log("[BattleUnit] setup " .. self.Entity.Name .. " kind=" .. cfg.kind .. " team=" .. tostring(team) .. " hp=" .. tostring(self.Hp) .. " attackType=" .. self.AttackType .. " area=" .. tostring(self.IsAreaAttack) .. " attribute=" .. self.Attribute .. " effectRules=" .. tostring(self._T.effectRules ~= nil and #self._T.effectRules or 0) .. " knockStep=" .. string.format("%.1f", self.KnockStep))
        self:ApplyAlwaysRules()
    end

    method integer GetDirection()
        -- Returns +1 for allies (advance right) and -1 for enemies (advance left).
        if self.Team == 1 then return 1 end
        return -1
    end

    @ExecSpace("ServerOnly")
    method void SetAnim(string state)
        -- Publishes the presentation state (move / stand / attack / hit / die). Clients turn it into a clip.
        local serial = (self._T.animSerial or 0) + 1
        self._T.animSerial = serial
        self.Anim = state .. ":" .. tostring(serial)
    end

    @ExecSpace("ServerOnly")
    method void StopMoving()
        -- Stops body movement when the unit has a movement component.
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then movement:Stop() end
    end

    @ExecSpace("ServerOnly")
    method void SetMode(string newMode)
        -- Switches behavior mode (MOVE / ATTACK / HOLD) and its presentation state.
        if self.Mode == newMode then return end
        self.Mode = newMode
        if newMode == "MOVE" then
            self:SetAnim("move")
        else
            self:StopMoving()
            self:SetAnim("stand")
            if newMode == "ATTACK" then self.AttackTimer = 0.3 end
        end
    end

    @ExecSpace("ServerOnly")
    method void Halt()
        -- Freezes the unit when the battle ends.
        self.Ready = false
        self.PendingTarget = nil
        self:StopMoving()
        if self.IsDead == false then self:SetAnim("stand") end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- Advances toward the enemy base, stopping to fight any enemy target in range.
        if self.Ready == false or self.IsDead then return end
        local director = self.Director
        if director == nil then return end

        if self.StatusCsv ~= "" then self:RefreshStatus(false) end
        _BattleEffects:Tick(self, delta)
        -- A poison tick may have killed the unit.
        if self.IsDead then return end

        local x = self.Entity.TransformComponent.WorldPosition.x
        if self.KnockRemain > 0 then
            -- Knocked back (or held by an effect): no attacking or advancing until it ends.
            self.KnockRemain = self.KnockRemain - delta
            local back = -self:GetDirection()
            -- Never pushed behind its own base tower.
            local room = (x - director:GetBaseX(self.Team)) * -back
            -- The push itself is a physics impulse given in StartKnockback; here the unit only waits it out.
            -- A unit shoved against its own base tower is stopped there.
            if room <= 0.3 then
                local body = self.Entity.RigidbodyComponent
                if isvalid(body) then body:SetForce(Vector2(0, 0)) end
            end
            if self.KnockRemain <= 0 then self:EndKnockback() end
            return
        end

        if self.PendingTarget ~= nil then
            self.HitTimer = self.HitTimer - delta
            if self.HitTimer <= 0 then
                local pending = self.PendingTarget
                self.PendingTarget = nil
                self:ApplyHit(pending, x)
            end
        end

        if self.AttackPower <= 0 then return end

        local dir = self:GetDirection()
        local target = self:FindAttackTarget(x)
        if target ~= nil then
            self:SetMode("ATTACK")
            self.AttackTimer = self.AttackTimer - delta
            if self.AttackTimer <= 0 then
                -- Effects can slow the attack (icy): the next attack comes later by 1 / the attack speed multiplier.
                self.AttackTimer = self.AttackInterval / math.max(0.1, _BattleEffects:GetRate(self, "attackSpeed"))
                -- Clients play the attack clip once and return to the stand clip when it ends, on their own.
                self:SetAnim("attack")
                self.PendingTarget = target
                self._T.aimX = target.Entity.TransformComponent.WorldPosition.x
                self.PendingLife = target.Life
                self.HitTimer = self.AttackHitDelay
                -- Every attack is announced: clients show the attack effect, play the attack sound and fly the projectile.
                self:NotifyAttack(target.Entity, self.AttackHitDelay)
            end
        elseif self.MoveSpeed <= 0 or (self.GoalX - x) * dir <= self.AttackRange then
            self:SetMode("HOLD")
        else
            self:SetMode("MOVE")
            -- Effects can slow the walk (icy); the walking speed is set again whenever the multiplier changes.
            local movement = self.Entity.MovementComponent
            local speed = self.WalkSpeed * _BattleEffects:GetRate(self, "moveSpeed")
            if speed > 0 and math.abs(movement.InputSpeed - speed) > 0.001 then movement.InputSpeed = speed end
            movement:MoveToDirection(Vector2(dir, 0), delta)
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyHit(any aimed, number x)
        -- The attack lands. A single-target attack damages the target it was aimed at when the attack started;
        -- a melee_area attack damages every enemy within attack range of this unit, a ranged_area attack every enemy within AreaRadius of the attacked target.
        if self.IsAreaAttack then
            local siege = _BattleEffects:HasFlag(self, "siege")
            -- melee_area: everything within attack range of this unit. ranged_area: everything within AreaRadius of the
            -- attacked target (its last known position if it died or left before the hit lands).
            local centerX = x
            local radius = self.AttackRange
            if self.AttackType == "ranged_area" then
                radius = self.AreaRadius
                centerX = self._T.aimX or x
                if aimed ~= nil and aimed.IsDead == false and aimed.Life == self.PendingLife and isvalid(aimed.Entity) then
                    centerX = aimed.Entity.TransformComponent.WorldPosition.x
                end
            end
            local targets = self.Director:FindTargetsInRange(self.Team, centerX, radius)
            -- With a cap, the units nearest to the blast center are hit first (the aimed target is at distance ~0).
            if self.MaxTargets > 0 and #targets > self.MaxTargets then
                table.sort(targets, function(a, b)
                    return math.abs(a.Entity.TransformComponent.WorldPosition.x - centerX) < math.abs(b.Entity.TransformComponent.WorldPosition.x - centerX)
                end)
            end
            local hits = 0
            for _, target in ipairs(targets) do
                if self.MaxTargets > 0 and hits >= self.MaxTargets then break end
                if siege == false or target.Kind ~= "monster" then
                    self:DealDamage(target)
                    hits = hits + 1
                end
            end
            log("[VRF] [BattleUnit] " .. self.Entity.Name .. " area hit (" .. self.AttackType .. ") centerX=" .. string.format("%.2f", centerX) .. " radius=" .. string.format("%.2f", radius) .. " targets=" .. tostring(hits) .. " max=" .. tostring(self.MaxTargets) .. " damage=" .. tostring(self.AttackPower))
            return
        end
        -- The aimed unit must still be in the life it was aimed at (its entity may have been reused since).
        if aimed.IsDead == false and aimed.Life == self.PendingLife and isvalid(aimed.Entity) then self:DealDamage(aimed) end
    end

    @ExecSpace("ServerOnly")
    method any FindAttackTarget(number x)
        -- Returns what this unit attacks from x: the nearest enemy in range, or for a siege unit the nearest enemy
        -- build / base in range (it walks past monsters).
        local director = self.Director
        if _BattleEffects:HasFlag(self, "siege") == false then return director:FindTarget(self.Team, x, self.AttackRange) end
        local best = nil
        local bestDist = self.AttackRange
        for _, unit in ipairs(director:FindTargetsInRange(self.Team, x, self.AttackRange)) do
            if unit.Kind ~= "monster" then
                local dist = math.abs(unit.Entity.TransformComponent.WorldPosition.x - x)
                if dist <= bestDist then
                    best = unit
                    bestDist = dist
                end
            end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method void DealDamage(any target)
        -- Damages one unit with this unit's attack through the damage pipeline (_BattleEffects:DealHit: this unit's
        -- effects, the attribute bonus, the target's effects), then rolls this unit's on_hit effect rules on it.
        if _BattleEffects:DealHit(self, target, self.AttackPower, "attack") < 0 then return end
        -- Clients play this unit's hit effect on the unit that was just damaged (only units that have one announce it).
        if self.HasHitEffect and isvalid(target.Entity) then self:NotifyHit(target.Entity) end
        self:TryApplyEffect(target)
    end

    @ExecSpace("ServerOnly")
    method void TryApplyEffect(any target)
        -- Rolls this unit's on_hit effect rules on a monster it just damaged; every rule has its own chance (percent).
        local rules = self._T.effectRules
        if rules == nil or #rules == 0 then return end
        if target.Kind ~= "monster" or target.IsDead then return end
        for _, rule in ipairs(rules) do
            if rule.trigger == "on_hit" and rule.chance > 0 and _UtilLogic:RandomDouble() * 100 < rule.chance then
                self:ApplyEffectRule(rule, target)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyEffectRule(table rule, any receiver)
        -- Applies one rule's effect to receiver (the damaged enemy for on_hit, this unit itself for always). The rule's
        -- duration / power override the effect's defaults; an always rule lasts as long as the unit lives.
        local effect = _BattleConfig:GetEffect(rule.effectId)
        if effect == nil then
            log_warning("[BattleUnit] effect rule of " .. self.UnitId .. " names an unknown effect " .. rule.effectId)
            return
        end
        if (rule.target == "self" and effect.applies == "target") or (rule.target == "target" and effect.applies == "self") then
            log_warning("[BattleUnit] effect " .. effect.id .. " cannot be used with target=" .. rule.target .. " (EffectTable Applies=" .. effect.applies .. ")")
            return
        end
        receiver:ReceiveEffect({
            id = effect.id,
            name = effect.name,
            duration = rule.duration or effect.duration,
            power = rule.power or effect.power,
            chance = rule.chance,
            param = effect.param,
            permanent = rule.trigger == "always",
        }, self)
    end

    @ExecSpace("ServerOnly")
    method void ApplyAlwaysRules()
        -- Applies this unit's always rules to itself. Setup calls this at the end and runs for every life, so a pooled
        -- entity that is taken out again gets its traits again.
        local rules = self._T.effectRules
        if rules == nil then return end
        for _, rule in ipairs(rules) do
            if rule.trigger == "always" then self:ApplyEffectRule(rule, self) end
        end
    end

    @ExecSpace("ServerOnly")
    method void ReceiveEffect(table effect, any source)
        -- Puts an effect on this unit: { id, type, duration, power, chance, permanent }. What each type does is
        -- defined in _BattleEffects (GetDefs); source is the unit that caused it, or nil for a skill.
        _BattleEffects:Apply(self, effect, source)
    end

    @ExecSpace("ServerOnly")
    method void ShowStatus(string kind, number seconds)
        -- Shows an effect's icon above this unit for seconds (clients read StatusCsv).
        if self._T.statuses == nil then self._T.statuses = {} end
        self._T.statuses[kind] = _UtilLogic.ServerElapsedSeconds + seconds
        self:RefreshStatus(true)
    end

    @ExecSpace("ServerOnly")
    method void RefreshStatus(boolean changed)
        -- Drops expired effect entries and rewrites StatusCsv when the set changed.
        local statuses = self._T.statuses
        if statuses == nil then return end
        local now = _UtilLogic.ServerElapsedSeconds
        local parts = {}
        for kind, endAt in pairs(statuses) do
            if endAt <= now then
                statuses[kind] = nil
                changed = true
            else
                table.insert(parts, kind .. ":" .. string.format("%.2f", endAt))
            end
        end
        if changed == false then return end
        table.sort(parts)
        self.StatusCsv = table.concat(parts, ",")
    end

    @ExecSpace("ServerOnly")
    method void StartKnockback(number distance, number seconds, boolean useHitClip)
        -- Pushes this monster back by distance over seconds (distance 0 = held in place). While it lasts the
        -- unit neither attacks nor advances, and with useHitClip its hit clip plays.
        if self.Kind ~= "monster" or self.IsDead or seconds <= 0 then return end
        -- A unit that cannot be knocked back (titan) ignores every push; being held in place (distance 0) still works.
        if distance > 0 and _BattleEffects:HasFlag(self, "no_knockback") then return end
        self.PendingTarget = nil
        self.Mode = "KNOCKBACK"
        self.KnockRemain = seconds
        self.KnockStartX = self.Entity.TransformComponent.WorldPosition.x
        self.KnockTarget = distance
        self.KnockSpeed = 0
        self:StopMoving()
        -- The push is a physics impulse: a force backwards (sized from the distance) with a small lift, which the
        -- engine then damps on its own, so the unit hops back and slows down like a real shove.
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) and distance > 0 then
            local back = -self:GetDirection()
            body:SetForce(Vector2(back * distance * _BattleConfig.KnockbackForcePerUnit, _BattleConfig.KnockbackLift))
        end
        -- Clients play the hit clip (or the stand clip when the unit has none).
        if useHitClip then
            self:SetAnim("hit")
        else
            self:SetAnim("stand")
        end
        log("[BattleUnit] " .. self.Entity.Name .. " knockback distance=" .. string.format("%.2f", distance) .. " seconds=" .. string.format("%.2f", seconds) .. " hp=" .. tostring(self.Hp) .. " count=" .. tostring(self.KnockCount) .. " x=" .. string.format("%.2f", self.Entity.TransformComponent.WorldPosition.x))
    end

    @ExecSpace("ServerOnly")
    method void EndKnockback()
        -- Ends a knockback: walking speed is restored and the normal behavior picks the next mode.
        self.KnockRemain = 0
        self.KnockSpeed = 0
        self.Mode = ""
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then
            movement:Stop()
            if self.WalkSpeed > 0 then movement.InputSpeed = self.WalkSpeed end
        end
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) then body:SetForce(Vector2(0, 0)) end
        log("[BattleUnit] " .. self.Entity.Name .. " knockback ended x=" .. string.format("%.2f", self.Entity.TransformComponent.WorldPosition.x))
    end

    @ExecSpace("ServerOnly")
    method void TakeDamage(number amount)
        -- Reduces HP and kills the unit at zero. A monster is knocked back each time it has lost another
        -- KnockStep of HP (several steps crossed by one hit give one knockback).
        if self.IsDead or self.Ready == false then return end
        self.Hp = math.max(0, self.Hp - amount)
        if self.Hp <= 0 then
            self:Die()
            return
        end
        if self.KnockStep > 0 then
            local steps = math.floor((self.MaxHp - self.Hp) / self.KnockStep)
            if steps > self.KnockCount then
                self.KnockCount = steps
                self:StartKnockback(self.KnockDistance, self.KnockSeconds, true)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void Heal(number amount)
        -- Restores HP (a heal skill), up to MaxHp. Dead units are not healed.
        if self.IsDead or self.Ready == false or amount <= 0 then return end
        self.Hp = math.min(self.MaxHp, self.Hp + amount)
    end

    @ExecSpace("ServerOnly")
    method void Die()
        -- Monsters and builds play the death clip and are destroyed; a base ends the battle instead.
        self.IsDead = true
        self.PendingTarget = nil
        _BattleEffects:Clear(self)
        self._T.statuses = {}
        self.StatusCsv = ""
        self:StopMoving()
        local director = self.Director
        log("[BattleUnit] " .. self.Entity.Name .. " died")
        if self.Kind == "base" then
            if director ~= nil then director:OnBaseDestroyed(self.Team) end
            return
        end
        self:SetAnim("die")
        if director ~= nil then director:RemoveUnit(self) end
        -- Clients play the die clip and hide the unit when it ends; the server never waits for them and simply takes
        -- the entity away after DieReleaseSeconds (longer than any die clip).
        -- The entity goes back to the unit pool (or is destroyed when the map has no pool) through the director.
        local entity = self.Entity
        local life = self.Life
        _TimerService:SetTimerOnce(function()
            -- Skip when a battle restart already took this entity back and gave it a new life.
            if isvalid(entity) and self.Life == life and director ~= nil then director:ReleaseUnitEntity(entity) end
        end, _BattleConfig.DieReleaseSeconds)
    end

    -- ===== EntityPool hooks (server). The pool calls these by name; Setup (called right after Acquire) does the
    -- per-life reset, so these only handle what belongs to taking the entity out of / back into the pool. =====

    @ExecSpace("ServerOnly")
    method void OnPoolAcquire(Vector3 pos)
        -- Taken out of the pool, before it is enabled again: place the body at the spawn point with no leftover push.
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) then body:SetForce(Vector2(0, 0)) end
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then
            movement:Stop()
            movement:SetWorldPosition(Vector2(pos.x, pos.y))
        end
    end

    @ExecSpace("ServerOnly")
    method void OnPoolRelease()
        -- Going back to the pool: stop every behavior so nothing runs while it is parked.
        self.Ready = false
        self.PendingTarget = nil
        _BattleEffects:Clear(self)
        self._T.effectRules = nil
        self.KnockRemain = 0
        self._T.statuses = {}
        self.StatusCsv = ""
        self:StopMoving()
        local body = self.Entity.RigidbodyComponent
        if isvalid(body) then body:SetForce(Vector2(0, 0)) end
    end

    @ExecSpace("Multicast")
    method void NotifyAttack(Entity target, number travelTime)
        -- Tells every client that an attack started, so it can show the attack effect, sound and projectile (presentation only).
        _BattleFx:OnAttackFired(self, target, travelTime)
    end

    @ExecSpace("Multicast")
    method void NotifyHit(Entity target)
        -- Tells every client that this unit's attack just damaged target, so it can play the hit effect on it (presentation only).
        _BattleFx:OnAttackHit(self, target)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Listens for the end of each clip (to finish the death) and for the entity being enabled again (a pooled
        -- entity taken out for a new life), then builds this client's presentation of the state already synced.
        -- Safe to run more than once: a re-enabled entity may or may not get OnBeginPlay again.
        if self._T.clipEndHandler == nil then
            self._T.clipEndHandler = self.Entity:ConnectEvent(SpriteAnimPlayerEndFrameEvent, function(event) self:OnClipEnd() end)
        end
        if self._T.clipStartHandler == nil then
            self._T.clipStartHandler = self.Entity:ConnectEvent(SpriteAnimPlayerStartFrameEvent, function(event) self:OnClipRestart() end)
        end
        if self._T.enableHandler == nil then
            self._T.enableHandler = self.Entity:ConnectEvent(EntityEnabledInHierarchyChangedEvent, function(event)
                if event.EnabledInHierarchy then self:SyncPresentation() end
            end)
        end
        self:SyncPresentation()
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- Forwards synced HP changes to the client presentation layer and turns state changes into clips.
        if name == "Hp" or name == "MaxHp" then _BattleFx:OnUnitHpSync(self) end
        -- UnitId and Life too: the clip RUIDs come from the unit's row, and a new life (a reused pooled entity) starts
        -- its presentation over, so a state that arrived first is applied once those are known.
        if name == "Anim" or name == "UnitId" or name == "Life" then self:SyncPresentation() end
    end

    @ExecSpace("ClientOnly")
    method void SyncPresentation()
        -- Brings this client's presentation in line with the synced unit: a new life or a different unit id drops the
        -- old BattleFx record (bar, effect icons, hit flash) and starts a fresh one; then the current state's clip shows.
        local fxKey = tostring(self.Life) .. "|" .. self.UnitId
        if fxKey ~= self._T.fxKey then
            local reused = self._T.fxKey ~= nil
            self._T.fxKey = fxKey
            _BattleFx:UnregisterUnit(self)
            _BattleFx:RegisterUnit(self)
            if reused then log("[VRF] BattleUnit " .. self.Entity.Name .. " presentation reset for life " .. fxKey) end
        end
        self:ApplyAnim()
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Removes this unit's client presentation when it leaves play.
        self:StopFade()
        if self._T.clipEndHandler ~= nil then
            self.Entity:DisconnectEvent(SpriteAnimPlayerEndFrameEvent, self._T.clipEndHandler)
            self._T.clipEndHandler = nil
        end
        if self._T.clipStartHandler ~= nil then
            self.Entity:DisconnectEvent(SpriteAnimPlayerStartFrameEvent, self._T.clipStartHandler)
            self._T.clipStartHandler = nil
        end
        if self._T.enableHandler ~= nil then
            self.Entity:DisconnectEvent(EntityEnabledInHierarchyChangedEvent, self._T.enableHandler)
            self._T.enableHandler = nil
        end
        _BattleFx:UnregisterUnit(self)
        -- Forget what was shown, so a later OnBeginPlay (a re-enabled pooled entity) rebuilds everything.
        self._T.fxKey = nil
        self._T.shownAnim = nil
    end

    -- ===== Client presentation: clips =====
    -- The server only publishes Anim ("state:serial"); everything visible is decided here, per client.

    @ExecSpace("ClientOnly")
    method void ApplyAnim()
        -- Turns the synced state into this unit's clip, from its UnitTable row:
        -- move = move clip, stand = stand clip, attack = attack clip at AttackPlayRate, played once and then back to
        -- the stand clip (see OnClipEnd / FinishAttackClip),
        -- hit = hit clip (stand clip when it has none), die = die clip (the unit is hidden when it ends, see OnClipEnd).
        local anim = self.Anim
        if anim == "" then return end
        -- What is shown is keyed by state, unit id and life: a reused entity (another unit, a new life) applies again.
        local shownKey = anim .. "|" .. self.UnitId .. "|" .. tostring(self.Life)
        if shownKey == self._T.shownAnim then return end
        local cfg = _BattleConfig:GetUnit(self.UnitId)
        if cfg == nil then return end
        self._T.shownAnim = shownKey
        local state = anim
        local colon, colonEnd = string.find(anim, ":", 1, true)
        if colon ~= nil then state = string.sub(anim, 1, colon - 1) end
        self._T.animState = state
        local ruid = cfg.standRuid
        local rate = 1
        if state == "move" then
            ruid = cfg.moveRuid
        elseif state == "attack" then
            ruid = cfg.attackRuid
            rate = cfg.attackPlayRate
        elseif state == "hit" then
            if cfg.hitRuid ~= nil and cfg.hitRuid ~= "" then ruid = cfg.hitRuid end
        elseif state == "die" then
            ruid = cfg.dieRuid
        end
        -- Any new state shows the unit fully opaque again (a reused unit must not keep a previous death fade).
        self:StopFade()
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite:SetAlpha(1) end
        self:ShowSprite(true)
        self:PlayClip(ruid, rate)
        -- An attack clip plays once: attackClip names the attack being shown until its clip has ended.
        self._T.attackClip = nil
        self._T.attackEnding = nil
        if state == "attack" then self._T.attackClip = shownKey end
        if state == "die" and (ruid == nil or ruid == "") then self:FinishDeath("no die clip") end
    end

    @ExecSpace("ClientOnly")
    method void PlayClip(string ruid, number playRate)
        -- Swaps the playing clip and its play rate on this client only.
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) and ruid ~= nil and ruid ~= "" then
            sprite.PlayRate = playRate
            sprite.SpriteRUID = ruid
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowSprite(boolean shown)
        -- Shows or hides this unit's sprite on this client only.
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) and sprite.Enable ~= shown then sprite.Enable = shown end
    end

    @ExecSpace("ClientOnly")
    method void OnClipEnd()
        -- A clip reached its last frame. The die clip finishes the death at that moment. An attack clip is marked as
        -- ending: it goes back to the stand clip when it wraps around to its first frame (OnClipRestart), so its
        -- last frame is still shown in full. The 0.5 s timer covers a clip that never reports the wrap.
        if self._T.animState == "die" then
            self:FinishDeath("die clip ended")
            return
        end
        local key = self._T.attackClip
        if key == nil or key ~= self._T.shownAnim or self._T.attackEnding == key then return end
        self._T.attackEnding = key
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and self._T.attackEnding == key then self:FinishAttackClip("fallback") end
        end, 0.5)
    end

    @ExecSpace("ClientOnly")
    method void OnClipRestart()
        -- A clip started its first frame. For an attack clip that already showed its last frame this is the wrap
        -- around: the attack motion is over.
        local key = self._T.attackEnding
        if key ~= nil and key == self._T.shownAnim then self:FinishAttackClip("clip ended") end
    end

    @ExecSpace("ClientOnly")
    method void FinishAttackClip(string reason)
        -- The attack clip played once: back to the stand clip until the next state (the next attack, moving, ...).
        local key = self._T.attackClip
        self._T.attackClip = nil
        self._T.attackEnding = nil
        if key == nil or key ~= self._T.shownAnim then return end
        local cfg = _BattleConfig:GetUnit(self.UnitId)
        if cfg == nil then return end
        self:PlayClip(cfg.standRuid, 1)
        if self._T.attackEndLogged ~= true then
            self._T.attackEndLogged = true
            log("[VRF] BattleUnit " .. self.Entity.Name .. " attack clip finished (" .. reason .. "), back to stand")
        end
    end

    @ExecSpace("ClientOnly")
    method void FinishDeath(string reason)
        -- The die clip is over on this client: the unit fades out over DeathFadeSeconds (same for every unit),
        -- then is hidden. (The server takes the entity away on its own timer, DieReleaseSeconds after the death.)
        if self._T.deathShown == self._T.shownAnim then return end
        self._T.deathShown = self._T.shownAnim
        self:StopFade()
        local sprite = self.Entity.SpriteRendererComponent
        local duration = _BattleConfig.DeathFadeSeconds
        if not isvalid(sprite) or duration <= 0 then
            self:ShowSprite(false)
            return
        end
        local startAt = _UtilLogic.ElapsedSeconds
        self._T.fadeTimer = _TimerService:SetTimerRepeat(function()
            if not isvalid(self.Entity) then
                self:StopFade()
                return
            end
            local alpha = 1 - (_UtilLogic.ElapsedSeconds - startAt) / duration
            if alpha <= 0 then
                self:StopFade()
                sprite:SetAlpha(0)
                self:ShowSprite(false)
                log("[BattleUnit] " .. self.Entity.Name .. " faded out")
            else
                sprite:SetAlpha(alpha)
            end
        end, 1 / 30)
        log("[BattleUnit] " .. self.Entity.Name .. " death fade started (" .. reason .. ") over " .. tostring(duration) .. "s")
    end

    @ExecSpace("ClientOnly")
    method void StopFade()
        -- Stops a running death fade timer.
        if self._T.fadeTimer ~= nil then
            _TimerService:ClearTimer(self._T.fadeTimer)
            self._T.fadeTimer = nil
        end
    end

end
