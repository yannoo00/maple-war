@Component
script BattleDirector extends Component

    -- Runs one battle on this map. Team-neutral: it keeps the clock, fills both sides' cost,
    -- validates and executes card requests, and decides the winner. It does not know whether
    -- a side is driven by a player (Commander) or by a stage AI (StageAI).
    --
    -- Field layout (read from the map, so it can be edited in Maker without code changes):
    --   AllyBase / EnemyBase            = each side's base (BattleUnit + BattleSide). Only a base has HP; when it falls the
    --                                     battle ends. The player's base is Papulatus.
    --   AllyPortal, AllyPortal_1 ...    = team 1's spawn portals (up to BattleConfig.MaxPortals), EnemyPortal... = team 2's.
    --                                     A portal has no HP and is never a target. Monsters come out of the portal the
    --                                     player picked and walk toward the enemy side.
    -- Floors: units only fight what stands on their own floor (heights within BattleConfig.FloorTolerance); a unit that
    -- drops to another floor fights there. A unit that reaches an enemy portal on its floor attacks the enemy BASE
    -- through it: the damage goes to the base's HP and clients show a particle flying from that portal to the base.
    @Sync property string State = "WAITING"
    @Sync property integer WinnerTeam = 0
    @Sync property integer RewardMeso = 0
    -- Reward chest of the finished battle and the cards it gave ("unitId:count,..."), for the result screen.
    @Sync property string RewardChest = ""
    @Sync property string RewardCardsCsv = ""
    @Sync property number AllyBaseX = 0
    @Sync property number EnemyBaseX = 0
    -- Left and right end of the field (outermost base / portal plus BattleConfig.FieldEdgeMargin).
    @Sync property number FieldMinX = 0
    @Sync property number FieldMaxX = 0
    -- Camera of this map, set per map in Maker (select the map entity > BattleDirector in the inspector):
    -- CameraZoom = screen magnification in percent (100 = normal, 80 = wider view with smaller units; 30 ~ 500),
    -- CameraOffsetY = how far the view is moved up (+) or down (-) in world units (1 = 100 px).
    @Sync property number CameraZoom = 100
    @Sync property number CameraOffsetY = 0
    property string AllyPortalPrefix = "AllyPortal"
    property string EnemyPortalPrefix = "EnemyPortal"
    -- Fallback floor height (StageTable GroundY) for a map whose floor cannot be looked up.
    @Sync property number GroundY = -1.36
    property string UnitModelId = "battleunit"
    -- Unit entities come from the map's EntityPool (script.EntityPool on this same map entity): taken out on spawn,
    -- put back after death instead of being destroyed. This many are created up front so the first spawns do not hitch.
    -- Without the pool component on the map, units are spawned and destroyed directly as before.
    property string UnitPoolKey = "unit"
    property integer UnitPoolPrewarm = 12
    -- The battle starts when the player's client reports its resources loaded, or after this many seconds.
    property number ReadyTimeout = 10
    @HideFromInspector property number Elapsed = 0
    @Sync property string StageId = ""
    @HideFromInspector property string PlayerUserId = ""

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Collects the two sides from the base entities and waits for the player to arrive.
        self._T.units = {}
        self._T.seq = 0
        self._T.sides = {}
        self._T.bases = {}
        self._T.portalHitAt = {}
        self:BindSide(1, "AllyBase")
        self:BindSide(2, "EnemyBase")
        self:PreparePool()
        self.State = "WAITING"
        log("[BattleDirector] waiting for player")
    end

    @ExecSpace("ServerOnly")
    method any GetPool()
        -- Returns the map's EntityPool component, or nil when this map has none.
        return self.Entity:GetComponent("script.EntityPool")
    end

    @ExecSpace("ServerOnly")
    method void PreparePool()
        -- Registers the unit pool with the map's EntityPool and creates the first parked unit entities.
        ---@type EntityPool
        local pool = self:GetPool()
        if pool == nil then
            log_warning("[BattleDirector] no EntityPool on " .. self.Entity.Name .. ", units are spawned and destroyed directly")
            return
        end
        pool:Prewarm(self.UnitPoolKey, self.UnitModelId, self.UnitPoolPrewarm)
        pool:SetHooks(self.UnitPoolKey, { "script.BattleUnit" })
        log("[BattleDirector] unit pool ready key=" .. self.UnitPoolKey .. " prewarm=" .. tostring(self.UnitPoolPrewarm))
    end

    @ExecSpace("ServerOnly")
    method void ReleaseUnitEntity(Entity entity)
        -- Takes a unit entity off the field: back to the pool (parked for reuse), or destroyed when there is no pool.
        if not isvalid(entity) then return end
        ---@type EntityPool
        local pool = self:GetPool()
        if pool ~= nil and pool:Release(entity) then return end
        entity:Destroy()
    end

    @ExecSpace("ServerOnly")
    method void BindSide(integer team, string entityName)
        -- Looks up the base entity of a team and remembers its BattleSide and BattleUnit.
        local entity = self.Entity:GetChildByName(entityName)
        if not isvalid(entity) then
            log_error("[BattleDirector] base entity missing: " .. entityName .. " on " .. self.Entity.Name .. " (the battle cannot start without it)")
            return
        end
        self._T.sides[team] = entity:GetComponent("script.BattleSide")
        self._T.bases[team] = entity:GetComponent("script.BattleUnit")
        if self._T.sides[team] == nil then log_error("[BattleDirector] base has no BattleSide: " .. entityName) end
    end

    @ExecSpace("ServerOnly")
    method any GetSide(integer team)
        -- Returns the BattleSide of a team.
        return self._T.sides[team]
    end

    @ExecSpace("ServerOnly")
    method any GetSideByUser(string userId)
        -- Returns the BattleSide controlled by this user, or nil.
        for _, side in pairs(self._T.sides) do
            if side.ControllerUserId == userId then return side end
        end
        return nil
    end

    @ExecSpace("ServerOnly")
    method boolean UpgradeCostLevel(integer team)
        -- Raises a side's in-battle cost level while the battle is running; returns true when it went up.
        if self.State ~= "PLAYING" then return false end
        ---@type BattleSide
        local side = self._T.sides[team]
        if side == nil then return false end
        local reason = side:UpgradeCostLevel()
        log("[BattleDirector] cost level team=" .. tostring(team) .. " -> " .. (reason == "" and ("Lv" .. tostring(side.CostLevel) .. " max=" .. tostring(side.CostMax)) or ("refused: " .. reason)))
        return reason == ""
    end

    -- ===== Field geometry: portals and floors. No ExecSpace: the server and every client read the same map. =====

    method table GetPortals(integer team)
        -- Returns a team's spawn portals in name order (AllyPortal, AllyPortal_1, ...), at most BattleConfig.MaxPortals:
        -- { index, name, entity, x, y, floorY }. x / y are the portal entity's position, floorY the height of the
        -- floor under it (where units stand). Read once per side and kept; an empty result is looked up again.
        local all = self._T.portals
        if all == nil then
            all = {}
            self._T.portals = all
        end
        local cached = all[team]
        if cached ~= nil then return cached end
        local prefix = self.AllyPortalPrefix
        if team ~= 1 then prefix = self.EnemyPortalPrefix end
        local list = {}
        for _, child in ipairs(self.Entity.Children:ToTable()) do
            local name = child.Name
            if isvalid(child) and child.Enable and (name == prefix or string.sub(name, 1, #prefix + 1) == prefix .. "_") then
                local pos = child.TransformComponent.WorldPosition
                table.insert(list, {
                    name = name, entity = child, x = pos.x, y = pos.y,
                    floorY = self:FloorYBelow(pos.x, pos.y, pos.y - _BattleConfig.PortalFootOffset),
                })
            end
        end
        table.sort(list, function(a, b) return a.name < b.name end)
        while #list > _BattleConfig.MaxPortals do table.remove(list) end
        for i, portal in ipairs(list) do portal.index = i end
        if #list > 0 then all[team] = list end
        return list
    end

    method any FloorYBelow(number x, number y, any fallback)
        -- Returns the height of the first floor (foothold) at or below the point (x, y), or fallback when there is none
        -- within reach. The ray starts a little above the point so a point lying on the floor still finds it.
        local footholds = self.Entity.FootholdComponent
        if not isvalid(footholds) then return fallback end
        local hit = footholds:Raycast(Vector2(x, y + _BattleConfig.FloorProbeUp), Vector2(0, -1), _BattleConfig.FloorProbeDown)
        if hit == nil then return fallback end
        local a = hit.StartPoint
        local b = hit.EndPoint
        if math.abs(b.x - a.x) < 0.0001 then return math.max(a.y, b.y) end
        local k = math.max(0, math.min(1, (x - a.x) / (b.x - a.x)))
        return a.y + (b.y - a.y) * k
    end

    method number GetLowestFloorY()
        -- Returns the height of the lowest floor a portal stands on (the fallback ground height when there are no portals).
        local lowest = nil
        for team = 1, 2 do
            for _, portal in ipairs(self:GetPortals(team)) do
                if lowest == nil or portal.floorY < lowest then lowest = portal.floorY end
            end
        end
        if lowest == nil then return self.GroundY end
        return lowest
    end

    method any FindFloorY(number x, number y)
        -- Returns the floor a click at (x, y) means: the first floor at or below it, never one under the battlefield
        -- (a click below the lowest lane counts as on that lane). nil when x has no floor at all.
        return self:FloorYBelow(x, math.max(y, self:GetLowestFloorY()), nil)
    end

    method number SnapFloorY(number x, number y)
        -- Returns the floor height a click at (x, y) means; y itself when no floor is found there.
        local floorY = self:FindFloorY(x, y)
        if floorY == nil then return y end
        return floorY
    end

    method boolean SameFloor(number y1, number y2)
        -- True when two heights belong to the same floor.
        return math.abs(y1 - y2) <= _BattleConfig.FloorTolerance
    end

    method any FindPortalOnFloor(integer portalTeam, number x, number y, number range)
        -- Returns portalTeam's portal on the floor of height y that is nearest to x and within range of it, or nil.
        local best = nil
        local bestDist = range
        for _, portal in ipairs(self:GetPortals(portalTeam)) do
            if self:SameFloor(portal.floorY, y) then
                local dist = math.abs(portal.x - x)
                if dist <= bestDist then
                    best = portal
                    bestDist = dist
                end
            end
        end
        return best
    end

    method integer GetDirection(integer team)
        -- Returns the direction a team advances in: +1 for team 1 (rightwards), -1 for team 2.
        if team == 1 then return 1 end
        return -1
    end

    method number GetBaseX(integer team)
        -- Returns the x position of a team's base.
        if team == 1 then return self.AllyBaseX end
        return self.EnemyBaseX
    end

    method number GetBackLimitX(integer team, number y)
        -- Returns the x a team's unit standing on floor y is never pushed behind: its own portal on that floor, or its
        -- own end of the field when the floor has none.
        local portal = self:FindPortalOnFloor(team, self:GetBaseX(team), y, 100000)
        if portal ~= nil then return portal.x end
        if team == 1 then return self.FieldMinX end
        return self.FieldMaxX
    end

    method boolean IsPastField(integer team, number x)
        -- True when a unit of team walking forward has reached the far end of the field.
        if team == 1 then return x >= self.FieldMaxX end
        return x <= self.FieldMinX
    end

    -- ===== Battle flow =====

    @ExecSpace("ServerOnly")
    method void TryStartForArrivedPlayer(number delta)
        -- WAITING: prepares the battle when a player has entered this map, then starts it once that
        -- player's client has loaded the battle resources (or the ready timeout passes).
        if self._T.prepared == true then
            self._T.waitTime = self._T.waitTime + delta
            if self._T.ready == true or self._T.waitTime >= self.ReadyTimeout then
                log("[BattleDirector] starting ready=" .. tostring(self._T.ready) .. " waited=" .. string.format("%.2f", self._T.waitTime) .. "s")
                self:StartBattle(self.PlayerUserId, self.StageId)
            end
            return
        end
        if self._T.bases[1] == nil or self._T.bases[2] == nil then return end
        local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
        if users == nil then return end
        for _, user in ipairs(users) do
            if isvalid(user) and isvalid(user.PlayerComponent) then
                -- Wait until the player's saved data (deck and unit levels) has been loaded in this room.
                ---@type PlayerData
                local data = user:GetComponent("script.PlayerData")
                if data == nil or data.Loaded == false then return end
                local userId = user.PlayerComponent.UserId
                local stageId = _MatchService:GetEntryStage(userId)
                -- A test play started on this map has no entry: it plays the first stage of the table.
                if stageId == "" then stageId = _BattleConfig:GetStageIds()[1] or "" end
                self:Prepare(userId, stageId)
                return
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void Prepare(string userId, string stageId)
        -- Publishes what the client needs to load this battle (stage, ground height, field positions) and starts waiting for its ready signal.
        self.PlayerUserId = userId
        self.StageId = stageId
        local stage = _BattleConfig:GetStage(stageId)
        if stage ~= nil then self.GroundY = stage.groundY end
        self:ReadFieldPositions()
        self._T.prepared = true
        self._T.ready = false
        self._T.waitTime = 0
        log("[BattleDirector] prepared user=" .. userId .. " stage=" .. stageId .. ", waiting for client ready")
    end

    @ExecSpace("ServerOnly")
    method void ReadFieldPositions()
        -- Reads the base and portal positions from the map entities and publishes the field's extent to the clients.
        self.AllyBaseX = self._T.bases[1].Entity.TransformComponent.WorldPosition.x
        self.EnemyBaseX = self._T.bases[2].Entity.TransformComponent.WorldPosition.x
        local minX = math.min(self.AllyBaseX, self.EnemyBaseX)
        local maxX = math.max(self.AllyBaseX, self.EnemyBaseX)
        local counts = {}
        for team = 1, 2 do
            local portals = self:GetPortals(team)
            counts[team] = #portals
            for _, portal in ipairs(portals) do
                minX = math.min(minX, portal.x)
                maxX = math.max(maxX, portal.x)
                log("[BattleDirector] portal team=" .. tostring(team) .. " #" .. tostring(portal.index) .. " " .. portal.name .. " x=" .. string.format("%.2f", portal.x) .. " y=" .. string.format("%.2f", portal.y) .. " floorY=" .. string.format("%.2f", portal.floorY))
            end
            if #portals == 0 then log_warning("[BattleDirector] team " .. tostring(team) .. " has no portal on " .. self.Entity.Name .. ", its units appear in front of its base") end
        end
        self.FieldMinX = minX - _BattleConfig.FieldEdgeMargin
        self.FieldMaxX = maxX + _BattleConfig.FieldEdgeMargin
        log("[BattleDirector] field allyBaseX=" .. string.format("%.2f", self.AllyBaseX) .. " enemyBaseX=" .. string.format("%.2f", self.EnemyBaseX) .. " x=" .. string.format("%.2f", self.FieldMinX) .. "~" .. string.format("%.2f", self.FieldMaxX) .. " portals=" .. tostring(counts[1]) .. "/" .. tostring(counts[2]))
    end

    @ExecSpace("ServerOnly")
    method void SetPlayerReady(string userId)
        -- The player's client finished loading the battle resources.
        if userId ~= self.PlayerUserId then return end
        if self._T.ready ~= true then
            self._T.ready = true
            log("[BattleDirector] client ready user=" .. userId)
        end
    end

    @ExecSpace("ServerOnly")
    method void StartBattle(string userId, string stageId)
        -- Clears the field and starts a campaign battle: the user drives team 1, the stage AI drives team 2.
        for _, unit in ipairs(self._T.units) do
            if unit.Kind ~= "base" and isvalid(unit.Entity) then self:ReleaseUnitEntity(unit.Entity) end
        end
        self._T.units = {}
        self._T.portalHitAt = {}
        -- Leave ENDED before clearing the result so clients never see "ended with no winner".
        self.State = "WAITING"
        self.Elapsed = 0
        self.WinnerTeam = 0
        self.RewardMeso = 0
        self.RewardChest = ""
        self.RewardCardsCsv = ""
        self.StageId = stageId
        self.PlayerUserId = userId

        -- The player brings the base in the deck's base slot (HP scaled by its upgrade level); the enemy uses the base the
        -- stage names (EnemyBase), whose HP is the stage's BaseHp.
        ---@type PlayerData
        local data = self:GetPlayerData(userId)
        local playerBaseId = _BattleConfig.DefaultBaseId
        local playerBaseLevel = 1
        if data ~= nil then
            playerBaseId = data:GetSelectedBaseId()
            playerBaseLevel = data:GetBaseUpgradeLevel(playerBaseId)
        end
        local baseCfgs = {}
        baseCfgs[1] = _BattleConfig:GetBaseAtLevel(playerBaseId, playerBaseLevel)
        local stage = _BattleConfig:GetStage(stageId)
        local enemyBaseId = _BattleConfig.DefaultEnemyBaseId
        if stage ~= nil then enemyBaseId = stage.enemyBase end
        baseCfgs[2] = _BattleConfig:GetBaseAtLevel(enemyBaseId, 1)
        if stage ~= nil then
            if baseCfgs[2] ~= nil then baseCfgs[2].maxHp = stage.baseHp end
            -- Each stage map has its own ground height (tile sets differ).
            self.GroundY = stage.groundY
        else
            log_error("[BattleDirector] unknown stage " .. stageId)
        end
        if baseCfgs[1] == nil or baseCfgs[2] == nil then
            log_error("[BattleDirector] no base definition (default base " .. _BattleConfig.DefaultBaseId .. ")")
            return
        end
        if self._T.bases[1] == nil or self._T.bases[2] == nil then
            log_error("[BattleDirector] this map has no AllyBase / EnemyBase, battle not started")
            return
        end
        for team = 1, 2 do
            local base = self._T.bases[team]
            -- Team 1 is the player: its base plays its row's clips. The stage AI's base keeps its map sprite.
            base.UseRowClips = team == 1
            base:Setup(team, baseCfgs[team].id, baseCfgs[team], self)
            table.insert(self._T.units, base)
        end
        -- A player's base is drawn with its own clip when its row has one (Papulatus): sized from the row and turned to
        -- face the enemy. The stage AI's base keeps the sprite and size it was given in the map.
        local playerCfg = baseCfgs[1]
        if playerCfg.standRuid ~= nil and playerCfg.standRuid ~= "" then
            local size = playerCfg.scale * _BattleConfig.UnitScale
            self._T.bases[1].Entity.TransformComponent.Scale = Vector3(-self:GetDirection(1) * size, size, 1)
        end
        log("[BattleDirector] bases player=" .. baseCfgs[1].id .. " hp=" .. string.format("%.0f", baseCfgs[1].maxHp) .. " enemy=" .. baseCfgs[2].id .. " hp=" .. string.format("%.0f", baseCfgs[2].maxHp))
        -- Base and portal positions come from the map, so they can be moved in Maker without code changes.
        self:ReadFieldPositions()

        -- The player's side plays the deck and unit levels from their saved data.
        if data == nil then
            log_error("[BattleDirector] player data missing for " .. userId)
            return
        end
        self._T.sides[1]:Reset(1, data:GetDeckIds(), data:GetUnitLevels(), userId, false, baseCfgs[1].manaLevelCap, baseCfgs[1])
        self._T.sides[2]:Reset(2, {}, {}, "", true, baseCfgs[2].manaLevelCap, baseCfgs[2])

        ---@type StageAI
        local ai = self.Entity:GetComponent("script.StageAI")
        if ai ~= nil then ai:Begin(stageId) end

        self.State = "PLAYING"
        log("[BattleDirector] battle started user=" .. userId .. " stage=" .. stageId .. " allyBaseX=" .. string.format("%.2f", self.AllyBaseX) .. " enemyBaseX=" .. string.format("%.2f", self.EnemyBaseX))
    end

    @ExecSpace("ServerOnly")
    method any GetPlayerData(string userId)
        -- Returns the PlayerData component of a user in this room, or nil.
        local user = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(user) then return nil end
        return user:GetComponent("script.PlayerData")
    end

    @ExecSpace("ServerOnly")
    method void Restart()
        -- Starts the same battle again after it has ended.
        if self.State ~= "ENDED" then return end
        self:StartBattle(self.PlayerUserId, self.StageId)
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- The battle clock: waits for the player, then fills both sides' cost while playing.
        if self.State == "WAITING" then
            self:TryStartForArrivedPlayer(delta)
            return
        end
        if self.State ~= "PLAYING" then return end
        self.Elapsed = self.Elapsed + delta
        for _, side in pairs(self._T.sides) do
            side:Tick(delta)
            self:TickBaseSkills(side)
        end
    end

    -- ===== Base skills (up to three per base) =====

    @ExecSpace("ServerOnly")
    method void TickBaseSkills(any side)
        -- Fires a side's base skills by themselves when they are automatic: a passive skill, or any skill of the stage
        -- AI's side. A player's active skill waits for UseBaseSkill. Nothing is cast while no enemy is on the field.
        ---@type BattleSide
        local s = side
        for index, skill in ipairs(s:GetBaseSkills()) do
            if s:IsBaseSkillReady(index) and (skill.type == "passive" or s.FreePlay) then
                local target = self:FindNearestEnemy(s.Team)
                if target == nil then return end
                local pos = target.Entity.TransformComponent.WorldPosition
                self:CastBaseSkill(s, index, pos.x, pos.y)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method any FindNearestEnemy(integer team)
        -- Returns the living enemy monster / build closest to this team's base (any floor), or nil when there is none.
        local baseX = self:GetBaseX(team)
        local best = nil
        local bestDist = nil
        for _, unit in ipairs(self._T.units) do
            if unit.Team ~= team and unit.Kind ~= "base" and unit.IsDead == false and isvalid(unit.Entity) then
                local dist = math.abs(unit.Entity.TransformComponent.WorldPosition.x - baseX)
                if bestDist == nil or dist < bestDist then
                    bestDist = dist
                    best = unit
                end
            end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method boolean UseBaseSkill(integer team, integer index, number targetX, number targetY)
        -- Player path: uses the side's active base skill in a slot at the target when its cooldown is over (no mana cost).
        if self.State ~= "PLAYING" then return false end
        ---@type BattleSide
        local side = self._T.sides[team]
        if side == nil then return false end
        local skill = side:GetBaseSkills()[index]
        if skill == nil or skill.type ~= "active" then return false end
        if side:IsBaseSkillReady(index) == false then
            log("[BattleDirector] team " .. tostring(team) .. " base skill " .. tostring(index) .. " not ready")
            return false
        end
        return self:CastBaseSkill(side, index, targetX, targetY)
    end

    @ExecSpace("ServerOnly")
    method boolean CastBaseSkill(any side, integer index, number targetX, number targetY)
        -- Runs a base skill exactly like a skill card played for free: the skill's own code, plus the effect on every
        -- client. Then that skill's cooldown starts. Returns true when it was cast.
        ---@type BattleSide
        local s = side
        local skill = s:GetBaseSkills()[index]
        if skill == nil then return false end
        local floorY = self:SnapFloorY(targetX, targetY)
        if self:PlayUnit(s.Team, skill.id, targetX, floorY, 1, 0) == false then return false end
        s:StartBaseSkillCooldown(index)
        self:NotifySkillCast(skill.id, targetX, floorY)
        log("[BattleDirector] base skill team=" .. tostring(s.Team) .. " slot=" .. tostring(index) .. " " .. skill.id .. " x=" .. string.format("%.1f", targetX) .. " floorY=" .. string.format("%.2f", floorY))
        return true
    end

    @ExecSpace("Multicast")
    method void NotifySkillCast(string unitId, number targetX, number floorY)
        -- Clients: show a skill's effect at the target (base skills have no hand card to trigger it).
        local cfg = _BattleConfig:GetUnit(unitId)
        if cfg == nil then return end
        _FieldFx:PlaySkillEffect(cfg, targetX, floorY)
    end

    -- ===== Cards =====

    @ExecSpace("ServerOnly")
    method boolean UseCard(integer team, integer handIndex, string unitId, number targetX, number targetY, integer portalIndex)
        -- Player path: plays the card in a hand slot. unitId is the card the client saw there; a mismatch (the hand
        -- changed in between) is rejected so a quick double tap never plays the card that replaced it.
        -- A monster comes out of the side's portal portalIndex; a build / skill goes to (targetX, targetY).
        -- Validates the cost, plays the card, then cycles it to the back of the queue. Returns true when played.
        if self.State ~= "PLAYING" then return false end
        ---@type BattleSide
        local side = self._T.sides[team]
        if side == nil then return false end
        local handId = side:GetHandIds()[handIndex]
        if handId == nil or handId == "" or handId ~= unitId then
            log("[BattleDirector] team " .. tostring(team) .. " hand slot " .. tostring(handIndex) .. " holds " .. tostring(handId) .. ", not " .. unitId .. " - rejected")
            return false
        end
        local cfg = _BattleConfig:GetUnit(unitId)
        if cfg == nil then return false end
        local reason = side:CheckCard(cfg)
        if reason ~= "" then
            log("[BattleDirector] team " .. tostring(team) .. " card " .. unitId .. " rejected: " .. reason)
            return false
        end
        if self:PlayUnit(team, unitId, targetX, targetY, side:GetUnitLevel(unitId), portalIndex) == false then return false end
        side:PayCard(cfg)
        side:CycleCard(handIndex)
        log("[BattleDirector] team " .. tostring(team) .. " card used slot=" .. tostring(handIndex) .. " " .. unitId .. " portal=" .. tostring(portalIndex) .. " cost=" .. string.format("%.0f", side.Cost))
        return true
    end

    @ExecSpace("ServerOnly")
    method table GetSpawnPoint(integer team, integer portalIndex)
        -- Returns where a team's monster appears: { x, floorY } of its portal portalIndex (0 or out of range = a random
        -- one). A map without portals for that team spawns in front of its base on the fallback ground height.
        local portals = self:GetPortals(team)
        if #portals == 0 then
            return { x = self:GetBaseX(team) + self:GetDirection(team) * _BattleConfig.SpawnOffsetX, floorY = self.GroundY }
        end
        local index = portalIndex
        if index < 1 or index > #portals then index = _UtilLogic:RandomIntegerRange(1, #portals) end
        return portals[index]
    end

    @ExecSpace("ServerOnly")
    method boolean PlayUnit(integer team, string unitId, number targetX, number targetY, integer level, integer portalIndex)
        -- Executes a card for a team at the given unit level, without cost checks
        -- (UseCard validates first; the stage AI and base skills call this directly).
        if self.State ~= "PLAYING" then return false end
        local cfg = _BattleConfig:GetUnitAtLevel(unitId, level)
        if cfg == nil then
            log_error("[BattleDirector] unknown unit " .. unitId)
            return false
        end
        if cfg.kind == "monster" then
            -- One card can bring several copies (SpawnCount): the first at once, the rest MultiSpawnInterval apart,
            -- each at the card's level and out of the same portal.
            local point = self:GetSpawnPoint(team, portalIndex)
            local spawnX = point.x
            local floorY = point.floorY
            if self:SpawnUnit(team, unitId, spawnX, floorY, cfg) == false then return false end
            for n = 2, cfg.spawnCount do
                _TimerService:SetTimerOnce(function()
                    if isvalid(self.Entity) and self.State == "PLAYING" then
                        self:SpawnUnit(team, unitId, spawnX, floorY, _BattleConfig:GetUnitAtLevel(unitId, level))
                    end
                end, _BattleConfig.MultiSpawnInterval * (n - 1))
            end
            if cfg.spawnCount > 1 then
                log("[BattleDirector] multi spawn " .. unitId .. " x" .. tostring(cfg.spawnCount) .. " every " .. tostring(_BattleConfig.MultiSpawnInterval) .. "s")
            end
            return true
        elseif cfg.kind == "build" then
            -- Builds go anywhere on the field: on the floor under the chosen point. A point with no floor under it is refused.
            local x = math.max(self.FieldMinX, math.min(self.FieldMaxX, targetX))
            local floorY = self:FindFloorY(x, targetY)
            if floorY == nil then
                log("[BattleDirector] build " .. unitId .. " refused: no floor under x=" .. string.format("%.2f", x) .. " y=" .. string.format("%.2f", targetY))
                return false
            end
            return self:SpawnUnit(team, unitId, x, floorY, cfg)
        elseif cfg.kind == "skill" then
            -- The effect starts on the clients right away; _BattleSkills runs what the skill does (its code entry),
            -- starting SkillHitDelay seconds later, at the moment the effect visually hits. It reaches the floor under the target.
            _BattleSkills:Cast(self, team, cfg, targetX, self:SnapFloorY(targetX, targetY))
            return true
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean PlayUnitAuto(integer team, string unitId, integer level)
        -- Stage AI path: plays a card where an AI would. A monster comes out of a random portal of the team, a build goes
        -- in front of a random portal, a skill lands on the enemy closest to the team's base (not cast when there is none).
        local cfg = _BattleConfig:GetUnit(unitId)
        if cfg == nil then
            log_error("[BattleDirector] unknown unit " .. tostring(unitId))
            return false
        end
        if cfg.kind == "build" then
            local point = self:GetSpawnPoint(team, 0)
            return self:PlayUnit(team, unitId, point.x + self:GetDirection(team) * _BattleConfig.BuildAutoOffset, point.floorY, level, 0)
        elseif cfg.kind == "skill" then
            local target = self:FindNearestEnemy(team)
            if target == nil then return false end
            local pos = target.Entity.TransformComponent.WorldPosition
            if self:PlayUnit(team, unitId, pos.x, pos.y, level, 0) == false then return false end
            self:NotifySkillCast(unitId, pos.x, self:SnapFloorY(pos.x, pos.y))
            return true
        end
        return self:PlayUnit(team, unitId, 0, 0, level, 0)
    end

    @ExecSpace("ServerOnly")
    method boolean SpawnUnit(integer team, string unitId, number spawnX, number floorY, table cfg)
        -- Spawns a monster or build standing on floorY at spawnX with the given (level-scaled) definition and registers it.
        -- Returns false on failure.
        self._T.seq = self._T.seq + 1
        local name = unitId .. "_" .. tostring(self._T.seq)
        local pos = Vector3(spawnX, floorY + _BattleConfig.SpawnYOffset, 0)
        -- From the pool when the map has one (a parked entity is reused, or the pool spawns a new one); else a direct spawn.
        local entity = nil
        ---@type EntityPool
        local pool = self:GetPool()
        if pool ~= nil then
            entity = pool:Acquire(self.UnitPoolKey, pos)
        else
            entity = _SpawnService:SpawnByModelId(self.UnitModelId, name, pos, self.Entity)
        end
        if entity == nil then
            log_error("[BattleDirector] spawn failed model=" .. self.UnitModelId)
            return false
        end
        ---@type BattleUnit
        local unit = entity:GetComponent("script.BattleUnit")
        if unit == nil then
            log_error("[BattleDirector] model has no BattleUnit: " .. self.UnitModelId)
            return false
        end
        unit:Setup(team, unitId, cfg, self)
        table.insert(self._T.units, unit)
        log("[BattleDirector] spawned " .. name .. " team=" .. tostring(team) .. " x=" .. string.format("%.2f", spawnX) .. " floorY=" .. string.format("%.2f", floorY) .. " units=" .. tostring(#self._T.units))
        return true
    end

    -- ===== Targets =====

    @ExecSpace("ServerOnly")
    method any FindTarget(integer team, number x, number y, number range)
        -- Returns what a unit of team standing at (x, y) can attack within range: the nearest living enemy monster /
        -- build on its floor, or the enemy base when an enemy portal on its floor is within range (the base is attacked
        -- through its portals; the portal itself is never a target). nil when there is nothing.
        local best = nil
        local bestDist = range
        for _, unit in ipairs(self._T.units) do
            if unit.Team ~= team and unit.Kind ~= "base" and unit.IsDead == false and isvalid(unit.Entity) then
                local pos = unit.Entity.TransformComponent.WorldPosition
                if self:SameFloor(pos.y, y) then
                    local dist = math.abs(pos.x - x)
                    if dist <= bestDist then
                        best = unit
                        bestDist = dist
                    end
                end
            end
        end
        local base = self._T.bases[3 - team]
        if base ~= nil and base.IsDead == false and base.Ready then
            local portal = self:FindPortalOnFloor(3 - team, x, y, range)
            if portal ~= nil and math.abs(portal.x - x) < bestDist then best = base end
            if portal ~= nil and best == nil then best = base end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method table FindTargetsInRange(integer team, number x, number y, number range)
        -- Returns every living target of the opposing team within range of (x, y) on that floor, for area attacks:
        -- monsters and builds, plus the enemy base when one of its portals on that floor is in range.
        local targets = {}
        for _, unit in ipairs(self._T.units) do
            if unit.Team ~= team and unit.Kind ~= "base" and unit.IsDead == false and isvalid(unit.Entity) then
                local pos = unit.Entity.TransformComponent.WorldPosition
                if self:SameFloor(pos.y, y) and math.abs(pos.x - x) <= range then table.insert(targets, unit) end
            end
        end
        local base = self._T.bases[3 - team]
        if base ~= nil and base.IsDead == false and base.Ready and self:FindPortalOnFloor(3 - team, x, y, range) ~= nil then
            table.insert(targets, base)
        end
        return targets
    end

    @ExecSpace("ServerOnly")
    method Vector2 GetAimPoint(integer team, any target, number x, number y)
        -- Returns the point a unit of team at (x, y) aims at to hit target: the target's own position, or for the enemy
        -- base the enemy portal on the attacker's floor (its x and floor height) that the attack goes through.
        if target.Kind == "base" then
            local portal = self:FindPortalOnFloor(target.Team, x, y, 100000)
            if portal ~= nil then return Vector2(portal.x, portal.floorY) end
        end
        local pos = target.Entity.TransformComponent.WorldPosition
        return Vector2(pos.x, pos.y)
    end

    @ExecSpace("ServerOnly")
    method void ShowPortalHit(integer baseTeam, number x, number y)
        -- A base was just damaged through its portal near (x, y): clients fly a particle from that portal to the base.
        -- One portal announces at most one hit per BattleConfig.PortalHitInterval seconds.
        local portal = self:FindPortalOnFloor(baseTeam, x, y, 100000)
        if portal == nil then return end
        local key = tostring(baseTeam) .. ":" .. tostring(portal.index)
        local last = self._T.portalHitAt[key]
        if last ~= nil and self.Elapsed - last < _BattleConfig.PortalHitInterval then return end
        self._T.portalHitAt[key] = self.Elapsed
        self:NotifyPortalHit(baseTeam, portal.index)
    end

    @ExecSpace("Multicast")
    method void NotifyPortalHit(integer baseTeam, integer portalIndex)
        -- Clients: an attack on baseTeam's base went through its portal portalIndex (presentation only).
        _BattleFx:OnPortalHit(self, baseTeam, portalIndex)
    end

    @ExecSpace("ServerOnly")
    method void RemoveUnit(any deadUnit)
        -- Unregisters a dead unit.
        local units = self._T.units
        for i = #units, 1, -1 do
            if units[i] == deadUnit then table.remove(units, i) end
        end
    end

    @ExecSpace("ServerOnly")
    method void SettleResult()
        -- Campaign settlement: a win pays the stage's reward and records the clear; a loss pays nothing.
        ---@type BattleSide
        local side = self:GetSideByUser(self.PlayerUserId)
        ---@type PlayerData
        local data = self:GetPlayerData(self.PlayerUserId)
        if side == nil or data == nil then return end
        local won = self.WinnerTeam == side.Team
        local reward = 0
        local chestId = ""
        local stage = _BattleConfig:GetStage(self.StageId)
        if won and stage ~= nil then
            reward = math.floor(stage.rewardMeso)
            chestId = stage.rewardChest
        end
        self.RewardMeso = reward
        self.RewardChest = chestId
        self.RewardCardsCsv = data:GrantBattleResult(self.StageId, reward, chestId, won)
    end

    @ExecSpace("ServerOnly")
    method void OnBaseDestroyed(integer team)
        -- Ends the battle: the team whose base fell loses, the other team wins.
        if self.State ~= "PLAYING" then return end
        self.WinnerTeam = 3 - team
        ---@type StageAI
        local ai = self.Entity:GetComponent("script.StageAI")
        if ai ~= nil then ai:Stop() end
        for _, unit in ipairs(self._T.units) do unit:Halt() end
        -- Settle first so the reward is already set when clients see the ENDED state.
        self:SettleResult()
        self.State = "ENDED"
        log("[BattleDirector] battle ended winner=team " .. tostring(self.WinnerTeam) .. " elapsed=" .. string.format("%.1f", self.Elapsed))
    end

end
