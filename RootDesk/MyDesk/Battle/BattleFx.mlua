@Logic
script BattleFx extends Logic

    property string HpBarModelId = "battlehpbar"
    property string ProjectileModelId = "battleprojectile"
    property integer BarCells = 16
    property number BarHeight = 0.12
    property number DefaultBarWidth = 0.8
    property number DefaultBarY = 0.8
    property number PixelUnit = 0.01
    -- "current/max" HP number above each base tower's bar (client-local text entity).
    -- World text sizes in world units (not UI pixels): 16 filled the whole screen, so start near 1.5 and tune by eye.
    property number HpTextFontSize = 1.5
    property number HpTextWidth = 2
    property number HpTextHeight = 0.4
    property number HpTextGap = 0.02
    property number ProjectileAimY = 0.35
    -- false = no HP bar above monsters and builds (the base towers always keep theirs).
    property boolean ShowUnitBars = false
    -- Hit feedback shared by every unit: the sprite blinks white for a moment when the unit loses HP.
    -- A sprite's Color only multiplies (it cannot turn a sprite white), so the blink swaps the sprite's material:
    -- HitFlashMaterial (shader ColorEffect > ColorOverride, white) while blinking, UnitMaterial (shader Default) after.
    -- Both are materials in the workspace, found by name. Without them a hit plays its sound only.
    property number HitFlashSeconds = 0.08
    property string HitFlashMaterial = "HitFlash"
    property string UnitMaterial = "UnitDefault"
    property number UnitSoundVolume = 0.5
    -- Effect icons above a unit's head: small pixel glyphs (one per effect type) drawn with the HP bar model.
    property number IconSize = 0.22
    property number IconGap = 0.04
    property number IconPixels = 8

    @ExecSpace("ClientOnly")
    method void RegisterUnit(BattleUnit unit)
        -- Starts tracking a battle unit on this client; its HP bar is created once its synced state arrives.
        local recs = self._T.recs
        if recs == nil then
            recs = {}
            self._T.recs = recs
        end
        local rec = { unit = unit, entity = unit.Entity, name = unit.Entity.Name, hitLogged = false, shotLogged = false }
        unit._T.fx = rec
        table.insert(recs, rec)
    end

    @ExecSpace("ClientOnly")
    method void UnregisterUnit(BattleUnit unit)
        -- Stops tracking a unit that left play and removes its HP bar.
        local rec = unit._T.fx
        if rec == nil then return end
        unit._T.fx = nil
        -- A unit taken away in the middle of a hit blink (a pooled entity is reused) gets its normal material back.
        if rec.flashRemain ~= nil then self:EndFlash(rec) end
        self:RemoveBar(rec, "unit removed")
        local recs = self._T.recs
        if recs == nil then return end
        for i = #recs, 1, -1 do
            if recs[i] == rec then table.remove(recs, i) end
        end
    end

    @ExecSpace("ClientOnly")
    method void EnsureBar(table rec)
        -- Creates the client-local HP bar entity for a unit as soon as its team, unit id and HP are known.
        ---@type BattleUnit
        local unit = rec.unit
        if rec.barFailed == true or unit.Team == 0 or unit.UnitId == "" or unit.Hp <= 0 then return end
        local cfg = _BattleConfig:GetUnit(unit.UnitId)
        if cfg == nil then return end
        local map = rec.entity.CurrentMap
        if not isvalid(map) then return end
        -- Monsters and builds carry no bar (user decision 2026-10-07); only the base towers keep one.
        -- The unit is still tracked for hit feedback and effect icons.
        if cfg.kind ~= "base" and self.ShowUnitBars == false then
            rec.offsetY = (cfg.barY or self.DefaultBarY) * _BattleConfig.UnitScale
            rec.lastHp = unit.Hp
            rec.ready = true
            return
        end

        local seq = (self._T.seq or 0) + 1
        self._T.seq = seq
        local offsetY = (cfg.barY or self.DefaultBarY) * _BattleConfig.UnitScale
        local pos = rec.entity.TransformComponent.WorldPosition
        local bar = _SpawnService:SpawnByModelId(self.HpBarModelId, "HpBar_" .. tostring(seq), Vector3(pos.x, pos.y + offsetY, 0), map)
        local pixel = nil
        if isvalid(bar) then pixel = bar.PixelRendererComponent end
        if not isvalid(pixel) then
            rec.barFailed = true
            log_error("[BattleFx] hp bar spawn failed for " .. rec.name .. " model=" .. self.HpBarModelId)
            return
        end

        local width = self.BarCells + 2
        local height = 4
        pixel:ResetWithColor(width, height, Color(0, 0, 0, 0.9))
        pixel.SortingLayer = "MapLayer0"
        pixel.OrderInLayer = 10
        local barWidth = (cfg.barWidth or self.DefaultBarWidth) * _BattleConfig.UnitScale
        bar.TransformComponent.Scale = Vector3(barWidth / (width * self.PixelUnit), self.BarHeight / (height * self.PixelUnit), 1)

        rec.bar = bar
        rec.pixel = pixel
        rec.offsetY = offsetY
        rec.px = pos.x
        rec.py = pos.y
        rec.filled = nil
        rec.lastHp = unit.Hp
        rec.ready = true
        self:CreateHpText(rec, map, pos)
        self:DrawBar(rec)
        log("[BattleFx] hp bar created " .. rec.name .. " team=" .. tostring(unit.Team) .. " hp=" .. tostring(unit.Hp) .. "/" .. tostring(unit.MaxHp))
    end

    @ExecSpace("ClientOnly")
    method void CreateHpText(table rec, Entity map, Vector3 pos)
        -- Spawns the client-local "current/max" HP number that sits just above the unit's bar.
        local seq = (self._T.seq or 0) + 1
        self._T.seq = seq
        local label = _SpawnService:SpawnByModelId(self.HpBarModelId, "HpText_" .. tostring(seq), self:HpTextPosition(rec, pos), map)
        if not isvalid(label) then
            log_error("[BattleFx] hp text spawn failed for " .. rec.name)
            return
        end
        -- The spawned model only serves as a bare client entity; its own pixel bar is made fully transparent.
        local pixel = label.PixelRendererComponent
        if isvalid(pixel) then pixel:ResetWithColor(1, 1, Color(0, 0, 0, 0)) end
        label.TransformComponent.Scale = Vector3(1, 1, 1)
        ---@type TextRendererComponent
        local text = label:AddComponent("TextRendererComponent")
        if not isvalid(text) then
            label:Destroy()
            log_error("[BattleFx] hp text component failed for " .. rec.name)
            return
        end
        text.FontSize = self.HpTextFontSize
        text.FontColor = Color(1, 1, 1, 1)
        text.OutlineColor = Color(0, 0, 0, 1)
        text.OutlineWidth = 0.2
        text.RectSize = Vector2(self.HpTextWidth, self.HpTextHeight)
        text.SortingLayer = "MapLayer0"
        text.OrderInLayer = 12
        rec.hpLabel = label
        rec.hpText = text
        rec.hpShown = nil
    end

    @ExecSpace("ClientOnly")
    method Vector3 HpTextPosition(table rec, Vector3 pos)
        -- World position of the HP number: centered above the bar of the unit standing at pos.
        local y = pos.y + (rec.offsetY or 0) + self.BarHeight * 0.5 + self.HpTextGap + self.HpTextHeight * 0.5
        return Vector3(pos.x, y, 0)
    end

    @ExecSpace("ClientOnly")
    method void UpdateHpText(table rec)
        -- Rewrites the HP number when the unit's synced Hp / MaxHp changed.
        local text = rec.hpText
        if text == nil or not isvalid(text) then return end
        ---@type BattleUnit
        local unit = rec.unit
        local shown = tostring(math.floor(math.max(0, unit.Hp))) .. "/" .. tostring(math.floor(unit.MaxHp))
        if shown == rec.hpShown then return end
        rec.hpShown = shown
        text.Text = shown
        log("[VRF] [BattleFx] hp text " .. rec.name .. " " .. shown)
    end

    @ExecSpace("ClientOnly")
    method void DrawBar(table rec)
        -- Repaints the bar pixels from the unit's synced Hp / MaxHp; allies are green, enemies red.
        local pixel = rec.pixel
        if pixel == nil then return end
        self:UpdateHpText(rec)
        ---@type BattleUnit
        local unit = rec.unit
        local ratio = 0
        if unit.MaxHp > 0 then ratio = math.max(0, math.min(1, unit.Hp / unit.MaxHp)) end
        local cells = self.BarCells
        local filled = math.ceil(ratio * cells)
        if filled == rec.filled then return end
        rec.filled = filled

        local border = Color(0, 0, 0, 0.9)
        local empty = Color(0.2, 0.2, 0.22, 0.9)
        local fill = Color(0.95, 0.27, 0.22, 1)
        if unit.Team == 1 then fill = Color(0.3, 0.9, 0.35, 1) end
        local width = cells + 2
        local height = 4
        local pixels = {}
        for y = 1, height do
            for x = 1, width do
                local color = border
                if x > 1 and x < width and y > 1 and y < height then
                    if x - 1 <= filled then
                        color = fill
                    else
                        color = empty
                    end
                end
                pixels[(y - 1) * width + x] = color
            end
        end
        pixel:SetPixels(pixels)
    end

    @ExecSpace("ClientOnly")
    method void RemoveBar(table rec, string reason)
        -- Destroys a unit's HP bar entity.
        self:RemoveIcons(rec)
        local bar = rec.bar
        if bar == nil then return end
        if rec.hpLabel ~= nil then
            if isvalid(rec.hpLabel) then rec.hpLabel:Destroy() end
            rec.hpLabel = nil
            rec.hpText = nil
        end
        rec.bar = nil
        rec.pixel = nil
        rec.filled = nil
        if isvalid(bar) then bar:Destroy() end
        log("[BattleFx] hp bar removed " .. rec.name .. " (" .. reason .. ")")
    end

    @ExecSpace("ClientOnly")
    method table GetIconGlyph(string kind)
        -- Returns the 8x8 glyph of an effect id: { color, rows } where "#" is a lit pixel. nil = no icon.
        local glyphs = self._T.glyphs
        if glyphs == nil then
            glyphs = {
                -- nullify: red cross
                nullify = { color = Color(1, 0.3, 0.3, 1), rows = {
                    "#......#", ".#....#.", "..#..#..", "...##...", "...##...", "..#..#..", ".#....#.", "#......#" } },
                -- curse: purple diamond with a hollow center
                curse = { color = Color(0.75, 0.4, 1, 1), rows = {
                    "...##...", "..####..", ".##..##.", "##....##", "##....##", ".##..##.", "..####..", "...##..." } },
                -- warp: cyan ring
                warp = { color = Color(0.4, 0.9, 1, 1), rows = {
                    "..####..", ".#....#.", "#......#", "#......#", "#......#", "#......#", ".#....#.", "..####.." } },
                -- blow: orange arrow pointing back (left; the glyph is mirrored for the other team)
                -- icy: light blue snowflake
                icy = { color = Color(0.6, 0.9, 1, 1), rows = {
                    "#..#..#.", ".#.#.#..", "..###...", "#######.", "..###...", ".#.#.#..", "#..#..#.", "........" } },
                -- poison: green drop
                poison = { color = Color(0.45, 0.95, 0.3, 1), rows = {
                    "...#....", "...#....", "..###...", "..###...", ".#####..", ".#####..", "..###...", "........" } },
                blow = { color = Color(1, 0.65, 0.2, 1), rows = {
                    "...#....", "..##....", ".#######", "########", "########", ".#######", "..##....", "...#...." } },
            }
            self._T.glyphs = glyphs
        end
        return glyphs[kind]
    end

    @ExecSpace("ClientOnly")
    method void UpdateIcons(table rec)
        -- Keeps the effect icons above a unit in step with its synced StatusCsv: creates icons for new effects,
        -- removes expired ones (by the synced end time) and moves them with the unit.
        ---@type BattleUnit
        local unit = rec.unit
        local csv = unit.StatusCsv
        local icons = rec.icons
        if icons == nil then
            icons = {}
            rec.icons = icons
        end
        local now = _UtilLogic.ServerElapsedSeconds
        if csv ~= rec.statusCsv then
            rec.statusCsv = csv
            local wanted = {}
            for kind, endAt in string.gmatch(csv, "([^,:]+):([^,]+)") do wanted[kind] = tonumber(endAt) or 0 end
            for kind, icon in pairs(icons) do
                if wanted[kind] == nil then self:RemoveIcon(rec, kind) end
            end
            for kind, endAt in pairs(wanted) do
                if icons[kind] == nil then self:CreateIcon(rec, kind, endAt) else icons[kind].endAt = endAt end
            end
        end
        local index = 0
        local count = 0
        for _, _ in pairs(icons) do count = count + 1 end
        if count == 0 then return end
        local pos = rec.entity.TransformComponent.WorldPosition
        local step = self.IconSize + self.IconGap
        local startX = pos.x - (count - 1) * step * 0.5
        local y = pos.y + (rec.offsetY or self.DefaultBarY * _BattleConfig.UnitScale) + self.BarHeight + self.IconSize * 0.5 + 0.03
        for kind, icon in pairs(icons) do
            if icon.endAt <= now then
                self:RemoveIcon(rec, kind)
            elseif isvalid(icon.entity) then
                icon.entity.TransformComponent.WorldPosition = Vector3(startX + index * step, y, 0)
                index = index + 1
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void CreateIcon(table rec, string kind, number endAt)
        -- Spawns the client-local pixel icon of one effect above the unit.
        local glyph = self:GetIconGlyph(kind)
        local map = rec.entity.CurrentMap
        if glyph == nil or not isvalid(map) then return end
        local seq = (self._T.seq or 0) + 1
        self._T.seq = seq
        local pos = rec.entity.TransformComponent.WorldPosition
        local icon = _SpawnService:SpawnByModelId(self.HpBarModelId, "Icon_" .. tostring(seq), Vector3(pos.x, pos.y + 1, 0), map)
        local pixel = nil
        if isvalid(icon) then pixel = icon.PixelRendererComponent end
        if not isvalid(pixel) then
            log_error("[BattleFx] effect icon spawn failed for " .. rec.name .. " kind=" .. kind)
            return
        end
        local n = self.IconPixels
        pixel:ResetWithColor(n, n, Color(0, 0, 0, 0.75))
        pixel.SortingLayer = "MapLayer0"
        pixel.OrderInLayer = 11
        -- Allies face right, so their "back" is to the left; enemies are mirrored.
        local mirror = rec.unit.Team ~= 1
        local pixels = {}
        for y = 1, n do
            local row = glyph.rows[y] or ""
            for x = 1, n do
                local sx = x
                if mirror then sx = n + 1 - x end
                local lit = string.sub(row, sx, sx) == "#"
                pixels[(y - 1) * n + x] = lit and glyph.color or Color(0, 0, 0, 0.75)
            end
        end
        pixel:SetPixels(pixels)
        local scale = self.IconSize / (n * self.PixelUnit)
        icon.TransformComponent.Scale = Vector3(scale, scale, 1)
        rec.icons[kind] = { entity = icon, endAt = endAt }
        log("[BattleFx] effect icon " .. kind .. " on " .. rec.name .. " until " .. string.format("%.1f", endAt))
    end

    @ExecSpace("ClientOnly")
    method void RemoveIcon(table rec, string kind)
        -- Destroys one effect icon of a unit.
        local icon = rec.icons[kind]
        if icon == nil then return end
        rec.icons[kind] = nil
        if isvalid(icon.entity) then icon.entity:Destroy() end
        log("[BattleFx] effect icon " .. kind .. " removed from " .. rec.name)
    end

    @ExecSpace("ClientOnly")
    method void RemoveIcons(table rec)
        -- Destroys every effect icon of a unit.
        if rec.icons == nil then return end
        for kind, _ in pairs(rec.icons) do self:RemoveIcon(rec, kind) end
    end

    @ExecSpace("ClientOnly")
    method void OnUnitHpSync(BattleUnit unit)
        -- Reacts to a synced Hp / MaxHp change: hit feedback when Hp dropped, bar repaint, bar removal on death.
        local rec = unit._T.fx
        if rec == nil or rec.ready ~= true then return end
        local hp = unit.Hp
        local prev = rec.lastHp
        rec.lastHp = hp
        if prev ~= nil and hp < prev then self:PlayHit(rec, prev, hp) end
        if hp <= 0 then
            local cfg = _BattleConfig:GetUnit(unit.UnitId)
            if cfg ~= nil and cfg.dieSoundRuid ~= nil then _BattleSound:PlayRuid(cfg.dieSoundRuid, self.UnitSoundVolume) end
            self:RemoveBar(rec, "dead")
        else
            self:DrawBar(rec)
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayHit(table rec, number prevHp, number hp)
        -- Hit feedback: the unit blinks white for a moment and its damage sound plays (the shared hit sound
        -- when the unit has none). Only the first hit of each unit is logged.
        local sprite = rec.entity.SpriteRendererComponent
        local flashed = false
        if isvalid(sprite) and self:FindFlashMaterials() then
            sprite:ChangeMaterial(self._T.flashMaterialId)
            rec.flashRemain = self.HitFlashSeconds
            flashed = true
        end
        ---@type BattleUnit
        local unit = rec.unit
        local cfg = _BattleConfig:GetUnit(unit.UnitId)
        local sound = "hit"
        if cfg ~= nil and cfg.damageSoundRuid ~= nil then
            sound = cfg.damageSoundRuid
            _BattleSound:PlayRuid(cfg.damageSoundRuid, self.UnitSoundVolume)
        else
            _BattleSound:Play("hit")
        end
        if rec.hitLogged == false then
            rec.hitLogged = true
            log("[BattleFx] first hit " .. rec.name .. " hp " .. tostring(prevHp) .. "->" .. tostring(hp) .. " flash=" .. tostring(flashed) .. " sound=" .. sound)
        end
    end

    @ExecSpace("ClientOnly")
    method boolean FindFlashMaterials()
        -- Looks up the two blink materials by name once; returns true when both exist in the workspace.
        if self._T.flashLookedUp ~= true then
            self._T.flashLookedUp = true
            local flashId = _EntryService:GetMaterialIdByName(self.HitFlashMaterial)
            local unitId = _EntryService:GetMaterialIdByName(self.UnitMaterial)
            local found = flashId ~= nil and flashId ~= "" and unitId ~= nil and unitId ~= ""
            if found then
                self._T.flashMaterialId = flashId
                self._T.unitMaterialId = unitId
            end
            self._T.flashReady = found
            log("[BattleFx] hit flash materials " .. self.HitFlashMaterial .. "=" .. tostring(flashId) .. " " .. self.UnitMaterial .. "=" .. tostring(unitId) .. " ready=" .. tostring(found))
        end
        return self._T.flashReady == true
    end

    @ExecSpace("ClientOnly")
    method void EndFlash(table rec)
        -- Returns a blinking unit's sprite to its normal material.
        rec.flashRemain = nil
        if not isvalid(rec.entity) then return end
        local sprite = rec.entity.SpriteRendererComponent
        if isvalid(sprite) then sprite:ChangeMaterial(self._T.unitMaterialId) end
    end

    @ExecSpace("ClientOnly")
    method void OnAttackFired(BattleUnit attacker, Entity target, number travelTime)
        -- An attack started: plays the attacker's attack effect and attack sound, and for a unit with a
        -- projectile spawns a client-local projectile that flies to the target during the hit delay.
        local cfg = _BattleConfig:GetUnit(attacker.UnitId)
        if cfg == nil then return end
        local source = attacker.Entity
        if not isvalid(source) then return end
        local fx = attacker._T.fx
        if cfg.attackEffectRuid ~= nil then
            -- Attached to the attacker, so the effect follows its size and facing. The offset columns are world units on
            -- screen (X forward, Y up from the feet), so they are divided by the unit's own size; the unit's flipped
            -- x scale (-dir * size) turns local -x into "forward" for both teams.
            local size = cfg.scale * _BattleConfig.UnitScale
            if size <= 0 then size = 1 end
            local fxScale = cfg.attackEffectScale
            if fxScale == nil or fxScale <= 0 then fxScale = 1 end
            local offset = Vector3(-cfg.attackEffectOffsetX / size, cfg.attackEffectOffsetY / size, 0)
            local serial = _EffectService:PlayEffectAttached(cfg.attackEffectRuid, source, offset, 0, Vector3(fxScale, fxScale, 1), false)
            if fx ~= nil and fx.attackFxLogged ~= true then
                fx.attackFxLogged = true
                log("[BattleFx] attack effect " .. source.Name .. " ruid=" .. cfg.attackEffectRuid .. " serial=" .. tostring(serial))
            end
        end
        if cfg.attackSoundRuid ~= nil then _BattleSound:PlayRuid(cfg.attackSoundRuid, self.UnitSoundVolume) end
        if cfg.projectileRuid == nil or not isvalid(target) then return end
        local map = source.CurrentMap
        if not isvalid(map) then return end

        local seq = (self._T.seq or 0) + 1
        self._T.seq = seq
        local from = source.TransformComponent.WorldPosition
        local to = target.TransformComponent.WorldPosition
        local startY = from.y + (cfg.projectileY or self.ProjectileAimY) * _BattleConfig.UnitScale
        local shot = _SpawnService:SpawnByModelId(self.ProjectileModelId, "Shot_" .. tostring(seq), Vector3(from.x, startY, 0), map)
        if not isvalid(shot) then
            log_error("[BattleFx] projectile spawn failed model=" .. self.ProjectileModelId)
            return
        end
        -- Projectile sprites face left: flip when flying to the right.
        local size = (cfg.projectileScale or 1) * _BattleConfig.UnitScale
        local dir = 1
        if to.x < from.x then dir = -1 end
        shot.SpriteRendererComponent.SpriteRUID = cfg.projectileRuid
        shot.TransformComponent.Scale = Vector3(-dir * size, size, 1)

        local rec = attacker._T.fx
        local logged = rec ~= nil and rec.shotLogged == false
        if logged then
            rec.shotLogged = true
            log("[BattleFx] projectile spawned " .. source.Name .. " -> " .. target.Name .. " time=" .. string.format("%.2f", travelTime) .. " ruid=" .. cfg.projectileRuid)
        end
        local shots = self._T.shots
        if shots == nil then
            shots = {}
            self._T.shots = shots
        end
        table.insert(shots, {
            entity = shot, target = target, name = source.Name, logged = logged,
            sx = from.x, sy = startY, tx = to.x, ty = to.y + self.ProjectileAimY * _BattleConfig.UnitScale,
            elapsed = 0, duration = math.max(0.1, travelTime),
        })
    end

    @ExecSpace("ClientOnly")
    method void OnAttackHit(BattleUnit attacker, Entity target)
        -- An attack landed: plays the attacker's hit effect (UnitTable HitEffectRuid) on the unit it damaged.
        -- The effect is attached to the target so it follows a knocked-back unit, but its size and facing are the
        -- attacker's (the target's own scale is divided out), at the height projectiles aim for.
        local cfg = _BattleConfig:GetUnit(attacker.UnitId)
        if cfg == nil or cfg.hitEffectRuid == nil or not isvalid(target) then return end
        local parentScale = target.TransformComponent.Scale
        if parentScale.x == 0 or parentScale.y == 0 then return end
        local size = cfg.scale * _BattleConfig.UnitScale
        -- Clips face left by default, like the unit sprites: mirrored when the attacker advances to the right.
        local localScale = Vector3(-attacker:GetDirection() * size / parentScale.x, size / parentScale.y, 1)
        local localY = self.ProjectileAimY * _BattleConfig.UnitScale / parentScale.y
        local serial = _EffectService:PlayEffectAttached(cfg.hitEffectRuid, target, Vector3(0, localY, 0), 0, localScale, false)
        local fx = attacker._T.fx
        if fx ~= nil and fx.hitFxLogged ~= true then
            fx.hitFxLogged = true
            log("[VRF] BattleFx hit effect " .. attacker.Entity.Name .. " -> " .. target.Name .. " ruid=" .. cfg.hitEffectRuid .. " serial=" .. tostring(serial))
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Keeps HP bars above their units and advances projectiles. Nothing is written for units that stand still.
        local recs = self._T.recs
        if recs ~= nil then
            for i = #recs, 1, -1 do
                local rec = recs[i]
                if not isvalid(rec.entity) then
                    self:RemoveBar(rec, "unit removed")
                    table.remove(recs, i)
                else
                    if rec.flashRemain ~= nil then
                        rec.flashRemain = rec.flashRemain - delta
                        if rec.flashRemain <= 0 then self:EndFlash(rec) end
                    end
                    if rec.ready ~= true then self:EnsureBar(rec) end
                    self:UpdateIcons(rec)
                    if rec.bar ~= nil then
                        local pos = rec.entity.TransformComponent.WorldPosition
                        if pos.x ~= rec.px or pos.y ~= rec.py then
                            rec.px = pos.x
                            rec.py = pos.y
                            rec.bar.TransformComponent.WorldPosition = Vector3(pos.x, pos.y + rec.offsetY, 0)
                            if isvalid(rec.hpLabel) then rec.hpLabel.TransformComponent.WorldPosition = self:HpTextPosition(rec, pos) end
                        end
                    end
                end
            end
        end

        local shots = self._T.shots
        if shots ~= nil then
            for i = #shots, 1, -1 do
                local shot = shots[i]
                shot.elapsed = shot.elapsed + delta
                if isvalid(shot.target) then
                    local to = shot.target.TransformComponent.WorldPosition
                    shot.tx = to.x
                    shot.ty = to.y + self.ProjectileAimY * _BattleConfig.UnitScale
                end
                local k = math.min(1, shot.elapsed / shot.duration)
                if k >= 1 or not isvalid(shot.entity) then
                    if isvalid(shot.entity) then shot.entity:Destroy() end
                    if shot.logged then log("[BattleFx] projectile arrived " .. shot.name) end
                    table.remove(shots, i)
                else
                    shot.entity.TransformComponent.WorldPosition = Vector3(shot.sx + (shot.tx - shot.sx) * k, shot.sy + (shot.ty - shot.sy) * k, 0)
                end
            end
        end
    end

end
