@Logic
script BattleConfig extends Logic

    -- Read-only access point for battle definitions. Unit, level, stage and wave data live in the
    -- datasets under Data/ (UnitTable, UnitLevelTable, StageTable, StageWaveTable); this script only
    -- loads and caches them. World-wide tuning knobs stay here as properties.
    -- Fallback ground height; each stage map has its own in StageTable (GroundY), exposed as BattleDirector.GroundY.
    property number GroundY = -1.36
    -- Units appear standing at the spawn portal, just above the ground (no drop from the air).
    property number SpawnYOffset = 0.03
    -- Global scale knobs. Unit sizes, distances and speeds in the unit table are authored at scale 1
    -- and multiplied by these, so the whole battlefield can be resized with three numbers.
    property number UnitScale = 0.65
    property number RangeScale = 0.65
    property number SpeedScale = 0.5
    -- Units spawn this far in front of their base tower. Tower positions are read from the map entities.
    property number SpawnOffsetX = 1.0
    -- Half of the visible screen width in world units (PC) and the margin kept outside each tower.
    property number ScreenHalfWidth = 6.4
    property number FieldMargin = 1.0
    -- Cost at battle start and base income per second. The cost cap and the income multiplier come from
    -- the side's in-battle cost level (CostLevelTable). How far a side may raise that level (the mana level cap) comes from its
    -- base: the base's ManaLevelStart plus the upgrade level's ManaLevelBonus (BaseLevelTable); DefaultCostLevelCap is the fallback.
    property number CostStart = 100
    property number CostPerSecond = 20
    property integer DefaultCostLevelCap = 3
    -- The base every player owns from the start and every stage's enemy uses unless the stage names another (UnitTable id, Kind = base).
    property string DefaultBaseId = "base"
    -- Knockback shared by every monster unless its UnitTable row says otherwise: HP lost (percent of max) per
    -- knockback, how far it is pushed (authored units, scaled by RangeScale) and how long the push lasts.
    property number KnockbackHpPercent = 34
    property number KnockbackDistance = 0.8
    property number KnockbackSeconds = 0.45
    -- A knockback is a physics impulse (RigidbodyComponent:SetForce): horizontal force per world unit of distance,
    -- plus a small upward lift so the unit hops back. Calibrated by measurement; see As-built.
    property number KnockbackForcePerUnit = 12.5
    property number KnockbackLift = 2
    -- Attribute advantage: an attack on a unit whose attribute the attacker beats deals this much more damage
    -- (0.2 = +20%). Light and dark beat each other; wind beats water, water beats fire, fire beats earth, earth beats
    -- wind. There is no penalty the other way round, and units without an attribute (builds, bases) get no bonus.
    property number AttributeBonus = 0.2
    -- Shortest time an effect icon stays above a unit's head (client), so a short push is still readable.
    property number StatusIconMinSeconds = 1.0
    property integer DeckSize = 10
    -- Cards in hand during a battle. The deck is shuffled into a queue; the hand holds the front cards and a played
    -- card goes to the back of the queue while the next queued card takes its hand slot. There are no cooldowns.
    property integer HandSize = 5
    -- Seconds after a unit dies before the server takes its entity away. Clients hide it themselves at the end of its
    -- die clip, so this only has to be longer than the longest die clip.
    property number DieReleaseSeconds = 2.0
    -- After its die clip ends, every unit fades out (sprite alpha 1 -> 0) over this many seconds on the clients.
    -- Die clip + fade must stay shorter than DieReleaseSeconds.
    property number DeathFadeSeconds = 0.6
    -- A monster card with SpawnCount > 1 (UnitTable) puts its copies on the field this many seconds apart; the first at once.
    property number MultiSpawnInterval = 0.25
    -- Currency (CurrencyTable id) paid to enter a campaign stage; the amount is the stage's EntryCost.
    property string EntryCurrencyId = "ticket"
    -- Paid currency (CurrencyTable id, 골드리치 주화) bought with Worldcoin; shown in the lobby top bar.
    property string PremiumCurrencyId = "premium"
    -- Base summon stone: what every rarity's stone (ChestTable row) inherits unless the row overrides it.
    -- A row's blank IconRuid uses SummonStoneIconRuid; its Rarity picks the frame color.
    property string SummonStoneIconRuid = "c82b597d498746738bb87a9531e32e53"
    -- Animation clip played behind the revealed card when a stone is used.
    property string SummonEffectRuid = "630c802568f543c0bb85e041db0aed4d"
    -- How long the effect plays before the first card shows.
    property number SummonRevealDelay = 1.0

    method number Num(string text, number fallback)
        -- Converts a dataset cell to a number; blank or invalid cells give the fallback.
        if text == nil or text == "" then return fallback end
        return tonumber(text) or fallback
    end

    method any OptNum(string text)
        -- Converts an optional dataset cell to a number, or nil when the cell is blank.
        if text == nil or text == "" then return nil end
        return tonumber(text)
    end

    method any OptText(string text)
        -- Returns an optional dataset cell, or nil when the cell is blank.
        if text == nil or text == "" then return nil end
        return text
    end

    method table GetUnits()
        -- Returns every unit definition keyed by unit id (monster / build / skill / base), loaded once from UnitTable.
        -- Optional presentation fields (client only): barY / barWidth, projectileRuid / projectileScale, effectRuid / effectScale.
        local units = self._T.units
        if units ~= nil then return units end
        units = {}
        local ds = _DataService:GetTable("UnitTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local id = ds:GetCell(i, "UnitId")
            if id ~= nil and id ~= "" then
                local kind = ds:GetCell(i, "Kind")
                local projectileRuid = self:OptText(ds:GetCell(i, "ProjectileRuid"))
                -- Attack type of a monster / build: melee, ranged, melee_area or ranged_area.
                -- A blank cell falls back to ranged when the unit has a projectile, melee otherwise.
                local attackType = self:OptText(ds:GetCell(i, "AttackType")) or ""
                if attackType == "" and (kind == "monster" or kind == "build") then
                    attackType = projectileRuid ~= nil and "ranged" or "melee"
                end
                units[id] = {
                    id = id,
                    kind = kind,
                    attackType = attackType,
                    areaAttack = self:IsAreaAttackType(attackType),
                    -- Monsters only: attribute (earth / water / fire / wind / light / dark) and its knockback: every time
                    -- it has lost another KnockbackHpPercent of its max HP it is pushed back while its hit clip plays.
                    -- Monsters and builds: the effects a unit uses are its rows in UnitEffectTable (see GetUnitEffects).
                    attribute = self:OptText(ds:GetCell(i, "Attribute")) or "",
                    hitRuid = self:OptText(ds:GetCell(i, "HitRuid")) or "",
                    knockbackHpPercent = self:Num(ds:GetCell(i, "KnockbackHpPercent"), self.KnockbackHpPercent),
                    knockbackDistance = self:Num(ds:GetCell(i, "KnockbackDistance"), self.KnockbackDistance),
                    knockbackSeconds = self:Num(ds:GetCell(i, "KnockbackSeconds"), self.KnockbackSeconds),
                    name = ds:GetCell(i, "Name"),
                    -- One-line flavor text shown in the lobby's unit info popup (no game rule reads it). "" = none.
                    desc = self:OptText(ds:GetCell(i, "Desc")) or "",
                    rarity = self:OptText(ds:GetCell(i, "Rarity")) or "normal",
                    cost = self:Num(ds:GetCell(i, "Cost"), 0),
                    starter = self:Num(ds:GetCell(i, "Starter"), 0) > 0,
                    order = i,
                    maxHp = self:Num(ds:GetCell(i, "MaxHp"), 1),
                    attack = self:Num(ds:GetCell(i, "Attack"), 0),
                    range = self:Num(ds:GetCell(i, "Range"), 0),
                    -- ranged_area only: radius (authored units, scaled by RangeScale) of the blast around the attacked target.
                    areaRadius = self:Num(ds:GetCell(i, "AttackAreaRadius"), 1),
                    -- Area attacks: most units one attack can hit (nearest to the blast center first); 0 = no limit.
                    maxTargets = math.floor(self:Num(ds:GetCell(i, "AttackMaxTargets"), 0)),
                    attackInterval = self:Num(ds:GetCell(i, "AttackInterval"), 1),
                    speed = self:Num(ds:GetCell(i, "Speed"), 0),
                    scale = self:Num(ds:GetCell(i, "Scale"), 1),
                    standRuid = ds:GetCell(i, "StandRuid") or "",
                    moveRuid = ds:GetCell(i, "MoveRuid") or "",
                    attackRuid = ds:GetCell(i, "AttackRuid") or "",
                    dieRuid = ds:GetCell(i, "DieRuid") or "",
                    attackPlayRate = self:Num(ds:GetCell(i, "AttackPlayRate"), 1),
                    attackHitDelay = self:Num(ds:GetCell(i, "AttackHitDelay"), 0),
                    projectileRuid = projectileRuid,
                    -- Presentation of an attack (client only): effect clip played on the attacker when it attacks,
                    -- effect clip played on each unit its attack damages (hitEffectRuid),
                    -- and the unit's own sounds for attacking, being damaged and dying. Blank = none / shared sound.
                    attackEffectRuid = self:OptText(ds:GetCell(i, "AttackEffectRuid")),
                    hitEffectRuid = self:OptText(ds:GetCell(i, "HitEffectRuid")),
                    -- Where / how large the hit effect plays on each damaged unit (world units as seen on screen, relative to
                    -- the damaged unit's feet: X toward the attacker's facing, Y up). Blank offsets = nil (Y then defaults to
                    -- the projectile aim height); blank scale = 1.
                    hitEffectOffsetX = self:Num(ds:GetCell(i, "HitEffectOffsetX"), 0),
                    hitEffectOffsetY = self:OptText(ds:GetCell(i, "HitEffectOffsetY")) ~= nil and self:Num(ds:GetCell(i, "HitEffectOffsetY"), 0) or nil,
                    hitEffectScale = self:Num(ds:GetCell(i, "HitEffectScale"), 1),
                    -- Where and how large the attack effect plays (client only), in world units as seen on screen:
                    -- X forward (the way the unit faces), Y up from its feet, scale on top of the unit's size. Blank = 0 / 1.
                    attackEffectOffsetX = self:Num(ds:GetCell(i, "AttackEffectOffsetX"), 0),
                    attackEffectOffsetY = self:Num(ds:GetCell(i, "AttackEffectOffsetY"), 0),
                    attackEffectScale = self:Num(ds:GetCell(i, "AttackEffectScale"), 1),
                    attackSoundRuid = self:OptText(ds:GetCell(i, "AttackSoundRuid")),
                    damageSoundRuid = self:OptText(ds:GetCell(i, "DamageSoundRuid")),
                    dieSoundRuid = self:OptText(ds:GetCell(i, "DieSoundRuid")),
                    projectileScale = self:OptNum(ds:GetCell(i, "ProjectileScale")),
                    barY = self:OptNum(ds:GetCell(i, "BarY")),
                    barWidth = self:OptNum(ds:GetCell(i, "BarWidth")),
                    damage = self:Num(ds:GetCell(i, "SkillDamage"), 0),
                    radius = self:Num(ds:GetCell(i, "SkillRadius"), 0),
                    hitDelay = self:Num(ds:GetCell(i, "SkillHitDelay"), 0),
                    -- Skills: two free numbers each skill gives its own meaning (see BattleSkills.GetDefs); nil when blank.
                    skillValue1 = self:OptNum(ds:GetCell(i, "SkillValue1")),
                    skillValue2 = self:OptNum(ds:GetCell(i, "SkillValue2")),
                    effectRuid = self:OptText(ds:GetCell(i, "EffectRuid")),
                    effectScale = self:Num(ds:GetCell(i, "EffectScale"), 1),
                    -- Skill effect position added to the default (frame bottom on the ground, centred on the area), world units.
                    effectOffsetX = self:Num(ds:GetCell(i, "EffectOffsetX"), 0),
                    effectOffsetY = self:Num(ds:GetCell(i, "EffectOffsetY"), 0),
                    -- Skill sound (client only): played when the skill is cast, skillSoundDelay seconds after the effect starts.
                    skillSoundRuid = self:OptText(ds:GetCell(i, "SkillSoundRuid")),
                    skillSoundDelay = self:Num(ds:GetCell(i, "SkillSoundDelay"), 0),
                    -- Monsters: how many copies one card puts on the field (blank = 1); copies come MultiSpawnInterval apart.
                    -- iconRuid (optional, skills): the card picture; blank = the effect clip's thumbnail.
                    spawnCount = math.max(1, math.floor(self:Num(ds:GetCell(i, "SpawnCount"), 1))),
                    iconRuid = self:OptText(ds:GetCell(i, "IconRuid")),
                    -- Bases (Kind = base) only: starting mana (blank = CostStart), multipliers on the mana level table's
                    -- max / income (blank = 1), the base skill (a skill unit id) with its type (active / passive) and
                    -- cooldown seconds, the World Shop product that sells the base, and enemy-only bases (hidden from the card list).
                    manaStart = self:OptNum(ds:GetCell(i, "ManaStart")),
                    manaLevelStart = math.floor(self:Num(ds:GetCell(i, "ManaLevelStart"), self.DefaultCostLevelCap)),
                    manaMaxRate = self:Num(ds:GetCell(i, "ManaMaxRate"), 1),
                    manaRegenRate = self:Num(ds:GetCell(i, "ManaRegenRate"), 1),
                    baseSkill = self:OptText(ds:GetCell(i, "BaseSkill")) or "",
                    baseSkillType = self:OptText(ds:GetCell(i, "BaseSkillType")) or "active",
                    baseSkillCooldown = self:Num(ds:GetCell(i, "BaseSkillCooldown"), 0),
                    productId = self:OptText(ds:GetCell(i, "ProductId")) or "",
                    enemyOnly = self:Num(ds:GetCell(i, "EnemyOnly"), 0) > 0,
                }
            end
        end
        self._T.units = units
        log("[BattleConfig] UnitTable loaded rows=" .. tostring(count))
        return units
    end

    method table GetUnit(string unitId)
        -- Returns one unit definition at level 1, or nil when the id is unknown.
        return self:GetUnits()[unitId]
    end

    method boolean IsAreaAttackType(string attackType)
        -- Returns true for the attack types that damage every enemy in range instead of one target.
        return attackType == "melee_area" or attackType == "ranged_area"
    end

    method table GetRarities()
        -- Returns the rarity ids from lowest to highest.
        return { "normal", "rare", "epic", "unique", "legendary" }
    end

    method integer GetRarityRank(string rarity)
        -- Returns 1 (normal) .. 5 (legendary); unknown values count as normal.
        for i, id in ipairs(self:GetRarities()) do
            if id == rarity then return i end
        end
        return 1
    end

    method string GetRarityLabel(string rarity)
        -- Returns the display name of a rarity.
        if rarity == "rare" then return "레어" end
        if rarity == "epic" then return "에픽" end
        if rarity == "unique" then return "유니크" end
        if rarity == "legendary" then return "레전더리" end
        return "노말"
    end

    method table GetUnitsByRarity(string rarity)
        -- Returns the ids of every card unit (monster / build / skill) of a rarity, in table order.
        local byRarity = self._T.unitsByRarity
        if byRarity == nil then
            byRarity = {}
            local list = {}
            for _, unit in pairs(self:GetUnits()) do
                if unit.kind == "monster" or unit.kind == "build" or unit.kind == "skill" then table.insert(list, unit) end
            end
            table.sort(list, function(a, b) return a.order < b.order end)
            for _, unit in ipairs(list) do
                if byRarity[unit.rarity] == nil then byRarity[unit.rarity] = {} end
                table.insert(byRarity[unit.rarity], unit.id)
            end
            self._T.unitsByRarity = byRarity
        end
        return byRarity[rarity] or {}
    end

    method table GetChests()
        -- Returns every chest keyed by id, loaded once from ChestTable:
        -- { id, name, cards, chance = { rarity -> percent }, guarantee, priceMeso, order }.
        local chests = self._T.chests
        if chests ~= nil then return chests end
        chests = {}
        local ds = _DataService:GetTable("ChestTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local id = ds:GetCell(i, "ChestId")
            if id ~= nil and id ~= "" then
                chests[id] = {
                    id = id,
                    order = i,
                    name = ds:GetCell(i, "Name") or id,
                    cards = math.floor(self:Num(ds:GetCell(i, "Cards"), 1)),
                    chance = {
                        normal = self:Num(ds:GetCell(i, "ChanceNormal"), 0),
                        rare = self:Num(ds:GetCell(i, "ChanceRare"), 0),
                        epic = self:Num(ds:GetCell(i, "ChanceEpic"), 0),
                        unique = self:Num(ds:GetCell(i, "ChanceUnique"), 0),
                        legendary = self:Num(ds:GetCell(i, "ChanceLegendary"), 0),
                    },
                    guarantee = self:OptText(ds:GetCell(i, "Guarantee")) or "",
                    priceMeso = math.floor(self:Num(ds:GetCell(i, "PriceMeso"), 0)),
                    -- Per-rarity overrides of the base summon stone (blank = inherit; see GetSummonStone).
                    rarity = self:OptText(ds:GetCell(i, "Rarity")) or id,
                    iconOverride = self:OptText(ds:GetCell(i, "IconRuid")) or "",
                }
            end
        end
        self._T.chests = chests
        log("[BattleConfig] ChestTable loaded rows=" .. tostring(count))
        return chests
    end

    method table GetChest(string chestId)
        -- Returns one chest definition, or nil.
        if chestId == nil or chestId == "" then return nil end
        return self:GetChests()[chestId]
    end

    method table GetSummonStone(string stoneId)
        -- Returns a summon stone: the base stone (the SummonStone* properties) with its rarity row (ChestTable)
        -- applied on top. Fields: everything of GetChest plus iconRuid, effectRuid and frameColor. nil when unknown.
        local chest = self:GetChest(stoneId)
        if chest == nil then return nil end
        local stone = {}
        for key, value in pairs(chest) do stone[key] = value end
        stone.iconRuid = self.SummonStoneIconRuid
        if chest.iconOverride ~= "" then stone.iconRuid = chest.iconOverride end
        stone.effectRuid = self.SummonEffectRuid
        stone.frameColor = self:GetRarityColorOf(chest.rarity)
        return stone
    end

    method Color GetRarityColorOf(string rarity)
        -- Returns the frame color of a rarity id (normal / rare / epic / unique / legendary).
        if rarity == "rare" then return Color(0.25, 0.55, 1, 1) end
        if rarity == "epic" then return Color(0.66, 0.33, 0.97, 1) end
        if rarity == "unique" then return Color(1, 0.85, 0.2, 1) end
        if rarity == "legendary" then return Color(0.6, 0.95, 0.25, 1) end
        return Color(0.62, 0.62, 0.62, 1)
    end

    method string GetRevealRuid(string unitId)
        -- Returns what the summon reveal shows for a unit: its stand animation clip (monster / build, played as is)
        -- or its static icon (skill, or a unit without a stand clip).
        local unit = self:GetUnit(unitId)
        if unit == nil then return "" end
        if unit.kind ~= "skill" and unit.standRuid ~= nil and unit.standRuid ~= "" then return unit.standRuid end
        return self:GetIconRuid(unitId)
    end

    method table GetChestIds()
        -- Returns the chest ids in table order.
        local list = {}
        for _, chest in pairs(self:GetChests()) do table.insert(list, chest) end
        table.sort(list, function(a, b) return a.order < b.order end)
        local ids = {}
        for _, chest in ipairs(list) do table.insert(ids, chest.id) end
        return ids
    end

    method string GetAttributeLabel(string attribute)
        -- Returns the display name of a monster attribute ("" when the unit has none).
        if attribute == "earth" then return "땅" end
        if attribute == "water" then return "물" end
        if attribute == "fire" then return "화염" end
        if attribute == "wind" then return "바람" end
        if attribute == "light" then return "빛" end
        if attribute == "dark" then return "어둠" end
        return ""
    end

    method table GetEffects()
        -- Returns every effect definition keyed by effect id, loaded once from EffectTable:
        -- { id, type, name, duration, power }. An effect only says WHAT it does; who gets it, when and with what chance
        -- is the owning unit's rule (GetUnitEffects), which may override duration / power.
        -- What an effect does is its code entry in BattleEffects (keyed by the effect id); the row holds its numbers.
        local effects = self._T.effects
        if effects ~= nil then return effects end
        effects = {}
        local ds = _DataService:GetTable("EffectTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local id = ds:GetCell(i, "EffectId")
            if id ~= nil and id ~= "" then
                effects[id] = {
                    id = id,
                    name = ds:GetCell(i, "Name") or id,
                    duration = self:Num(ds:GetCell(i, "Duration"), 0),
                    power = self:Num(ds:GetCell(i, "Power"), 0),
                    -- Who the effect may be used on: "target" (an enemy it hits), "self" (the unit itself) or "both".
                    applies = self:OptText(ds:GetCell(i, "Applies")) or "target",
                    -- Text parameter for types that need one (spawn: the unit id it summons).
                    param = self:OptText(ds:GetCell(i, "Param")) or "",
                }
            end
        end
        self._T.effects = effects
        log("[BattleConfig] EffectTable loaded rows=" .. tostring(count))
        return effects
    end

    method table GetEffect(string effectId)
        -- Returns one effect definition, or nil when the id is blank or unknown.
        if effectId == nil or effectId == "" then return nil end
        return self:GetEffects()[effectId]
    end

    method table GetUnitEffects(string unitId)
        -- Returns the effect rules of one unit (an empty table when it has none), loaded once from UnitEffectTable:
        -- { effectId, trigger, target, chance, duration, power } in table order.
        -- on_hit + target: when this unit's attack damages an enemy, roll chance (percent) and apply the effect to that enemy.
        -- always + self: applied to the unit itself when it is set up, for as long as it lives (chance is 100).
        -- duration / power are optional overrides of the effect's defaults (nil = use the EffectTable value).
        local byUnit = self._T.unitEffects
        if byUnit == nil then
            byUnit = {}
            local ds = _DataService:GetTable("UnitEffectTable")
            local count = 0
            if ds ~= nil then count = ds:GetRowCount() end
            for i = 1, count do
                local id = ds:GetCell(i, "UnitId")
                local effectId = ds:GetCell(i, "EffectId")
                local trigger = ds:GetCell(i, "Trigger")
                local target = ds:GetCell(i, "Target")
                if id ~= nil and id ~= "" and effectId ~= nil and effectId ~= "" then
                    if (trigger == "on_hit" and target == "target") or (trigger == "always" and target == "self") then
                        -- on_hit: chance to apply the effect. always: the trait's own proc chance where it has one
                        -- (might), 100 when the cell is blank.
                        local chance = self:Num(ds:GetCell(i, "Chance"), 100)
                        if trigger == "on_hit" then chance = self:Num(ds:GetCell(i, "Chance"), 0) end
                        if byUnit[id] == nil then byUnit[id] = {} end
                        table.insert(byUnit[id], {
                            effectId = effectId,
                            trigger = trigger,
                            target = target,
                            chance = chance,
                            duration = self:OptNum(ds:GetCell(i, "Duration")),
                            power = self:OptNum(ds:GetCell(i, "Power")),
                        })
                    else
                        log_warning("[BattleConfig] UnitEffectTable row " .. tostring(i) .. " skipped: trigger=" .. tostring(trigger) .. " target=" .. tostring(target))
                    end
                end
            end
            self._T.unitEffects = byUnit
            log("[BattleConfig] UnitEffectTable loaded rows=" .. tostring(count))
        end
        return byUnit[unitId] or {}
    end

    method number GetAttributeRate(string attackerAttribute, string targetAttribute)
        -- Returns the damage multiplier of an attack by attribute: 1 + AttributeBonus when the attacker's attribute
        -- beats the target's, otherwise 1.
        if attackerAttribute == nil or attackerAttribute == "" or targetAttribute == nil or targetAttribute == "" then return 1 end
        local beats = self._T.attributeBeats
        if beats == nil then
            beats = { light = "dark", dark = "light", wind = "water", water = "fire", fire = "earth", earth = "wind" }
            self._T.attributeBeats = beats
        end
        if beats[attackerAttribute] == targetAttribute then return 1 + self.AttributeBonus end
        return 1
    end

    method number GetStatRate(integer level)
        -- Returns the stat multiplier of a unit level (UnitLevelTable StatRate), 1 for an unknown level.
        local levels = self:GetLevels()
        local entry = levels[math.max(1, math.min(#levels, level))]
        if entry == nil then return 1 end
        return entry.statRate
    end

    method string GetAttackTypeLabel(string attackType)
        -- Returns the display name of an attack type ("" for units that do not attack, such as skills).
        if attackType == "melee" then return "근거리" end
        if attackType == "ranged" then return "원거리" end
        if attackType == "melee_area" then return "근거리 범위" end
        if attackType == "ranged_area" then return "원거리 범위" end
        return ""
    end

    method string GetIconRuid(string unitId)
        -- Returns the RUID to show a unit or skill as a static icon in UI (thumbnail of its stand clip or effect clip).
        local unit = self:GetUnit(unitId)
        if unit == nil then return "" end
        -- A base is shown with its plain sprite (IconRuid), not a clip thumbnail.
        if unit.kind == "base" then return unit.iconRuid or "" end
        local ruid = unit.standRuid
        if unit.kind == "skill" then ruid = unit.iconRuid or unit.effectRuid or "" end
        if ruid == nil or ruid == "" then return "" end
        return "thumbnail://" .. ruid
    end

    method Color GetRarityColor(string unitId)
        -- Returns the frame color of a unit's rarity (normal / rare / epic / unique / legendary) for UI.
        local unit = self:GetUnit(unitId)
        local rarity = "normal"
        if unit ~= nil then rarity = unit.rarity end
        return self:GetRarityColorOf(rarity)
    end

    @ExecSpace("ClientOnly")
    method void PaintRarityFrame(Entity item, string unitId)
        -- Colors the item's "Rarity" frame (four edge sprites) by the unit's rarity; an empty unit id hides the frame.
        local frame = item:GetChildByName("Rarity")
        if not isvalid(frame) then return end
        local shown = unitId ~= "" and self:GetUnit(unitId) ~= nil
        if frame.Enable ~= shown then frame.Enable = shown end
        if shown == false then return end
        local color = self:GetRarityColor(unitId)
        for _, edge in ipairs(frame.Children) do
            if edge.SpriteGUIRendererComponent ~= nil then edge.SpriteGUIRendererComponent.Color = color end
        end
    end

    method table GetLevels()
        -- Returns the level table as an array: { statRate, upgradeCost } per level, loaded once from UnitLevelTable.
        local levels = self._T.levels
        if levels ~= nil then return levels end
        levels = {}
        local ds = _DataService:GetTable("UnitLevelTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local level = math.floor(self:Num(ds:GetCell(i, "Level"), i))
            levels[level] = {
                statRate = self:Num(ds:GetCell(i, "StatRate"), 1),
                upgradeCost = self:Num(ds:GetCell(i, "UpgradeCost"), 0),
                -- Cards of the unit that must be collected to go from this level to the next (0 = top level).
                cardsNeeded = math.floor(self:Num(ds:GetCell(i, "CardsNeeded"), 0)),
            }
        end
        self._T.levels = levels
        log("[BattleConfig] UnitLevelTable loaded rows=" .. tostring(count))
        return levels
    end

    method table GetCostLevels()
        -- Returns the in-battle cost level table as an array: { costMax, regenRate, upgradeCost, unlockMeso } per level.
        local levels = self._T.costLevels
        if levels ~= nil then return levels end
        levels = {}
        local ds = _DataService:GetTable("CostLevelTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local level = math.floor(self:Num(ds:GetCell(i, "Level"), i))
            levels[level] = {
                costMax = self:Num(ds:GetCell(i, "CostMax"), 200),
                regenRate = self:Num(ds:GetCell(i, "RegenRate"), 1),
                upgradeCost = self:Num(ds:GetCell(i, "UpgradeCost"), 0),
                unlockMeso = self:Num(ds:GetCell(i, "UnlockMeso"), 0),
            }
        end
        self._T.costLevels = levels
        log("[BattleConfig] CostLevelTable loaded rows=" .. tostring(count))
        return levels
    end

    method integer GetMaxLevel()
        -- Returns the highest level defined in UnitLevelTable.
        return #self:GetLevels()
    end

    method table GetUnitAtLevel(string unitId, integer level)
        -- Returns a copy of a unit definition with HP, attack and skill damage scaled by the level's stat rate.
        local base = self:GetUnit(unitId)
        if base == nil then return nil end
        local levels = self:GetLevels()
        local entry = levels[math.max(1, math.min(#levels, level))]
        local rate = 1
        if entry ~= nil then rate = entry.statRate end
        local unit = {}
        for key, value in pairs(base) do unit[key] = value end
        unit.level = level
        unit.maxHp = base.maxHp * rate
        unit.attack = base.attack * rate
        unit.damage = base.damage * rate
        return unit
    end

    method table GetStarterUnitIds()
        -- Returns the ids of the card units (monster / build / skill) every new player receives (Starter = 1 in UnitTable),
        -- in table order. Bases are not deck cards; see GetStarterBaseIds.
        local list = {}
        for _, unit in pairs(self:GetUnits()) do
            if unit.starter and unit.kind ~= "base" then table.insert(list, unit) end
        end
        table.sort(list, function(a, b) return a.order < b.order end)
        local ids = {}
        for _, unit in ipairs(list) do table.insert(ids, unit.id) end
        return ids
    end

    method table GetStarterBaseIds()
        -- Returns the ids of the bases every player owns from the start (Kind = base, Starter = 1), in table order.
        local list = {}
        for _, unit in pairs(self:GetUnits()) do
            if unit.starter and unit.kind == "base" then table.insert(list, unit) end
        end
        table.sort(list, function(a, b) return a.order < b.order end)
        local ids = {}
        for _, unit in ipairs(list) do table.insert(ids, unit.id) end
        return ids
    end

    method table GetBaseLevels()
        -- Returns the base upgrade table as an array: { hpRate, manaDiscount, upgradeCost } per level, loaded once from
        -- BaseLevelTable. Level 1 is a base that has not been upgraded; upgradeCost (meso) 0 = top level.
        local levels = self._T.baseLevels
        if levels ~= nil then return levels end
        levels = {}
        local ds = _DataService:GetTable("BaseLevelTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local level = math.floor(self:Num(ds:GetCell(i, "Level"), i))
            levels[level] = {
                hpRate = self:Num(ds:GetCell(i, "HpRate"), 1),
                manaDiscount = math.max(0, math.min(0.9, self:Num(ds:GetCell(i, "ManaUpgradeDiscount"), 0))),
                -- Mana level cap gained up to this base level (cumulative, added to the base's ManaLevelStart).
                manaLevelBonus = math.floor(self:Num(ds:GetCell(i, "ManaLevelBonus"), 0)),
                upgradeCost = math.floor(self:Num(ds:GetCell(i, "UpgradeCost"), 0)),
            }
        end
        self._T.baseLevels = levels
        log("[BattleConfig] BaseLevelTable loaded rows=" .. tostring(count))
        return levels
    end

    method integer GetMaxBaseLevel()
        -- Returns the highest level defined in BaseLevelTable.
        return math.max(1, #self:GetBaseLevels())
    end

    method table GetBaseLevel(integer level)
        -- Returns one BaseLevelTable row (level clamped into the table), or a neutral row when the table is empty.
        local levels = self:GetBaseLevels()
        local entry = levels[math.max(1, math.min(#levels, level))]
        if entry == nil then return { hpRate = 1, manaDiscount = 0, manaLevelBonus = 0, upgradeCost = 0 } end
        return entry
    end

    method table GetBaseAtLevel(string baseId, integer level)
        -- Returns a copy of a base definition (Kind = base) with its max HP scaled by the upgrade level's HpRate and the
        -- level's mana upgrade discount attached. Falls back to the default base when the id is not a base. nil if there is none.
        local base = self:GetUnit(baseId)
        if base == nil or base.kind ~= "base" then base = self:GetUnit(self.DefaultBaseId) end
        if base == nil then return nil end
        local entry = self:GetBaseLevel(level)
        local unit = {}
        for key, value in pairs(base) do unit[key] = value end
        unit.level = level
        unit.maxHp = base.maxHp * entry.hpRate
        unit.manaDiscount = entry.manaDiscount
        -- How far this base can raise the in-battle mana level: its starting cap plus what its upgrade level adds.
        unit.manaLevelCap = math.max(1, math.min(#self:GetCostLevels(), base.manaLevelStart + entry.manaLevelBonus))
        return unit
    end

    method table GetCurrencies()
        -- Returns every currency definition keyed by currency id: { id, name, max, regenSeconds, startAmount, icon },
        -- loaded once from CurrencyTable. regenSeconds = seconds per +1 (0 = no automatic refill).
        local currencies = self._T.currencies
        if currencies ~= nil then return currencies end
        currencies = {}
        local ds = _DataService:GetTable("CurrencyTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local id = ds:GetCell(i, "CurrencyId")
            if id ~= nil and id ~= "" then
                currencies[id] = {
                    id = id,
                    name = ds:GetCell(i, "Name") or id,
                    max = math.floor(self:Num(ds:GetCell(i, "Max"), 0)),
                    regenSeconds = math.floor(self:Num(ds:GetCell(i, "RegenSeconds"), 0)),
                    startAmount = math.floor(self:Num(ds:GetCell(i, "StartAmount"), 0)),
                    -- Sprite RUID of the currency icon ("" = no icon).
                    icon = self:OptText(ds:GetCell(i, "Icon")) or "",
                }
            end
        end
        self._T.currencies = currencies
        log("[BattleConfig] CurrencyTable loaded rows=" .. tostring(count))
        return currencies
    end

    method table GetCurrency(string currencyId)
        -- Returns one currency definition, or nil when the id is unknown.
        return self:GetCurrencies()[currencyId]
    end

    method table GetShopProducts()
        -- Returns the World Shop products in ShopProductTable row order: { productId, currencyId, amount, label }.
        -- productId is blank until the product is registered in the world.
        local products = self._T.products
        if products ~= nil then return products end
        products = {}
        local ds = _DataService:GetTable("ShopProductTable")
        local count = 0
        if ds ~= nil then count = ds:GetRowCount() end
        for i = 1, count do
            local currencyId = ds:GetCell(i, "CurrencyId")
            if currencyId ~= nil and currencyId ~= "" then
                table.insert(products, {
                    productId = ds:GetCell(i, "ProductId") or "",
                    currencyId = currencyId,
                    amount = math.floor(self:Num(ds:GetCell(i, "Amount"), 0)),
                    label = ds:GetCell(i, "Label") or "",
                })
            end
        end
        self._T.products = products
        log("[BattleConfig] ShopProductTable loaded rows=" .. tostring(count))
        return products
    end

    method table GetShopProduct(string productId)
        -- Returns the product row of a World Shop product id, or nil when the id is not in the table.
        if productId == nil or productId == "" then return nil end
        for _, product in ipairs(self:GetShopProducts()) do
            if product.productId == productId then return product end
        end
        return nil
    end

    method table GetBaseByProduct(string productId)
        -- Returns the base definition sold by a World Shop product id (UnitTable ProductId), or nil.
        if productId == nil or productId == "" then return nil end
        for _, unit in pairs(self:GetUnits()) do
            if unit.kind == "base" and unit.productId == productId then return unit end
        end
        return nil
    end

    method table GetStage(string stageId)
        -- Returns one stage definition from StageTable, or nil when the id is unknown.
        local stages = self._T.stages
        if stages == nil then
            stages = {}
            local stageIds = {}
            local ds = _DataService:GetTable("StageTable")
            local count = 0
            if ds ~= nil then count = ds:GetRowCount() end
            for i = 1, count do
                local id = ds:GetCell(i, "StageId")
                if id ~= nil and id ~= "" then
                    table.insert(stageIds, id)
                    local pool = {}
                    for unitId in string.gmatch(ds:GetCell(i, "LoopPool") or "", "[^;]+") do table.insert(pool, unitId) end
                    stages[id] = {
                        id = id,
                        name = ds:GetCell(i, "Name"),
                        mapName = self:OptText(ds:GetCell(i, "MapName")) or "battle",
                        groundY = self:Num(ds:GetCell(i, "GroundY"), self.GroundY),
                        baseHp = self:Num(ds:GetCell(i, "BaseHp"), 1000),
                        rewardMeso = self:Num(ds:GetCell(i, "RewardMeso"), 0),
                        -- Chest (ChestTable id) opened for the player on a win; blank = none.
                        rewardChest = self:OptText(ds:GetCell(i, "RewardChest")) or "",
                        entryCost = self:Num(ds:GetCell(i, "EntryCost"), 0),
                        -- The enemy side's base (UnitTable id, Kind = base). Blank = DefaultBaseId. Its HP is the stage's BaseHp.
                        enemyBase = self:OptText(ds:GetCell(i, "EnemyBase")) or self.DefaultBaseId,
                        unlockStage = ds:GetCell(i, "UnlockStage") or "",
                        loopPool = pool,
                        loopStartInterval = self:Num(ds:GetCell(i, "LoopStartInterval"), 6),
                        loopMinInterval = self:Num(ds:GetCell(i, "LoopMinInterval"), 3),
                    }
                end
            end
            self._T.stages = stages
            self._T.stageIds = stageIds
            log("[BattleConfig] StageTable loaded rows=" .. tostring(count))
        end
        return stages[stageId]
    end

    method table GetStageIds()
        -- Returns every stage id in StageTable row order (read-only list for stage select screens).
        if self._T.stageIds == nil then self:GetStage("") end
        return self._T.stageIds
    end

    method table GetStageWaves(string stageId)
        -- Returns a stage's timetable from StageWaveTable as an array of { time, unitId, level }, sorted by time.
        local all = self._T.waves
        if all == nil then
            all = {}
            local ds = _DataService:GetTable("StageWaveTable")
            local count = 0
            if ds ~= nil then count = ds:GetRowCount() end
            for i = 1, count do
                local id = ds:GetCell(i, "StageId")
                if id ~= nil and id ~= "" then
                    if all[id] == nil then all[id] = {} end
                    table.insert(all[id], {
                        time = self:Num(ds:GetCell(i, "Time"), 0),
                        unitId = ds:GetCell(i, "UnitId"),
                        level = math.floor(self:Num(ds:GetCell(i, "Level"), 1)),
                    })
                end
            end
            for _, waves in pairs(all) do
                table.sort(waves, function(a, b) return a.time < b.time end)
            end
            self._T.waves = all
            log("[BattleConfig] StageWaveTable loaded rows=" .. tostring(count))
        end
        return all[stageId] or {}
    end

end
