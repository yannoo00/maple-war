@Logic
script BattleSkills extends Logic

    -- Server-side executor of skill cards. Every skill is one entry of the registry built in GetDefs, keyed by its
    -- UnitTable id: a small function built from the shared helpers below (find targets, damage, heal, apply an effect,
    -- repeat). Adding a skill = adding one entry here; its numbers stay in UnitTable:
    --   SkillDamage   = the main amount (damage, or heal), already scaled by the card level
    --   SkillRadius   = the reach around the chosen spot
    --   SkillHitDelay = seconds from the cast (effect start) to the first action
    --   SkillValue1 / SkillValue2 = two free numbers whose meaning each skill states in its `values` text
    -- The `values` text is also what the unit editor shows next to those two cells.
    -- Damage goes through the one damage pipeline (_BattleEffects:DealHit, kind "skill"): no attribute bonus, but the
    -- targets' own traits (tough ...) apply. A skill id with no entry falls back to SkillDamage on every enemy
    -- monster / build in range, with a warning.

    method table GetDefs()
        -- Returns the skill registry (skill id -> { values, run(ctx), soundRepeat(cfg) optional }), built once. ctx:
        -- see Cast. Built on both sides: the server runs `run`, clients only read `soundRepeat`.
        local defs = self._T.defs
        if defs ~= nil then return defs end
        defs = {}

        -- 메테오: every enemy in range takes SkillDamage.
        defs["meteor"] = { values = "", run = function(ctx)
            self:Repeat(ctx, 1, 0, function()
                for _, unit in ipairs(self:FindTargets(ctx, "enemy", nil, 0)) do self:Damage(unit, ctx.damage) end
            end)
        end }

        -- 눈보라: every enemy in range takes SkillDamage.
        defs["blizzard"] = defs["meteor"]

        -- 번개: up to SkillValue1 random enemies in range take SkillDamage.
        defs["lightning"] = { values = "SkillValue1 = 최대 대상 수(무작위, 빈칸 = 3)", run = function(ctx)
            local count = math.floor(ctx.value1 or 3)
            self:Repeat(ctx, 1, 0, function()
                for _, unit in ipairs(self:FindTargets(ctx, "enemy", nil, count)) do self:Damage(unit, ctx.damage) end
            end)
        end }

        -- 독구름: every enemy in range takes SkillDamage as poison damage every SkillValue2 seconds for SkillValue1 seconds.
        -- Poison damage: no attribute bonus, swamp units take none.
        defs["poisoncloud"] = { values = "SkillDamage = 1회 피해, SkillValue1 = 지속 초(빈칸 = 10), SkillValue2 = 간격 초(빈칸 = 1)", run = function(ctx)
            local interval = ctx.value2 or 1
            self:Repeat(ctx, self:TickCount(ctx.value1 or 10, interval), interval, function()
                for _, unit in ipairs(self:FindTargets(ctx, "enemy", nil, 0)) do _BattleEffects:DealHit(nil, unit, ctx.damage, "poison") end
            end)
        end }

        -- 힐: every ally monster / build in range regains SkillDamage every SkillValue2 seconds for SkillValue1 seconds.
        defs["heal"] = { values = "SkillDamage = 1회 회복량, SkillValue1 = 지속 초(빈칸 = 5), SkillValue2 = 간격 초(빈칸 = 1)", run = function(ctx)
            local interval = ctx.value2 or 1
            self:Repeat(ctx, self:TickCount(ctx.value1 or 5, interval), interval, function()
                for _, unit in ipairs(self:FindTargets(ctx, "ally", nil, 0)) do unit:Heal(ctx.damage) end
            end)
        end }

        -- 지진: every monster and build in range (both teams) takes SkillDamage, builds twice that; SkillValue1 hits,
        -- SkillValue2 seconds apart.
        defs["earthquake"] = { values = "SkillDamage = 1회 피해(건물은 2배), SkillValue1 = 타격 횟수(빈칸 = 3), SkillValue2 = 간격 초(빈칸 = 0.5). 양 팀 모두 맞음", run = function(ctx)
            self:Repeat(ctx, ctx.value1 or 3, ctx.value2 or 0.5, function()
                for _, unit in ipairs(self:FindTargets(ctx, "all", nil, 0)) do
                    local amount = ctx.damage
                    if unit.Kind == "build" then amount = amount * 2 end
                    self:Damage(unit, amount)
                end
            end)
        end }

        -- 고대의 저주 (id dispel): every enemy in range takes SkillDamage and is always cursed (EffectTable 'curse':
        -- its duration and attack reduction). Builds take the damage only; effects never land on them.
        defs["dispel"] = { values = "SkillDamage = 피해. 저주(100%)의 지속·공격력 감소는 효과 표 curse. 스킬 값 1·2는 쓰지 않음", run = function(ctx)
            self:Repeat(ctx, 1, 0, function()
                for _, unit in ipairs(self:FindTargets(ctx, "enemy", nil, 0)) do
                    self:Damage(unit, ctx.damage)
                    if unit.IsDead == false then self:ApplyEffect(unit, "curse") end
                end
            end)
        end }

        -- 매직클로: hits every enemy in range for SkillDamage, SkillValue1 times, SkillValue2 seconds apart, on the same
        -- spot. The skill sound plays once per hit (see GetSoundRepeat).
        defs["magic_claw"] = { values = "SkillDamage = 1타 피해, SkillValue1 = 타격 횟수(빈칸 = 2), SkillValue2 = 간격 초(빈칸 = 0.5). 타격마다 스킬 사운드 재생",
            soundRepeat = function(cfg) return { times = cfg.skillValue1 or 2, interval = cfg.skillValue2 or 0.5 } end,
            run = function(ctx)
                self:Repeat(ctx, ctx.value1 or 2, ctx.value2 or 0.5, function()
                    for _, unit in ipairs(self:FindTargets(ctx, "enemy", nil, 0)) do self:Damage(unit, ctx.damage) end
                end)
            end }

        self._T.defs = defs
        return defs
    end

    method table GetSoundRepeat(table cfg)
        -- Returns how often a skill's sound plays: { times, interval } (once for most skills). Clients ask this from
        -- FieldFx; only the entry's soundRepeat function runs there, never its server-side run.
        local def = self:GetDefs()[cfg.id]
        if def == nil or def.soundRepeat == nil then return { times = 1, interval = 0 } end
        local rule = def.soundRepeat(cfg)
        return { times = math.max(1, math.floor(rule.times)), interval = math.max(0, rule.interval) }
    end

    @ExecSpace("ServerOnly")
    method void Cast(any director, integer team, table cfg, number centerX)
        -- Runs a skill played by team at centerX. cfg is the skill at the card's level (UnitTable row).
        local ctx = {
            director = director, team = team, cfg = cfg, id = cfg.id, x = centerX,
            radius = cfg.radius * _BattleConfig.RangeScale, damage = cfg.damage, delay = cfg.hitDelay,
            value1 = cfg.skillValue1, value2 = cfg.skillValue2, rate = _BattleConfig:GetStatRate(cfg.level or 1),
        }
        local def = self:GetDefs()[cfg.id]
        log("[VRF] BattleSkills cast " .. tostring(cfg.id) .. " team=" .. tostring(team) .. " x=" .. string.format("%.1f", centerX) .. " level=" .. tostring(cfg.level or 1) .. " implemented=" .. tostring(def ~= nil))
        if def == nil then
            log_warning("[BattleSkills] skill " .. tostring(cfg.id) .. " has no implementation in BattleSkills, using plain area damage")
            def = self:GetDefs()["meteor"]
        end
        def.run(ctx)
    end

    -- ===== Helpers shared by the skills =====

    @ExecSpace("ServerOnly")
    method void Repeat(table ctx, number times, number interval, any action)
        -- Calls action `times` times: the first SkillHitDelay after the cast, then every `interval` seconds.
        -- Each call looks for its targets again, so a unit that walks in later is reached too.
        local director = ctx.director
        local count = math.max(1, math.floor(times))
        for n = 1, count do
            local at = ctx.delay + (n - 1) * interval
            if at <= 0 then
                action()
            else
                _TimerService:SetTimerOnce(function()
                    if isvalid(director.Entity) and director.State == "PLAYING" then action() end
                end, at)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method integer TickCount(number seconds, number interval)
        -- Number of ticks of a lasting skill: one every interval seconds for seconds (at least 1).
        if interval <= 0 then return 1 end
        return math.max(1, math.floor(seconds / interval + 0.0001))
    end

    @ExecSpace("ServerOnly")
    method table FindTargets(table ctx, string side, any kinds, integer maxCount)
        -- Returns the living units within the skill's radius of its spot. side: "enemy" / "ally" / "all" (seen from the
        -- caster). kinds: a set like { monster = true }, nil = monsters and builds (bases are never hit by skills unless
        -- a skill asks for them). maxCount > 0 keeps that many, picked at random.
        local allowed = kinds or { monster = true, build = true }
        local found = {}
        for _, unit in ipairs(ctx.director._T.units or {}) do
            if unit.IsDead == false and unit.Ready and isvalid(unit.Entity) and allowed[unit.Kind] == true then
                local sideOk = side == "all" or (side == "enemy" and unit.Team ~= ctx.team) or (side == "ally" and unit.Team == ctx.team)
                if sideOk and math.abs(unit.Entity.TransformComponent.WorldPosition.x - ctx.x) <= ctx.radius then
                    table.insert(found, unit)
                end
            end
        end
        if maxCount > 0 then
            while #found > maxCount do table.remove(found, _UtilLogic:RandomIntegerRange(1, #found)) end
        end
        log("[BattleSkills] " .. tostring(ctx.id) .. " targets side=" .. side .. " x=" .. string.format("%.1f", ctx.x) .. " found=" .. tostring(#found))
        return found
    end

    @ExecSpace("ServerOnly")
    method void Damage(any unit, number amount)
        -- Skill damage through the damage pipeline (no attacker, kind "skill").
        _BattleEffects:DealHit(nil, unit, amount, "skill")
    end

    @ExecSpace("ServerOnly")
    method void ApplyEffect(any unit, string effectId)
        -- Puts an EffectTable effect (its own duration / power) on a unit, as a skill (no source unit).
        local effect = _BattleConfig:GetEffect(effectId)
        if effect == nil then
            log_warning("[BattleSkills] unknown effect " .. effectId)
            return
        end
        unit:ReceiveEffect({ id = effect.id, name = effect.name, duration = effect.duration, power = effect.power, param = effect.param }, nil)
    end

end
